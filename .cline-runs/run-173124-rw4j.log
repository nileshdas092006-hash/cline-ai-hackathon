{"ts":"2026-10-10T12:02:24.673Z","type":"agent_event","event":{"type":"content_end","contentType":"tool","toolName":"read_files","toolCallId":"toolu_01SVjw9FaMEM2bFeu35L2rUA","output":[{"query":"C:\\Dev\\cline hackathon\\build\\src\\server\\agents\\ruleMaintenance.test.ts:1-80","result":" 1 | // The agent's tools, called directly (no model, no network), and the run loop with a mocked agent.\n 2 | import { mkdtempSync, rmSync } from \"node:fs\";\n 3 | import { tmpdir } from \"node:os\";\n 4 | import { join } from \"node:path\";\n 5 | import { afterEach, beforeEach, describe, expect, it, vi } from \"vitest\";\n 6 | import type { RuleTestCase } from \"@/core/ruleTests\";\n 7 | import type { SchemeRule } from \"@/core/types\";\n 8 | \n 9 | type Mod = typeof import(\"./ruleMaintenance\");\n10 | type Schemes = typeof import(\"@/core/schemes\");\n11 | \n12 | let dir: string;\n13 | let mod: Mod;\n14 | let schemes: Schemes;\n15 | let store: InstanceType<typeof import(\"../store\").RuleStore>;\n16 | let svc: InstanceType<typeof import(\"../rules\").RuleService>;\n17 | const NOTICE = \"Orunodoi: For the month of October 2026, eligible beneficiaries will receive a one-time amount of Rs. 1,500 instead of the regular Rs. 1,250.\";\n18 | \n19 | const octPatch = {\n20 |   version: \"2.1.0\",\n21 |   benefit: {\n22 |     overrides: [\n23 |       {\n24 |         from: \"2026-10-01\",\n25 |         to: \"2026-10-31\",\n26 |         stateTopUp: 1500,\n27 |         noteEn: \"One-time ₹1,500 for October 2026 (instead of ₹1,250).\",\n28 |         noteAs: \"অক্টোবৰ ২০২৬ৰ বাবে এবাৰৰ ₹১,৫০০ (₹১,২৫০ৰ সলনি)।\",\n29 |         provenance: { sourceUrl: null, sourceTitle: \"Orunodoi notice (demo)\", clause: \"October 2026 one-time payment\", effectiveDate: \"2026-10-01\", verifiedOn: \"2026-10-10\", version: \"2.1.0\", status: \"provisional\" },\n30 |       },\n31 |     ],\n32 |   },\n33 | };\n34 | const octTests: RuleTestCase[] = [\n35 |   { kind: \"benefit\", id: \"oct_2026_1500\", description: \"October → 1500\", date: \"2026-10-15\", expect: { stateTopUp: 1500, isOverride: true } },\n36 |   { kind: \"benefit\", id: \"oct_31_1500\", description: \"31 Oct → 1500\", date: \"2026-10-31\", expect: { stateTopUp: 1500 } },\n37 |   { kind: \"benefit\", id: \"nov_2026_1250\", description: \"November → 1250\", date: \"2026-11-01\", expect: { stateTopUp: 1250, isOverride: false } },\n38 | ];\n39 | \n40 | beforeEach(async () => {\n41 |   vi.resetModules();\n42 |   schemes = await import(\"@/core/schemes\");\n43 |   mod = await import(\"./ruleMaintenance\");\n44 |   const { RuleStore } = await import(\"../store\");\n45 |   const { RuleService } = await import(\"../rules\");\n46 |   dir = mkdtempSync(join(tmpdir(), \"kaagaz-agent-\"));\n47 |   store = new RuleStore(join(dir, \"rules.db\"));\n48 |   svc = new RuleService(store, () => \"2026-10-10T10:00:00.000Z\");\n49 | });\n50 | afterEach(() => {\n51 |   store.close();\n52 |   rmSync(dir, { recursive: true, force: true });\n53 | });\n54 | \n55 | function tools() {\n56 |   const session = mod.newSession(NOTICE);\n57 |   const list = mod.createRuleTools(svc, session);\n58 |   const byName = Object.fromEntries(list.map((t) => [t.name, t]));\n59 |   const call = (name: string, input: unknown) => byName[name].execute(input as never, { agentId: \"test\", iteration: 1 });\n60 |   return { session, list, call };\n61 | }\n62 | \n63 | describe(\"rule maintenance tools\", () => {\n64 |   it(\"exposes exactly the five tools, each with a JSON input schema\", () => {\n65 |     const { list } = tools();\n66 |     expect(list.map((t) => t.name)).toEqual([\"getRuleSchema\", \"getCurrentRule\", \"proposeRule\", \"runTests\", \"saveProposal\"]);\n67 |     for (const t of list) expect(t.inputSchema).toMatchObject({ type: \"object\" });\n68 |   });\n69 | \n70 |   it(\"validates every tool input with its zod schema (createTool does not), returning errors instead of throwing\", async () => {\n71 |     const { call, session } = tools();\n72 |     expect(await call(\"getCurrentRule\", { schemeId: 42 })).toMatchObject({ error: expect.stringMatching(/^invalid input: schemeId/) });\n73 |     expect(await call(\"runTests\", { tests: \"all\" })).toMatchObject({ error: expect.stringMatching(/tests/) });\n74 |     await call(\"proposeRule\", { schemeId: \"orunodoi-3\", patch: octPatch });\n75 |     expect(await call(\"saveProposal\", { tests: octTests, sourceNote: 7, summary: \"s\" })).toMatchObject({ error: expect.stringMatching(/sourceNote/) });\n76 |     expect(session.savedId).toBeNull();\n77 |   });\n78 | \n79 |   it(\"getRuleSchema returns the SchemeRule JSON schema, the test-case schema and the scheme list\", async () => {\n80 |     const out = (await tools().call(\"getRuleSchema\", {})) as { schemeRule: { properties: object }; testCase: object; schemes: { id: string }[] };","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\core\\rulePolicy.ts","result":" 1 | // Rules every agent proposal must follow, enforced by code (not by the prompt). Pure.\n 2 | // - A change to an existing scheme must have a higher version.\n 3 | // - At least MIN_NEW_TESTS new test cases, with unique ids that don't clash with regression tests.\n 4 | // - A provenance may only be \"verified\" if it was already verified (same place, same source) in\n 5 | //   the current version, or if its sourceUrl appears in the notice text. Anything else must be\n 6 | //   \"provisional\", which the engine turns into needs_verification (never a definitive pass/fail).\n 7 | import type { RuleTestCase } from \"./ruleTests\";\n 8 | import { compareVersions } from \"./schemes\";\n 9 | import type { RuleProvenance, SchemeRule } from \"./types\";\n10 | \n11 | export const MIN_NEW_TESTS = 3;\n12 | \n13 | type Obj = Record<string, unknown>;\n14 | const isObj = (v: unknown): v is Obj => typeof v === \"object\" && v !== null && !Array.isArray(v);\n15 | \n16 | function keyOf(item: unknown, i: number): string {\n17 |   if (isObj(item) && typeof item.id === \"string\") return item.id;\n18 |   if (isObj(item) && typeof item.docType === \"string\") return item.docType;\n19 |   return String(i);\n20 | }\n21 | \n22 | /** Every provenance in a rule, keyed by a stable path such as \"exclusions[four_wheeler].provenance\". */\n23 | export function provenanceEntries(rule: SchemeRule): Map<string, RuleProvenance> {\n24 |   const out = new Map<string, RuleProvenance>();\n25 |   const walk = (v: unknown, path: string) => {\n26 |     if (Array.isArray(v)) v.forEach((x, i) => walk(x, `${path}[${keyOf(x, i)}]`));\n27 |     else if (isObj(v)) {\n28 |       for (const [k, x] of Object.entries(v)) {\n29 |         const p = path ? `${path}.${k}` : k;\n30 |         if (k === \"provenance\" && isObj(x)) out.set(p, x as unknown as RuleProvenance);\n31 |         else walk(x, p);\n32 |       }\n33 |     }\n34 |   };\n35 |   walk(rule, \"\");\n36 |   return out;\n37 | }\n38 | \n39 | export interface RulePolicyInput {\n40 |   rule: SchemeRule;\n41 |   /** The current published version of this scheme, or null for a brand-new scheme. */\n42 |   current: SchemeRule | null;\n43 |   notice: string;\n44 | }\n45 | \n46 | export interface TestPolicyInput {\n47 |   newTests: readonly RuleTestCase[];\n48 |   regressionTestIds: readonly string[];\n49 | }\n50 | \n51 | /** Human-readable violations; empty means the proposal follows the rules. */\n52 | export function checkProposalPolicy(input: RulePolicyInput & TestPolicyInput): string[] {\n53 |   return [...checkRulePolicy(input), ...checkTestPolicy(input)];\n54 | }\n55 | \n56 | /** At least MIN_NEW_TESTS new cases, with unique ids that don't clash with the regression tests. */\n57 | export function checkTestPolicy({ newTests, regressionTestIds }: TestPolicyInput): string[] {\n58 |   const out: string[] = [];\n59 |   if (newTests.length < MIN_NEW_TESTS) out.push(`write at least ${MIN_NEW_TESTS} new test cases (got ${newTests.length})`);\n60 |   const seen = new Set<string>();\n61 |   const regression = new Set(regressionTestIds);\n62 |   for (const t of newTests) {\n63 |     if (seen.has(t.id)) out.push(`duplicate test id \"${t.id}\"`);\n64 |     seen.add(t.id);\n65 |     if (regression.has(t.id)) out.push(`test id \"${t.id}\" is already a regression test; choose a new id`);\n66 |   }\n67 |   return out;\n68 | }\n69 | \n70 | /** Version must go up; \"verified\" only when carried over unchanged or cited in the notice. */\n71 | export function checkRulePolicy({ rule, current, notice }: RulePolicyInput): string[] {\n72 |   const out: string[] = [];\n73 | \n74 |   if (current && compareVersions(rule.version, current.version) <= 0) {\n75 |     out.push(`version ${rule.version} must be higher than the current ${current.version} (e.g. bump the minor number)`);\n76 |   }\n77 | \n78 |   const before = current ? provenanceEntries(current) : new Map<string, RuleProvenance>();\n79 |   for (const [path, p] of provenanceEntries(rule)) {\n80 |     if (p.status !== \"verified\") continue;\n81 |     const old = before.get(path);\n82 |     const carriedOver = old?.status === \"verified\" && old.sourceUrl === p.sourceUrl;\n83 |     const citedInNotice = p.sourceUrl !== null && notice.includes(p.sourceUrl);\n84 |     if (!carriedOver && !citedInNotice) {\n85 |       out.push(`${path} is \"verified\" but its sourceUrl is not in the notice and was not verified before; use \"provisional\"`);\n86 |     }\n87 |   }\n88 |   return out;\n89 | }","success":true}],"durationMs":4}}
