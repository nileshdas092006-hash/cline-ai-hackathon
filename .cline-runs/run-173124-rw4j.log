c/core/ruleDiffView.test.ts:21:11\n  19:     );\r\n  20:     expect(formatValue({ min: 60, max: 120, dobFrom: \"aadhaar\", provenance: { status: \"verified\", sourceTitle: \"Vikaspedia\", sourceUrl: \"https://x\", verifiedOn: \"2026-10-10\", version: \"1.0.0\" } })).toBe(\r\n> 21:       \"60–120 years (date of birth from aadhaar) · verified: Vikaspedia\",\r\n  22:     );\r\n  23:     expect(formatValue({ id: \"bpl_household\", textEn: \"Is your household BPL?\", provenance: { status: \"verified\", sourceTitle: \"V\", sourceUrl: \"https://x\", verifiedOn: \"2026-10-10\", version: \"1.0.0\" } })).toBe(\r\n\ntasks/LOG.md:162:119\n  160: **Open issues**\n  161: - **`/admin` has no authentication.** Anyone who can reach the server can run the agent (it costs API credits) and publish rules. Fine for the local demo; must be decided before any deployment.\n> 162: - The engine supports one flat benefit amount, so IGNOAPS's ₹500 for 80+ is a note, not computed. The agent also used 120 as an upper age placeholder, because `AgeRange.max` is required.\n  163: - A live run takes about 20–60 s; a model timeout can cost one retry (seen once in the IGNOAPS run).\n  164: - I did not click through `/admin` or `/` in a real browser here (no browser automation). Both were checked through the server-rendered HTML and the APIs on `next start`.\n\ntasks/LOG.md:222:95\n  220: \n  221: **Requests for Claude**\n> 222: - Should the T3 agent prompt mention that `ageRange.max` may now be omitted (instead of using 120)? `ruleMaintenance.ts` was out of scope, so I left it unchanged.\n  223: - Age-banded payments are recorded as future scope in `memory-bank/progress.md`, as you asked.\n  224: \n\ntasks/NEXT.md:3:164\n  1: # NEXT TASK: T-last, freeze, README, final checks (time box about 40 min)\n  2: \n> 3: T4 reviewed: 264 tests and all checks pass. Answer: **yes**, update the rule maintenance agent's prompt to say the upper age limit may be left out (no placeholder 120). This is the only code change allowed; add or adjust one test if needed.\n  4: \n  5: No new features after that. Bug fixes only.\n","success":true},{"query":"SYSTEM_PROMPT|RULE_AGENT_PROMPT_VERSION","result":"Found 8 results for pattern: SYSTEM_PROMPT|RULE_AGENT_PROMPT_VERSION\nSearched 151 files.\n\nsrc/server/agents/ruleMaintenance.ts:17:14\n  15: import type { RuleVersionStatus } from \"../store\";\r\n  16: \r\n> 17: export const RULE_AGENT_PROMPT_VERSION = \"rule-agent-v1\";\r\n  18: \r\n  19: export const SYSTEM_PROMPT = `You maintain the rule packs of KaagazCheck, a welfare-application checker for Assam, India.\r\n\nsrc/server/agents/ruleMaintenance.ts:19:14\n  17: export const RULE_AGENT_PROMPT_VERSION = \"rule-agent-v1\";\r\n  18: \r\n> 19: export const SYSTEM_PROMPT = `You maintain the rule packs of KaagazCheck, a welfare-application checker for Assam, India.\r\n  20: You receive the text of an official scheme notice or guideline. Turn it into a proposed rule-pack version, tested, for a human to approve.\r\n  21: You can act ONLY through your tools. You cannot edit files, and you cannot publish: a person reviews and publishes.\r\n\nsrc/server/agents/ruleMaintenance.ts:257:20\n  255:   let lastText = \"\";\r\n  256:   const run = await runToolAgent({\r\n> 257:     promptVersion: RULE_AGENT_PROMPT_VERSION,\r\n  258:     systemPrompt: `${SYSTEM_PROMPT}\\n\\nToday's date: ${today}.`,\r\n  259:     input: `Scheme notice:\\n\"\"\"\\n${notice}\\n\"\"\"`,\r\n\nsrc/server/agents/ruleMaintenance.ts:258:22\n  256:   const run = await runToolAgent({\r\n  257:     promptVersion: RULE_AGENT_PROMPT_VERSION,\r\n> 258:     systemPrompt: `${SYSTEM_PROMPT}\\n\\nToday's date: ${today}.`,\r\n  259:     input: `Scheme notice:\\n\"\"\"\\n${notice}\\n\"\"\"`,\r\n  260:     tools: createRuleTools(service, session),\r\n\nsrc/server/ai.ts:72:7\n  70: }\r\n  71: \r\n> 72: const SYSTEM_PROMPT = `You read photos of Indian government documents for a welfare-application checker.\r\n  73: Return ONLY one JSON object, no other text:\r\n  74: {\"docType\": string, \"fields\": {...}, \"confidence\": {...}}\r\n\nsrc/server/ai.ts:136:34\n  134:     temperature: 0,\r\n  135:     messages: [\r\n> 136:       { role: \"system\", content: SYSTEM_PROMPT },\r\n  137:       {\r\n  138:         role: \"user\",\r\n\nsrc/server/ai.ts:183:16\n  181: export type ClassifyResult = RawClassification | { error: \"ai_unavailable\" | \"ai_failed\" | \"invalid_text\" };\r\n  182: \r\n> 183: const CLASSIFY_SYSTEM_PROMPT = `You classify Indian welfare-scheme rejection or payment-status messages (PM-KISAN, pensions, Orunodoi, DBT).\r\n  184: Return ONLY one JSON object, no other text: {\"code\": string, \"confidence\": number}\r\n  185: - code: exactly ONE of ${REJECTION_CODES.join(\", \")}.\r\n\nsrc/server/ai.ts:221:43\n  219:     temperature: 0,\r\n  220:     messages: [\r\n> 221:       { role: \"system\", content: CLASSIFY_SYSTEM_PROMPT },\r\n  222:       { role: \"user\", content: `Message to classify:\\n\"\"\"\\n${clean}\\n\"\"\"` },\r\n  223:     ],\r\n","success":true},{"query":"ageRange","result":"Found 38 results for pattern: ageRange\nSearched 151 files.\n\nmemory-bank/activeContext.md:9:6\n  7: - **Rejection decoder** `/decode`: textarea → `POST /api/decode` → `ai.ts classifyRejection()` (zod `RawClassification`: one `RejectionCode` + confidence) → pure `decodeResult()` in `src/core/decode.ts`. ≥ 0.7 and not UNKNOWN → matched, with the fixed steps from `rejectionCodes.ts`; otherwise needs verification + `ASK_AT_OFFICE`. Digits are redacted before the model sees them. Linked from home (\"Got a rejection? Decode it\"). Works without AI (needs verification).\r\n  8: - **`npm run demo:reset`:** `scripts/demo-reset.mjs` → `RuleStore.resetAll()` (one transaction). A running server drops the reset versions on its next request (`syncRegistry` → `resetRegistry`). The real `data/kaagaz.db` was reset in this run (it had 2 old proposals).\r\n> 9: - **`AgeRange.max` is optional** (no upper limit, \"60 or