ct(res.status).toBe(503);\r\n> 37:     expect(await res.json()).toEqual({ error: \"ai_unavailable\" });\r\n  38:   });\r\n  39: \r\n\nsrc/server/classify.test.ts:50:22\n  48:   });\r\n  49: \r\n> 50:   it(\"no key/model → ai_unavailable; empty or too long text → invalid_text; never calls the network\", async () => {\r\n  51:     const { fetchMock, deps } = setup([]);\r\n  52:     expect(await classifyRejection(\"Name mismatch\", { ...deps, env: {} })).toEqual({ error: \"ai_unavailable\" });\r\n\nsrc/server/classify.test.ts:52:94\n  50:   it(\"no key/model → ai_unavailable; empty or too long text → invalid_text; never calls the network\", async () => {\r\n  51:     const { fetchMock, deps } = setup([]);\r\n> 52:     expect(await classifyRejection(\"Name mismatch\", { ...deps, env: {} })).toEqual({ error: \"ai_unavailable\" });\r\n  53:     expect(await classifyRejection(\"   \", deps)).toEqual({ error: \"invalid_text\" });\r\n  54:     expect(await classifyRejection(\"x\".repeat(2001), deps)).toEqual({ error: \"invalid_text\" });\r\n\ntasks/LOG.md:78:190\n  76: - Pure core (tested): `src/core/extraction.ts` (raw model JSON → strict `ExtractedDoc`; DD/MM/YYYY → ISO; full Aadhaar → last 4 digits; AI-read fields without a score get confidence 0.5 so they are always confirmed), `src/core/docFields.ts` (which fields each doc type needs), `src/core/flow.ts` (document slots, field edit/confirm, upsert/remove, relevant answers), `src/core/reportView.ts` (fix / verify / external / ok sections, 🟢🔴🟡⚪ tones, `₹1,25,000` formatting, benefit view), `src/core/catalog.ts` (serialisable scheme list, PM-KISAN first as flagship), `src/core/thresholds.ts`.\n  77: - `src/i18n.ts`: all fixed UI strings, `as` (default) + `en`, same keys (tested), with doc/office names reused from `labels.ts`.\n> 78: - `src/server/ai.ts`: the only model caller. Cline API chat/completions with an `image_url` part, then JSON extraction, zod `RawExtraction`, `toExtractedDoc`, one retry, then `{ error }` (`ai_unavailable` | `ai_failed` | `invalid_image`). `fetch`/`env`/`log` are injectable for tests. Logs `{ model, promptVersion: \"extract-doc-v1\", inputHash (sha256/16), attempt, outcome, ms }` only.\n  79: - `src/server/api.ts` + `src/app/api/check/route.ts`, `src/app/api/extract/route.ts` (thin). `/api/check` validates with zod (strict `ExtractedDoc`, so a full Aadhaar is rejected), 404 for an unknown scheme/version, `asOfDate` defaults to today in IST. Error bodies hold only paths and codes, never submitted values.\n  80: - UI (`src/app/_components/`): `KaagazApp` (state + steps), `SchemeStep`, `DocsStep` (photo per slot with camera capture, browser downscale to JPEG ≤1600px, \"type it in\", samples A/B/C for the chosen scheme), `ConfirmStep` (low confidence highlighted in amber, \"This is correct\" button), `QuestionsStep` (big Yes/No, \"rule not confirmed\" badge), `ReportStep` + `CheckItem` + `BenefitCard`, `CoverSheet` (print only, masked Aadhaar, no account number), `ui.tsx`, `image.ts`.\n\ntasks/LOG.md:92:261\n  90: - `npm run typecheck`: pass. `npm run lint`: pass. `npm run build`: pass (`/` static, `/api/check` + `/api/extract` dynamic).\n  91: - Smoke test on `next start`: home HTML has `lang=\"as\"`, the Assamese title and the flagship badge. `/api/check` A → likely_eligible + ready_for_review (4 external checks to verify); B → action_required (`name_land_record` action_required, `name_bank_passbook` possible_match → verify); C → action_required (`doc_death_certificate`).\n> 92: - Live AI check with the real key (fake \"SAMPLE ONLY\" Aadhaar image I drew locally): 200, `{ name: \"Ramesh Kumar Sharma\", dob: \"1975-03-12\", aadhaarLast4: \"4821\" }` from the printed \"1234 5678 4821\". Image input is accepted by the Cline API. With no key: 503 `ai_unavailable`, and the UI switches to manual entry.\n  93: \n  94: \n\ntasks/LOG.md:98:190\n  96: - **No `export const runtime = \"nodejs\"` in the route files.** Next 16.4 fails the build with \"Route segment config \"runtime\" is not compatible with `nextConfig.cacheComponents`\". Node.js is the default (and the only runtime with cacheComponents), so the routes do run on Node. A comment in each route explains this. Rule 03-stack asks for the export, so please confirm.\n  97: - **The Cline API wraps the OpenAI body as `{ data: { choices } }`.** `ai.ts` accepts both shapes (tested). Before this fix, every live call fell back to `ai_failed`.\n> 98: - **Environment gotcha:** this shell has an empty `CLINE_MODEL` environment variable. Next does not override an existing env var from `.env.local`, so the server saw no model and returned `ai_unavailable`. It works after `Remove-Item Env:CLINE_MODEL`. Added to techContext.\n  99: - **Minimum data:** nothing is read from the death certificate or BPL proof (the engine only checks that they are present), so `husbandName` is not collected. The cover sheet shows the masked Aadhaar and no account number.\n  100: - **Empty manual docs:** \"Type it in\" adds the document with empty fields. The engine then counts it as present, and its fields show as \"please verify\"/\"could not read\". I think this is right (\"I have it, I'll type it\"); flagging it in case you prefer the slot to count only once a field is filled.\n\ntasks/LOG.md:98:223\n  96: - **No `export const runtime = \"nodejs\"` in the route files.** Next 16.4 fails the build with \"Route segment config \"runtime\" is not compatible with `nextConfig.cacheComponents`\". Node.js is the default (and the only runtime with cacheComponents), so the routes do run on Node. A comment in each route explains this. Rule 03-stack asks for the export, so please confirm.\n  97: - **The Cline API wraps the OpenAI body as `{ data: { choices } }`.** `ai.ts` accepts both shapes (tested). Before this fix, every live call fell back to `ai_failed`.\n> 98: - **Environment gotcha:** this shell has an empty `CLINE_MODEL` environment variable. Next does not override an existing env var from `.env.local`, so the server saw no model and returned `ai_unavailable`. It works after `Remove-Item Env:CLINE_MODEL`. Added to techContext.\n  99: - **Minimum data:** nothing is read from the death certificate or BPL proof (the engine only checks that they are present), so `husbandName` is not collected. The cover sheet shows the masked Aadhaar and no account number.\n  100: - **Empty manual docs:** \"Type it in\" adds the document with empty fields. The engine then counts it as present, and its fields show as \"please verify\"/\"could not read\". I think this is right (\"I have it, I'll type it\"); flagging it in case you prefer the slot to count only once a field is filled.\n\ntasks/LOG.md:196:123\n  194: - `src/core/decode.ts` (pure): `RawClassification` (zod: `RejectionCode` enum + confidence 0–1), `decodeResult()`. A known code with confidence ≥ 0.7 → `matched` with fixed steps from `rejectionCodes.ts`. Otherwise (UNKNOWN, < 0.7, or no AI) → `needs_verification`, showing the UNKNOWN steps and `ASK_AT_OFFICE` (4 bilingual questions); a low-confidence guess appears only as \"It might be: … please confirm\". `redactForModel()`. `MAX_DECODE_CHARS` is 2000.\n  195: - `ai.ts` `classifyRejection()`: text only, `temperature: 0`, prompt `classify-rejection-v1` (it lists the codes and treats the pasted text as data only); zod check, one retry, `{ error }` fallback; never throws.\n> 196: - `POST /api/decode` (`handleDecode` in `api.ts`): always returns a useful answer, even when the AI is unavailable (`ai: \"ai_unavailable\"` + needs_verification). Bad input → 400 before any AI call.\n  197: - UI: `src/app/decode/{page,DecodeApp,DecodeAnswer}.tsx`, Assamese by default with an English toggle; the steps are also shown in the other language (collapsed). Home: a \"Got a rejection? Decode it\" card under the scheme list. Strings are in `i18n.ts` (`decode.*`, both languages).\n  198: - Tests: `core/decode.test.ts` (9), `server/classify.test.ts` (4, mocked fetch), `server/apiDecode.test.ts` (4, mocked `ai.ts`), including the backlog's done-when case.\n\ntasks/LOG.md:211:322\n  209: **Results**\n  210: - `npm test`: 35 files, **264 passed, 0 failed** (225 before + 39 new). `npm run typecheck`, `npm run lint`, `npm run build`: pass (`/decode` static, `/api/decode` dynamic).\n> 211: - Live check (`next start`, real Cline API): \"Payment failed: Aadhaar not seeded with bank account\" → `matched AADHAAR_NOT_SEEDED_BANK` 0.98 with Assamese steps; a nonsense message → `UNKNOWN` → needs_verification. The log lines hold only fn/model/promptVersion/inputHash/outcome/ms. Without a key: needs_verification + `ai_unavailable`.\n  212: - Passcode live check: with `ADMIN_PASSCODE` set, no header or the wrong one → 401 (list and publish), the right one → 200. Without it, `/admin` shows the \"Demo mode: unprotected\" banner.\n  213: - `npm run demo:reset` on the real `data/kaagaz.db` removed the 2 leftover T3 proposals (orunodoi-3 2.1.0, nsap-old-age 1.0.0, both `proposed`); a backup is in `%TEMP%\\kaagaz-before-reset.db`. Home then listed pm-kisan, orunodoi-3, nsap-widow (all 2.0.0), with no Old Age Pension.\n","success":true},{"query":"Got a rejection","result":"Found 3 results for pattern: Got a rejection\nSearched 151 files.\n\nmemory-bank/activeContext.md:7:400\n  5: - **Admin passcode:** optional `ADMIN_PASSCODE` in `.env.local`. When set, `/api/admin/*` needs the header `x-admin-passcode` (`src/server/adminAuth.ts`, 401 otherwise) and `/admin` shows a passcode box (kept in sessionStorage). When not set, `/admin` shows an amber \"Demo mode: unprotected\" banner.\r\n  6: - **Guardrails audit:** `src/guardrails.test.ts` (renders ReportStep/CoverSheet/CheckItem to static HTML + scans the source). One fix: the printed cover sheet now prints \"Source · verified on · Provisional rule\" per listed check. The checklist is in `tasks/LOG.md`.\r\n> 7: - **Rejection decoder** `/decode`: textarea → `POST /api/decode` → `ai.ts classifyRejection()` (zod `RawClassification`: one `RejectionCode` + confidence) → pure `decodeResult()` in `src/core/decode.ts`. ≥ 0.7 and not UNKNOWN → matched, with the fixed steps from `rejectionCodes.ts`; otherwise needs verification + `ASK_AT_OFFICE`. Digits are redacted before the model sees them. Linked from home (\"Got a rejection? Decode it\"). Works without AI (needs verification).\r\n  8: - **`npm run demo:reset`:** `scripts/demo-reset.mjs` → `RuleStore.resetAll()` (one transaction). A running server drops the reset versions on its next request (`syncRegistry` → `resetRegistry`). The real `data/kaagaz.db` was reset in this run (it had 2 old proposals).\r\n  9: - **`AgeRange.max` is optional** (no upper limit, \"60 or older\").\r\n\nsrc/i18n.ts:118:16\n  116:   },\r\n  117:   decode: {\r\n> 118:     homeLink: \"Got a rejection? Decode it\",\r\n  119:     title: \"Decode a rejection message\",\r\n  120:     intro: \"Paste the rejection or payment-status message exactly as you got it (SMS, portal or letter). We tell you what it most likely means and what to do.\",\r\n\ntasks/LOG.md:197:172\n  195: - `ai.ts` `classifyRejection()`: text only, `temperature: 0`, prompt `classify-rejection-v1` (it lists the codes and treats the pasted text as data only); zod check, one retry, `{ error }` fallback; never throws.\n  196: - `POST /api/decode` (`handleDecode` in `api.ts`): always returns a useful answer, even when the AI is unavailable (`ai: \"ai_unavailable\"` + needs_verification). Bad input → 400 before any AI call.\n> 197: - UI: `src/app/decode/{page,DecodeApp,DecodeAnswer}.tsx`, Assamese by default with an English toggle; the steps are also shown in the other language (collapsed). Home: a \"Got a rejection? Decode it\" card under the scheme list. Strings are in `i18n.ts` (`decode.*`, both languages).\n  198: - Tests: `core/decode.test.ts` (9), `server/classify.test.ts` (4, mocked fetch), `server/apiDecode.test.ts` (4, mocked `ai.ts`), including the backlog's done-when case.\n  199: \n","success":true}],"durationMs":36}}
