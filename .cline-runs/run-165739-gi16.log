{"ts":"2026-10-10T11:41:01.508Z","type":"agent_event","event":{"type":"content_start","contentType":"tool","toolName":"editor","toolCallId":"toolu_011DDgFaniQoP3tkx5QhYD13","input":{"path":"C:\\Dev\\cline hackathon\\build\\src\\server\\decode.test.ts","new_text":"// Rejection decoder: classifyRejection (fetch mocked, no network) and POST /api/decode (ai.ts mocked).\nimport { afterEach, describe, expect, it, vi } from \"vitest\";\nimport { type AiLogEntry, classifyRejection } from \"./ai\";\n\nconst ENV = { CLINE_API_KEY: \"test-key-not-real\", CLINE_MODEL: \"anthropic/claude-sonnet-5.5\" };\nconst reply = (content: string, status = 200) => new Response(JSON.stringify({ data: { choices: [{ message: { content } }] } }), { status });\n\nfunction setup(responses: (Response | Error)[]) {\n  const logs: AiLogEntry[] = [];\n  const fetchMock = vi.fn(async () => {\n    const next = responses.shift();\n    if (!next) throw new Error(\"no more responses\");\n    if (next instanceof Error) throw next;\n    return next;\n  });\n  return { logs, fetchMock, deps: { fetch: fetchMock as unknown as typeof fetch, env: ENV, log: (e: AiLogEntry) => logs.push(e) } };\n}\n\ndescribe(\"classifyRejection (ai.ts)\", () => {\n  it(\"returns one zod-validated code + confidence; masks Aadhaar before sending; logs no personal data\", async () => {\n    const { fetchMock, logs, deps } = setup([reply('```json\\n{\"code\":\"AADHAAR_NOT_SEEDED_BANK\",\"confidence\":0.93}\\n```')]);\n    const text = \"Payment failed: Aadhaar 1234 5678 4821 not seeded with bank account 30012345678 (Ramesh)\";\n    expect(await classifyRejection(text, deps)).toEqual({ code: \"AADHAAR_NOT_SEEDED_BANK\", confidence: 0.93 });\n\n    const sent = String((fetchMock.mock.calls[0] as unknown as [string, RequestInit])[1].body);\n    expect(sent).toContain(\"XXXX XXXX 4821\");\n    expect(sent).not.toContain(\"1234 5678\");\n    expect(sent).not.toContain(\"30012345678\");\n    expect(sent).toContain(\"AADHAAR_NOT_SEEDED_BANK\"); // the allowed codes are in the prompt\n\n    expect(logs).toHaveLength(1);\n    expect(logs[0]).toMatchObject({ fn: \"classifyRejection\", outcome: \"ok\", promptVersion: \"classify-rejection-v1\", model: ENV.CLINE_MODEL });\n    expect(logs[0].inputHash).toMatch(/^[0-9a-f]{16}$/);\n    for (const secret of [\"Ramesh\", \"4821\", \"30012345678\", ENV.CLINE_API_KEY]) expect(JSON.stringify(logs)).not.toContain(secret);\n  });\n\n  it(\"a code outside the enum or a confidence outside 0–1 is rejected; one retry, then ai_failed\", async () => {\n    const { fetchMock, logs, deps } = setup([reply('{\"code\":\"BANK_ISSUE\",\"confidence\":0.9}'), reply('{\"code\":\"EKYC_PENDING\",\"confidence\":1.4}')]);\n    expect(await classifyRejection(\"eKYC pending\", deps)).toEqual({ error: \"ai_failed\" });\n    expect(fetchMock).toHaveBeenCalledTimes(2);\n    expect(logs.map((l) => l.outcome)).toEqual([\"bad_output\", \"bad_output\"]);\n  });\n\n  it(\"retries once after an HTTP error, then succeeds\", async () => {\n    const { deps, logs } = setup([reply(\"{}\", 500), reply('{\"code\":\"EKYC_PENDING\",\"confidence\":0.88}')]);\n    expect(await classifyRejection(\"eKYC not done\", deps)).toEqual({ code: \"EKYC_PENDING\", confidence: 0.88 });\n    expect(logs.map((l) => l.outcome)).toEqual([\"http_error\", \"ok\"]);\n  });\n\n  it(\"no key/model → ai_unavailable; empty or too long text → invalid_text; never calls the network\", async () => {\n    const { fetchMock, deps } = setup([]);\n    expect(await classifyRejection(\"Name mismatch\", { ...deps, env: {} })).toEqual({ error: \"ai_unavailable\" });\n    expect(await classifyRejection(\"   \", deps)).toEqual({ error: \"invalid_text\" });\n    expect(await classifyRejection(\"x\".repeat(2001), deps)).toEqual({ error: \"invalid_text\" });\n    expect(fetchMock).not.toHaveBeenCalled();\n  });\n});\n\nconst classify = vi.fn();\nvi.mock(\"@/server/ai\", async (orig) => ({ ...(await orig<object>()), classifyRejection: classify }));\n\ndescribe(\"POST /api/decode (AI mocked)\", () => {\n  afterEach(() => {\n    classify.mockReset();\n  });\n  const post = async (body: unknown) => {\n    const { POST } = await import(\"@/app/api/decode/route\");\n    return POST(new Request(\"http://localhost/api/decode\", { method: \"POST\", headers: { \"Content-Type\": \"application/json\" }, body: JSON.stringify(body) }));\n  };\n\n  it('\"Payment failed: Aadhaar not seeded with bank account\" → AADHAAR_NOT_SEEDED_BANK with Assamese fix steps', async () => {\n    classify.mockResolvedValue({ code: \"AADHAAR_NOT_SEEDED_BANK\", confidence: 0.95 });\n    const res = await post({ text: \"Payment failed: Aadhaar not seeded with bank account\" });\n    expect(res.status).toBe(200);\n    const body = await res.json();\n    expect(body.ai).toBe(\"ok\");\n    expect(body.result).toMatchObject({ status: \"matched\", code: \"AADHAAR_NOT_SEEDED_BANK\", confidence: 0.95, ask: [] });\n    expect(body.result.fix.stepsAs.length).toBeGreaterThan(0);\n    expect(body.result.fix.stepsAs.every((s: string) => /[\\u0980-\\u09FF]/.test(s))).toBe(true);\n    expect(classify).toHaveBeenCalledWith(\"Payment failed: Aadhaar not seeded with bank account\");\n  });\n\n  it(\"low confidence or UNKNOWN → needs_verification + what to ask at the office\", async () => {\n    classify.mockResolvedValueOnce({ code: \"LAND_NOT_VERIFIED\", confidence: 0.5 });\n    const low = (await (await post({ text: \"status: under process at level 2\" })).json()).result;\n    expect(low).toMatchObject({ status: \"needs_verification\", code: \"UNKNOWN\" });\n    expect(low.possible.code).toBe(\"LAND_NOT_VERIFIED\");\n    expect(low.ask.length).toBeGreaterThan(0);\n\n    classify.mockResolvedValueOnce({ code: \"UNKNOWN\", confidence: 0.9 });\n    const unknown = (await (await post({ text: \"something odd\" })).json()).result;\n    expect(unknown).toMatchObject({ status: \"needs_verification\", code: \"UNKNOWN\", possible: null });\n  });\n\n  it(\"AI unavailable or failing → still a useful needs_verification answer (200)\", async () => {\n    classify.mockResolvedValueOnce({ error: \"ai_unavailable\" });\n    const a = await (await post({ text: \"Rejected\" })).json();\n    expect(a).toMatchObject({ ai: \"ai_unavailable\", result: { status: \"needs_verification\", code: \"UNKNOWN\", confidence: null } });\n    classify.mockRejectedValueOnce(new Error(\"boom\"));\n    const b = await (await post({ text: \"Rejected\" })).json();\n    expect(b.ai).toBe(\"ai_failed\");\n  });\n\n  it(\"bad requests → 400 before any AI call\", async () => {\n    expect((await post({ text: \"  \" })).status).toBe(400);\n    expect((await post({ text: \"x\".repeat(2001) })).status).toBe(400);\n    expect((await post({ nope: 1 })).status).toBe(400);\n    expect(classify).not.toHaveBeenCalled();\n  });\n});\n"}}}
