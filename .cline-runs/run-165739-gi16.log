{"ts":"2026-10-10T11:36:57.283Z","type":"agent_event","event":{"type":"content_update","contentType":"tool","toolName":"run_commands","toolCallId":"toolu_01UwP3qX8vQ2urBrBQ3Coq7v","update":{"stream":"stdout","chunk":"import { benefitView } from \"@/core/reportView\";\r\nimport type { Report } from \"@/core/types\";\r\nimport { STRINGS, pick, type Lang } from \"@/i18n\";\r\nimport { Card } from \"./ui\";\r\n\r\n/** Central share and state top-up shown separately; no total unless the top-up is confirmed. */\r\nexport function BenefitCard({ lang, report }: { lang: Lang; report: Report }) {\r\n  const t = STRINGS[lang].report;\r\n  const b = benefitView(report.benefit);\r\n  const period = b.period === \"month\" ? t.perMonth : t.perYear;\r\n  return (\r\n    <Card>\r\n      <h2 className=\"text-lg font-semibold\">ðŸ’° {t.benefitTitle}</h2>\r\n      <dl className=\"mt-2 grid grid-cols-[1fr_auto] gap-x-4 gap-y-1 text-base\">\r\n        <dt>{t.central}</dt>\r\n        <dd className=\"text-right font-semibold\">\r\n          {b.central} {period}\r\n        </dd>\r\n        {b.stateTopUp === null ? (\r\n          <dd className=\"col-span-2 text-amber-900\">{t.confirmLocally}</dd>\r\n        ) : (\r\n          <>\r\n            <dt>{t.stateTopUp}</dt>\r\n            <dd className=\"text-right font-semibold\">\r\n              {b.stateTopUp} {period}\r\n            </dd>\r\n          </>\r\n        )}\r\n        {b.total !== null && (\r\n          <>\r\n            <dt className=\"border-t border-zinc-200 pt-1 font-semibold\">{t.total}</dt>\r\n            <dd className=\"border-t border-zinc-200 pt-1 text-right font-bold\">\r\n              {b.total} {period}\r\n              {b.instalments ? ` (${t.instalments(b.instalments)})` : \"\"}\r\n            </dd>\r\n          </>\r\n        )}\r\n      </dl>\r\n      {b.isOverride && (b.noteEn || b.noteAs) && (\r\n        <p className=\"mt-2 text-sm text-violet-900\">{pick(lang, b.noteEn ?? \"\", b.noteAs ?? \"\")}</p>\r\n      )}\r\n    </Card>\r\n  );\r\n}\r\n// What the UI needs to know about each scheme (serialisable, no functions). Pure.\r\nimport { docSlotsFor, type DocSlot } from \"./flow\";\r\nimport { questionsFor } from \"./schemes\";\r\nimport type { Benefit, Question, SchemeRule } from \"./types\";\r\n\r\nexport const FLAGSHIP_SCHEME_ID = \"pm-kisan\";\r\n\r\nexport interface SchemeView {\r\n  id: string;\r\n  version: string;\r\n  nameEn: string;\r\n  nameAs: string;\r\n  flagship: boolean;\r\n  benefit: Pick<Benefit, \"centralShare\" | \"stateTopUp\" | \"period\">;\r\n  slots: DocSlot[];\r\n  questions: Question[];\r\n  /** Short labels for the external checks, keyed by the engine's check id (`ext_<id>`). */\r\n  external: { checkId: string; labelEn: string; labelAs: string }[];\r\n}\r\n\r\nexport function schemeView(s: SchemeRule): SchemeView {\r\n  return {\r\n    id: s.id,\r\n    version: s.version,\r\n    nameEn: s.nameEn,\r\n    nameAs: s.nameAs,\r\n    flagship: s.id === FLAGSHIP_SCHEME_ID,\r\n    benefit: { centralShare: s.benefit.centralShare, stateTopUp: s.benefit.stateTopUp, period: s.benefit.period },\r\n    slots: docSlotsFor(s),\r\n    questions: questionsFor(s),\r\n    external: s.externalChecks.map((e) => ({ checkId: `ext_${e.id}`, labelEn: e.labelEn, labelAs: e.labelAs })),\r\n  };\r\n}\r\n\r\n/** Flagship first, then the registry order. */\r\nexport function catalogOf(schemes: readonly SchemeRule[]): SchemeView[] {\r\n  const views = schemes.map(schemeView);\r\n  return [...views.filter((v) => v.flagship), ...views.filter((v) => !v.flagship)];\r\n}\r\n","executionId":"933f63d1-d98c-484d-8cb5-7583abd083f9","detachable":false,"commandIndex":1,"query":"cd 'C:\\Dev\\cline hackathon\\build'; Get-Content src\\app\\_components\\BenefitCard.tsx; Get-Content src\\core\\catalog.ts"}}}
