{"ts":"2026-10-10T11:42:38.939Z","type":"agent_event","event":{"type":"content_start","contentType":"tool","toolName":"editor","toolCallId":"toolu_011AyGWroyovUjfUeyUTenUA","input":{"path":"C:\\Dev\\cline hackathon\\build\\src\\app\\decode\\DecodeApp.tsx","new_text":"\"use client\";\n// Paste a rejection message → /api/decode → one known reason + fixed steps, or \"needs verification\"\n// + what to ask at the office. The browser decides nothing: it only shows the server's result.\nimport Link from \"next/link\";\nimport { useEffect, useRef, useState } from \"react\";\nimport { APP_NAME, APP_NAME_AS } from \"@/core/appInfo\";\nimport { MAX_DECODE_CHARS, type DecodeResult } from \"@/core/decode\";\nimport { DEFAULT_LANG, STRINGS, fixWhereLabel, pick, type Lang } from \"@/i18n\";\nimport { Card, VerdictBanner, btn } from \"../_components/ui\";\n\ntype State =\n  | { status: \"idle\" }\n  | { status: \"loading\" }\n  | { status: \"error\" }\n  | { status: \"done\"; result: DecodeResult; ai: \"ok\" | \"ai_unavailable\" | \"ai_failed\" };\n\nexport function DecodeApp() {\n  const [lang, setLang] = useState<Lang>(DEFAULT_LANG);\n  const [text, setText] = useState(\"\");\n  const [state, setState] = useState<State>({ status: \"idle\" });\n  const resultRef = useRef<HTMLDivElement>(null);\n  const t = STRINGS[lang];\n  const d = t.decode;\n\n  useEffect(() => {\n    document.documentElement.lang = lang;\n  }, [lang]);\n\n  useEffect(() => {\n    if (state.status === \"done\") resultRef.current?.focus();\n  }, [state.status]);\n\n  async function decode() {\n    setState({ status: \"loading\" });\n    try {\n      const res = await fetch(\"/api/decode\", { method: \"POST\", headers: { \"Content-Type\": \"application/json\" }, body: JSON.stringify({ text }) });\n      const body = (await res.json()) as { result?: DecodeResult; ai?: \"ok\" | \"ai_unavailable\" | \"ai_failed\" };\n      if (!res.ok || !body.result || !body.ai) {\n        setState({ status: \"error\" });\n        return;\n      }\n      setState({ status: \"done\", result: body.result, ai: body.ai });\n    } catch {\n      setState({ status: \"error\" });\n    }\n  }\n\n  return (\n    <div className=\"mx-auto flex w-full max-w-xl flex-1 flex-col gap-4 px-4 pb-10 pt-4\">\n      <header className=\"flex items-start justify-between gap-3\">\n        <div>\n          <p className=\"text-xl font-bold leading-tight\">\n            <span lang=\"en\">{APP_NAME}</span> · {APP_NAME_AS}\n          </p>\n          <Link href=\"/\" className=\"text-sm text-teal-800 underline underline-offset-2\">\n            ← {d.back}\n          </Link>\n        </div>\n        <button\n          type=\"button\"\n          className={btn.secondary}\n          onClick={() => setLang(lang === \"as\" ? \"en\" : \"as\")}\n          aria-label={t.langToggleAria}\n          lang={lang === \"as\" ? \"en\" : \"as\"}\n        >\n          {t.langToggle}\n        </button>\n      </header>\n\n      <main className=\"flex flex-col gap-4\">\n        <h1 className=\"text-2xl font-bold leading-snug\">{d.title}</h1>\n        <p className=\"text-base text-zinc-700\">{d.intro}</p>\n\n        <Card>\n          <form\n            className=\"flex flex-col gap-3\"\n            onSubmit={(e) => {\n              e.preventDefault();\n              if (text.trim() && state.status !== \"loading\") void decode();\n            }}\n          >\n            <label htmlFor=\"rejection-text\" className=\"text-lg font-semibold\">\n              {d.label}\n            </label>\n            <textarea\n              id=\"rejection-text\"\n              value={text}\n              onChange={(e) => setText(e.target.value)}\n              rows={5}\n              maxLength={MAX_DECODE_CHARS}\n              placeholder={d.placeholder}\n              className=\"w-full rounded-xl border-2 border-zinc-300 bg-white px-3 py-2 text-base focus-visible:outline-3 focus-visible:outline-teal-500\"\n            />\n            <p className=\"text-sm text-zinc-600\">🔒 {d.privacy}</p>\n            <button type=\"submit\" className={btn.primary} disabled={text.trim() === \"\" || state.status === \"loading\"}>\n              {state.status === \"loading\" ? `⏳ ${d.working}` : `🔍 ${d.submit}`}\n            </button>\n          </form>\n        </Card>\n\n        {state.status === \"error\" && (\n          <p role=\"alert\" className=\"rounded-xl bg-red-50 p-3 text-base text-red-900\">\n            {d.error}\n          </p>\n        )}\n        {state.status === \"loading\" && (\n          <p role=\"status\" className=\"text-lg\">\n            ⏳ {d.working}\n          </p>\n        )}\n        {state.status === \"done\" && (\n          <div ref={resultRef} tabIndex={-1} className=\"flex flex-col gap-4 outline-none\">\n            <DecodeAnswer lang={lang} result={state.result} ai={state.ai} />\n          </div>\n        )}\n      </main>\n    </div>\n  );\n}\n\nfunction DecodeAnswer({ lang, result: r, ai }: { lang: Lang; result: DecodeResult; ai: \"ok\" | \"ai_unavailable\" | \"ai_failed\" }) {\n  const d = STRINGS[lang].decode;\n  const matched = r.status === \"matched\";\n  const other: Lang = lang === \"as\" ? \"en\" : \"as\";\n  return (\n    <>\n      <VerdictBanner\n        title={matched ? d.matched : d.needsVerification}\n        label={matched ? pick(lang, r.fix.titleEn, r.fix.titleAs) : d.needsVerificationNote}\n        tone={matched ? \"green\" : \"yellow\"}\n      >\n        {r.confidence !== null && <p className=\"mt-1 text-sm\">{d.confidence(Math.round(r.confidence * 100))}</p>}\n        {ai !== \"ok\" && <p className=\"mt-1 text-sm\">{d.aiOff}</p>}\n        {r.possible && <p className=\"mt-2 text-base\">{d.possibly(pick(lang, r.possible.titleEn, r.possible.titleAs))}</p>}\n      </VerdictBanner>\n\n      <Card>\n        <h2 className=\"text-lg font-bold\">{d.steps}</h2>\n        <ol className=\"mt-2 list-decimal pl-6 text-base leading-relaxed\">\n          {(lang === \"as\" ? r.fix.stepsAs : r.fix.stepsEn).map((s) => (\n            <li key={s}>{s}</li>\n          ))}\n        </ol>\n        <p className=\"mt-2 text-sm\">\n          <span className=\"font-semibold\">📍 {d.where}: </span>\n          {fixWhereLabel(lang, r.fix.fixWhere)}\n        </p>\n        <details className=\"mt-2\" lang={other}>\n          <summary className=\"cursor-pointer text-sm font-medium text-zinc-700\">{STRINGS[other].decode.steps}</summary>\n          <ol className=\"mt-1 list-decimal pl-6 text-sm\">\n            {(other === \"as\" ? r.fix.stepsAs : r.fix.stepsEn).map((s) => (\n              <li key={s}>{s}</li>\n            ))}\n          </ol>\n        </details>\n      </Card>\n\n      {r.ask.length > 0 && (\n        <Card className=\"border-amber-300\">\n          <h2 className=\"text-lg font-bold text-amber-900\">❓ {d.ask}</h2>\n          <ul className=\"mt-2 flex flex-col gap-2 text-base\">\n            {r.ask.map((q) => (\n              <li key={q.en}>\n                <p>{pick(lang, q.en, q.as)}</p>\n                <p className=\"text-sm text-zinc-600\" lang={other}>\n                  {pick(other, q.en, q.as)}\n                </p>\n              </li>\n            ))}\n          </ul>\n        </Card>\n      )}\n\n      <footer className=\"rounded-xl bg-zinc-100 p-3 text-sm text-zinc-800\">\n        <p lang=\"as\">{STRINGS.as.decode.disclaimer}</p>\n        <p lang=\"en\" className=\"mt-1\">\n          {STRINGS.en.decode.disclaimer}\n        </p>\n      </footer>\n    </>\n  );\n}\n"}}}
