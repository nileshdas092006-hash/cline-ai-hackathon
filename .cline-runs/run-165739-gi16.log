Request(\"http://localhost/x\", { method: \"POST\" }), { params: Promise.resolve({ id: \"999\" }) })).status).toBe(409);\n116 |   });\n117 | });","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\server\\api.ts","result":" 1 | // Request schemas and handlers for the API routes. The route files are thin wrappers.\n 2 | // /api/check runs the deterministic engine only (no model). /api/extract goes through ai.ts.\n 3 | import { z } from \"zod\";\n 4 | import { evaluate } from \"@/core/evaluate\";\n 5 | import { getScheme } from \"@/core/schemes\";\n 6 | import { Answers, DocType, ExtractedDoc, IsoDate } from \"@/core/types\";\n 7 | import { extractDocument } from \"@/server/ai\";\n 8 | import { getRuleService } from \"@/server/rules\";\n 9 | \n10 | /** Base64 of a ~6 MB image is ~8 MB; refuse anything bigger before parsing further. */\n11 | const MAX_BODY_CHARS = 9 * 1024 * 1024;\n12 | \n13 | export const CheckRequest = z.object({\n14 |   schemeId: z.string().min(1).max(64),\n15 |   schemeVersion: z.string().max(32).optional(),\n16 |   docs: z.array(ExtractedDoc).max(20),\n17 |   answers: Answers,\n18 |   asOfDate: IsoDate.optional(),\n19 | });\n20 | export type CheckRequest = z.infer<typeof CheckRequest>;\n21 | \n22 | export const ExtractRequest = z.object({\n23 |   image: z.string().min(1).max(MAX_BODY_CHARS),\n24 |   docType: DocType.optional(),\n25 | });\n26 | \n27 | /** Today's date in India (Asia/Kolkata, UTC+5:30, no DST) as YYYY-MM-DD. */\n28 | export function todayInIndia(now: Date = new Date()): string {\n29 |   return new Date(now.getTime() + 330 * 60_000).toISOString().slice(0, 10);\n30 | }\n31 | \n32 | const json = (body: unknown, status = 200) => Response.json(body, { status });\n33 | \n34 | async function readJson(req: Request): Promise<{ ok: true; value: unknown } | { ok: false }> {\n35 |   try {\n36 |     const text = await req.text();\n37 |     if (text.length > MAX_BODY_CHARS) return { ok: false };\n38 |     return { ok: true, value: JSON.parse(text) };\n39 |   } catch {\n40 |     return { ok: false };\n41 |   }\n42 | }\n43 | \n44 | /** Only paths and codes: never echo submitted values (they can hold personal data). */\n45 | function issues(error: z.ZodError) {\n46 |   return error.issues.slice(0, 10).map((i) => ({ path: i.path.join(\".\"), code: i.code }));\n47 | }\n48 | \n49 | export async function handleCheck(req: Request): Promise<Response> {\n50 |   const body = await readJson(req);\n51 |   if (!body.ok) return json({ error: \"invalid_json\" }, 400);\n52 |   const parsed = CheckRequest.safeParse(body.value);\n53 |   if (!parsed.success) return json({ error: \"invalid_request\", issues: issues(parsed.error) }, 400);\n54 | \n55 |   const { schemeId, schemeVersion, docs, answers } = parsed.data;\n56 |   getRuleService().syncRegistry(); // published rule versions take effect at once\n57 |   const scheme = getScheme(schemeId, schemeVersion);\n58 |   if (!scheme) return json({ error: \"unknown_scheme\" }, 404);\n59 |   return json(evaluate(scheme, docs, answers, parsed.data.asOfDate ?? todayInIndia()));\n60 | }\n61 | \n62 | const EXTRACT_STATUS = { ai_unavailable: 503, ai_failed: 502, invalid_image: 400 } as const;\n63 | \n64 | export async function handleExtract(req: Request): Promise<Response> {\n65 |   const body = await readJson(req);\n66 |   if (!body.ok) return json({ error: \"invalid_json\" }, 400);\n67 |   const parsed = ExtractRequest.safeParse(body.value);\n68 |   if (!parsed.success) return json({ error: \"invalid_request\", issues: issues(parsed.error) }, 400);\n69 | \n70 |   try {\n71 |     const result = await extractDocument(parsed.data.image, parsed.data.docType);\n72 |     if (\"error\" in result) return json({ error: result.error }, EXTRACT_STATUS[result.error]);\n73 |     return json(result);\n74 |   } catch {\n75 |     return json({ error: \"ai_failed\" }, 502);\n76 |   }\n77 | }","success":true}],"durationMs":4}}
