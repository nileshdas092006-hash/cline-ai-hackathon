{"ts":"2026-10-10T11:28:14.832Z","type":"agent_event","event":{"type":"content_end","contentType":"tool","toolName":"read_files","toolCallId":"toolu_01CycvpXAqVqpKyEApCYrnRj","output":[{"query":"C:\\Dev\\cline hackathon\\build\\src\\server\\ai.ts:80-195","result":" 80 |   ownerNames: array of land owner names as printed (land records).\n 81 | - confidence: for each field you returned, a number from 0 to 1 for how sure you are of the exact text.`;\n 82 | \n 83 | function userPrompt(hint?: DocType): string {\n 84 |   return hint\n 85 |     ? `The user says this photo is a ${hint}. Read it and return the JSON.`\n 86 |     : \"Read this document photo and return the JSON.\";\n 87 | }\n 88 | \n 89 | /** Pulls the first JSON object out of the model's reply (tolerates code fences or extra words). */\n 90 | export function jsonFromReply(content: string): unknown {\n 91 |   const start = content.indexOf(\"{\");\n 92 |   const end = content.lastIndexOf(\"}\");\n 93 |   if (start < 0 || end <= start) throw new SyntaxError(\"no JSON object in reply\");\n 94 |   return JSON.parse(content.slice(start, end + 1));\n 95 | }\n 96 | \n 97 | type Completion = { choices?: { message?: { content?: unknown } }[] };\n 98 | \n 99 | /** The reply text. The Cline API wraps the OpenAI-style body in `{ data: { choices } }`; plain bodies work too. */\n100 | export function replyText(body: unknown): string {\n101 |   const b = body as (Completion & { data?: Completion }) | null;\n102 |   const content = (b?.choices ?? b?.data?.choices)?.[0]?.message?.content;\n103 |   if (typeof content === \"string\") return content;\n104 |   if (Array.isArray(content)) {\n105 |     return content.map((p: { text?: unknown }) => (typeof p?.text === \"string\" ? p.text : \"\")).join(\"\");\n106 |   }\n107 |   return \"\";\n108 | }\n109 | \n110 | /**\n111 |  * Reads one document photo → ExtractedDoc with per-field confidence (Aadhaar reduced to the last 4 digits).\n112 |  * Returns `{ error: \"ai_unavailable\" }` when no key/model is configured, so the UI falls back to manual entry.\n113 |  */\n114 | export async function extractDocument(imageBase64: string, hintDocType?: DocType, deps: AiDeps = {}): Promise<ExtractResult> {\n115 |   const log = deps.log ?? defaultLog;\n116 |   const config = configFrom(deps.env ?? process.env);\n117 |   const base = { fn: \"extractDocument\" as const, model: config?.model ?? null, promptVersion: EXTRACT_PROMPT_VERSION };\n118 | \n119 |   if (!config) {\n120 |     log({ ...base, inputHash: null, attempt: 0, outcome: \"unavailable\" });\n121 |     return { error: \"ai_unavailable\" };\n122 |   }\n123 |   const image = parseImage(imageBase64);\n124 |   if (!image) {\n125 |     log({ ...base, inputHash: null, attempt: 0, outcome: \"invalid_image\" });\n126 |     return { error: \"invalid_image\" };\n127 |   }\n128 |   const inputHash = createHash(\"sha256\").update(image.data).update(hintDocType ?? \"\").digest(\"hex\").slice(0, 16);\n129 |   const doFetch = deps.fetch ?? fetch;\n130 |   const body = JSON.stringify({\n131 |     model: config.model,\n132 |     temperature: 0,\n133 |     messages: [\n134 |       { role: \"system\", content: SYSTEM_PROMPT },\n135 |       {\n136 |         role: \"user\",\n137 |         content: [\n138 |           { type: \"text\", text: userPrompt(hintDocType) },\n139 |           { type: \"image_url\", image_url: { url: `data:${image.mime};base64,${image.data}` } },\n140 |         ],\n141 |       },\n142 |     ],\n143 |   });\n144 | \n145 |   // First attempt + one retry, then the safe fallback.\n146 |   for (let attempt = 1; attempt <= 2; attempt++) {\n147 |     const started = Date.now();\n148 |     const entry = { ...base, inputHash, attempt };\n149 |     try {\n150 |       const res = await doFetch(`${config.baseUrl}/chat/completions`, {\n151 |         method: \"POST\",\n152 |         headers: { Authorization: `Bearer ${config.apiKey}`, \"Content-Type\": \"application/json\" },\n153 |         body,\n154 |         signal: AbortSignal.timeout(deps.timeoutMs ?? DEFAULT_TIMEOUT_MS),\n155 |       });\n156 |       if (!res.ok) {\n157 |         log({ ...entry, outcome: \"http_error\", status: res.status, ms: Date.now() - started });\n158 |         continue;\n159 |       }\n160 |       const json: unknown = await res.json();\n161 |       const raw = RawExtraction.safeParse(jsonFromReply(replyText(json)));\n162 |       if (!raw.success) {\n163 |         log({ ...entry, outcome: \"bad_output\", ms: Date.now() - started });\n164 |         continue;\n165 |       }\n166 |       const result = toExtractedDoc(raw.data, hintDocType);\n167 |       log({ ...entry, outcome: \"ok\", ms: Date.now() - started });\n168 |       return result;\n169 |     } catch (e) {\n170 |       log({ ...entry, outcome: e instanceof SyntaxError ? \"bad_output\" : \"network_error\", ms: Date.now() - started });\n171 |     }\n172 |   }\n173 |   return { error: \"ai_failed\" };\n174 | }\n175 | \n176 | \n177 | // ---------- tool-using agent (Cline SDK) ----------\n178 | // The Rule Maintenance Agent runs here, so this file stays the one place that talks to a model.\n179 | // The agent can only act through the tools it is given; its free text never decides anything.\n180 | \n181 | /** The part of the `@cline/sdk` Agent we use (lets tests inject a fake). */\n182 | export interface AgentLike {\n183 |   run(input: string): Promise<{ status: string; outputText: string; iterations: number; error?: Error }>;\n184 |   subscribe(listener: (event: { type: string } & Record<string, unknown>) => void): () => void;\n185 |   abort(reason?: unknown): void;\n186 | }\n187 | \n188 | export type AgentFactory = (config: Record<string, unknown>) => AgentLike | Promise<AgentLike>;\n189 | \n190 | export interface ToolAgentDeps {\n191 |   env?: Record<string, string | undefined>;\n192 |   log?: (entry: AiLogEntry) => void;\n193 |   createAgent?: AgentFactory;\n194 |   timeoutMs?: number;\n195 | }","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\app\\admin\\AdminApp.tsx:84-108","result":" 84 |         signal: abort.signal,\n 85 |       });\n 86 |       if (!res.ok || !res.body) {\n 87 |         setResult({ ok: false, error: \"request_failed\", message: `The request was refused (${res.status}).` });\n 88 |         return;\n 89 |       }\n 90 |       await readNdjson(res.body, (v) => onEvent(v as AgentEvent));\n 91 |     } catch {\n 92 |       if (!abort.signal.aborted) setResult({ ok: false, error: \"network\", message: \"The connection to the agent was lost.\" });\n 93 |     } finally {\n 94 |       setRunning(false);\n 95 |       abortRef.current = null;\n 96 |       void refresh();\n 97 |     }\n 98 |   }\n 99 | \n100 |   async function decide(id: number, decision: \"publish\" | \"reject\") {\n101 |     setMessage(null);\n102 |     try {\n103 |       const res = await fetch(`/api/admin/rules/${id}/${decision}`, { method: \"POST\" });\n104 |       const body = (await res.json()) as { row?: { schemeId: string; version: string }; errors?: string[] };\n105 |       if (!res.ok || !body.row) {\n106 |         setMessage({ tone: \"error\", text: (body.errors ?? [\"Not allowed.\"]).join(\" \") });\n107 |         return;\n108 |       }","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\server\\store.ts","result":"  1 | // The ONLY database writer. Built-in node:sqlite, WAL mode; every write runs inside a transaction.\n  2 | // Table rule_versions: rule-pack versions proposed by the Rule Maintenance Agent, then published or\n  3 | // rejected by a person. Built-in packs are version 1 in code and are not stored here.\n  4 | import { mkdirSync } from \"node:fs\";\n  5 | import { dirname, join } from \"node:path\";\n  6 | import { DatabaseSync } from \"node:sqlite\";\n  7 | import type { RuleTestCase, TestReport } from \"@/core/ruleTests\";\n  8 | import type { SchemeRule } from \"@/core/types\";\n  9 | \n 10 | export type RuleVersionStatus = \"proposed\" | \"published\" | \"rejected\";\n 11 | \n 12 | export interface RuleVersionRow {\n 13 |   id: number;\n 14 |   schemeId: string;\n 15 |   version: string;\n 16 |   rule: SchemeRule;\n 17 |   tests: RuleTestCase[];\n 18 |   testResult: TestReport;\n 19 |   status: RuleVersionStatus;\n 20 |   sourceNote: string;\n 21 |   notice: string;\n 22 |   summary: string;\n 23 |   createdAt: string;\n 24 |   approvedAt: string | null;\n 25 | }\n 26 | \n 27 | export interface NewProposal {\n 28 |   rule: SchemeRule;\n 29 |   tests: RuleTestCase[];\n 30 |   testResult: TestReport;\n 31 |   sourceNote: string;\n 32 |   notice: string;\n 33 |   summary: string;\n 34 | }\n 35 | \n 36 | const SCHEMA = `\n 37 | CREATE TABLE IF NOT EXISTS rule_versions (\n 38 |   id INTEGER PRIMARY KEY AUTOINCREMENT,\n 39 |   schemeId TEXT NOT NULL,\n 40 |   version TEXT NOT NULL,\n 41 |   ruleJson TEXT NOT NULL,\n 42 |   testsJson TEXT NOT NULL,\n 43 |   testResultJson TEXT NOT NULL,\n 44 |   status TEXT NOT NULL CHECK (status IN ('proposed', 'published', 'rejected')),\n 45 |   sourceNote TEXT NOT NULL,\n 46 |   notice TEXT NOT NULL DEFAULT '',\n 47 |   summary TEXT NOT NULL DEFAULT '',\n 48 |   createdAt TEXT NOT NULL,\n 49 |   approvedAt TEXT\n 50 | );\n 51 | CREATE UNIQUE INDEX IF NOT EXISTS rule_versions_one_published\n 52 |   ON rule_versions (schemeId, version) WHERE status = 'published';\n 53 | `;\n 54 | \n 55 | interface DbRow {\n 56 |   id: number;\n 57 |   schemeId: string;\n 58 |   version: string;\n 59 |   ruleJson: string;\n 60 |   testsJson: string;\n 61 |   testResultJson: string;\n 62 |   status: RuleVersionStatus;\n 63 |   sourceNote: string;\n 64 |   notice: string;\n 65 |   summary: string;\n 66 |   createdAt: string;\n 67 |   approvedAt: string | null;\n 68 | }\n 69 | \n 70 | function fromDb(r: DbRow): RuleVersionRow {\n 71 |   return {\n 72 |     id: r.id,\n 73 |     schemeId: r.schemeId,\n 74 |     version: r.version,\n 75 |     rule: JSON.parse(r.ruleJson) as SchemeRule,\n 76 |     tests: JSON.parse(r.testsJson) as RuleTestCase[],\n 77 |     testResult: JSON.parse(r.testResultJson) as TestReport,\n 78 |     status: r.status,\n 79 |     sourceNote: r.sourceNote,\n 80 |     notice: r.notice,\n 81 |     summary: r.summary,\n 82 |     createdAt: r.createdAt,\n 83 |     approvedAt: r.approvedAt,\n 84 |   };\n 85 | }\n 86 | \n 87 | \n 88 | export class RuleStore {\n 89 |   private readonly db: DatabaseSync;\n 90 | \n 91 |   constructor(path: string) {\n 92 |     if (path !== \":memory:\") mkdirSync(dirname(path), { recursive: true });\n 93 |     this.db = new DatabaseSync(path);\n 94 |     this.db.exec(\"PRAGMA journal_mode = WAL; PRAGMA busy_timeout = 5000;\");\n 95 |     this.db.exec(SCHEMA);\n 96 |   }\n 97 | \n 98 |   /** Runs `fn` in one transaction: all of it is written, or none of it. */\n 99 |   private tx<T>(fn: () => T): T {\n100 |     this.db.exec(\"BEGIN IMMEDIATE\");\n101 |     try {\n102 |       const out = fn();\n103 |       this.db.exec(\"COMMIT\");\n104 |       return out;\n105 |     } catch (e) {\n106 |       this.db.exec(\"ROLLBACK\");\n107 |       throw e;\n108 |     }\n109 |   }\n110 | \n111 |   journalMode(): string {\n112 |     return (this.db.prepare(\"PRAGMA journal_mode\").get() as { journal_mode: string }).journal_mode;\n113 |   }\n114 | \n115 |   saveProposal(p: NewProposal, now: string): RuleVersionRow {\n116 |     return this.tx(() => {\n117 |       const res = this.db\n118 |         .prepare(\n119 |           `INSERT INTO rule_versions (schemeId, version, ruleJson, testsJson, testResultJson, status, sourceNote, notice, summary, createdAt)\n120 |            VALUES (?, ?, ?, ?, ?, 'proposed', ?, ?, ?, ?)`,\n121 |         )\n122 |         .run(p.rule.id, p.rule.version, JSON.stringify(p.rule), JSON.stringify(p.tests), JSON.stringify(p.testResult), p.sourceNote, p.notice, p.summary, now);\n123 |       return this.mustGet(Number(res.lastInsertRowid));\n124 |     });\n125 |   }\n126 | \n127 |   /** proposed → published | rejected. Only a proposed row can change; one published row per scheme+version. */\n128 |   setStatus(id: number, status: Exclude<RuleVersionStatus, \"proposed\">, now: string): RuleVersionRow {\n129 |     return this.tx(() => {\n130 |       const row = this.get(id);\n131 |       if (!row) throw new Error(`rule version ${id} not found`);\n132 |       if (row.status !== \"proposed\") throw new Error(`rule version ${id} is ${row.status}, not proposed`);\n133 |       if (status === \"published\") {\n134 |         const clash = this.db\n135 |           .prepare(\"SELECT id FROM rule_versions WHERE schemeId = ? AND version = ? AND status = 'published'\")\n136 |           .get(row.schemeId, row.version);\n137 |         if (clash) throw new Error(`${row.schemeId}@${row.version} is already published`);\n138 |       }\n139 |       this.db.prepare(\"UPDATE rule_versions SET status = ?, approvedAt = ? WHERE id = ?\").run(status, now, id);\n140 |       return this.mustGet(id);\n141 |     });\n142 |   }\n143 | \n144 |   get(id: number): RuleVersionRow | undefined {\n145 |     const r = this.db.prepare(\"SELECT * FROM rule_versions WHERE id = ?\").get(id) as DbRow | undefined;\n146 |     return r ? fromDb(r) : undefined;\n147 |   }\n148 | \n149 |   private mustGet(id: number): RuleVersionRow {\n150 |     const row = this.get(id);\n151 |     if (!row) throw new Error(`rule version ${id} not found`);\n152 |     return row;\n153 |   }\n154 | \n155 |   /** Newest first, optionally for one scheme. */\n156 |   list(schemeId?: string): RuleVersionRow[] {\n157 |     const rows = schemeId\n158 |       ? this.db.prepare(\"SELECT * FROM rule_versions WHERE schemeId = ? ORDER BY createdAt DESC, id DESC\").all(schemeId)\n159 |       : this.db.prepare(\"SELECT * FROM rule_versions ORDER BY createdAt DESC, id DESC\").all();\n160 |     return (rows as unknown as DbRow[]).map(fromDb);\n161 |   }\n162 | \n163 |   /** Every published version, oldest approval first (the order to register them in). */\n164 |   publishedVersions(): RuleVersionRow[] {\n165 |     const rows = this.db.prepare(\"SELECT * FROM rule_versions WHERE status = 'published' ORDER BY approvedAt ASC, id ASC\").all();\n166 |     return (rows as unknown as DbRow[]).map(fromDb);\n167 |   }\n168 | \n169 |   close(): void {\n170 |     this.db.close();\n171 |   }\n172 | }\n173 | \n174 | /** `KAAGAZ_DB_PATH`, or `data/kaagaz.db` under the working directory (git-ignored). */\n175 | export function defaultDbPath(env: Record<string, string | undefined> = process.env): string {\n176 |   return env.KAAGAZ_DB_PATH?.trim() || join(process.cwd(), \"data\", \"kaagaz.db\");\n177 | }\n178 | \n179 | let shared: RuleStore | null = null;\n180 | \n181 | /** The app-wide store (one connection per server process). */\n182 | export function getStore(): RuleStore {\n183 |   shared ??= new RuleStore(defaultDbPath());\n184 |   return shared;\n185 | }","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\server\\rules.ts","result":"  1 | // Rule versions: validate → test → save as proposed → a person publishes or rejects.\n  2 | // All checks are code (zod schema, proposal policy, the rule engine). Writes go through store.ts only.\n  3 | // Published versions are registered in the in-memory scheme registry, so the citizen flow uses\n  4 | // them at once; syncRegistry() also picks up versions published by another server process.\n  5 | import { z } from \"zod\";\n  6 | import { applyMergePatch } from \"@/core/mergePatch\";\n  7 | import { checkRulePolicy, checkTestPolicy } from \"@/core/rulePolicy\";\n  8 | import { RuleTestCase, runRuleTests, type TestReport } from \"@/core/ruleTests\";\n  9 | import { getScheme, registerScheme } from \"@/core/schemes\";\n 10 | import { BUILTIN_REGRESSION_TESTS } from \"@/core/schemes/regression\";\n 11 | import { SchemeRule } from \"@/core/types\";\n 12 | import { getStore, type RuleStore, type RuleVersionRow } from \"./store\";\n 13 | \n 14 | export type Failure = { ok: false; errors: string[] };\n 15 | type Checked = { ok: true; rule: SchemeRule; tests: RuleTestCase[]; report: TestReport };\n 16 | const MAX_ERRORS = 25;\n 17 | \n 18 | /** \"path: message\" lines, at most MAX_ERRORS. */\n 19 | export function zodErrors(error: z.ZodError, prefix = \"\"): string[] {\n 20 |   return error.issues.slice(0, MAX_ERRORS).map((i) => {\n 21 |     const path = [prefix, ...i.path.map(String)].filter(Boolean).join(\".\");\n 22 |     return `${path || \"(root)\"}: ${i.message}`;\n 23 |   });\n 24 | }\n 25 | \n 26 | const message = (e: unknown) => (e instanceof Error ? e.message : String(e));\n 27 | \n 28 | export interface ProposalInput {\n 29 |   rule: unknown;\n 30 |   tests: unknown;\n 31 |   sourceNote: string;\n 32 |   notice: string;\n 33 |   summary: string;\n 34 | }\n 35 | \n 36 | export class RuleService {\n 37 |   constructor(\n 38 |     private readonly store: RuleStore,\n 39 |     private readonly now: () => string = () => new Date().toISOString(),\n 40 |   ) {}\n 41 | \n 42 |   /** Registers every published version that the registry does not know yet. Idempotent. */\n 43 |   syncRegistry(): void {\n 44 |     for (const row of this.store.publishedVersions()) {\n 45 |       if (!getScheme(row.schemeId, row.version)) registerScheme(row.rule);\n 46 |     }\n 47 |   }\n 48 | \n 49 |   /** The live (newest published) version of a scheme. */\n 50 |   currentRule(schemeId: string): SchemeRule | undefined {\n 51 |     this.syncRegistry();\n 52 |     return getScheme(schemeId);\n 53 |   }\n 54 | \n 55 |   /** Tests every new version must pass: the built-in ones + those of every published version. */\n 56 |   regressionTests(schemeId: string): RuleTestCase[] {\n 57 |     const published = this.store.publishedVersions().filter((r) => r.schemeId === schemeId);\n 58 |     return [...(BUILTIN_REGRESSION_TESTS[schemeId] ?? []), ...published.flatMap((r) => r.tests)];\n 59 |   }\n 60 | \n 61 |   /** A full rule, or a JSON merge patch applied to the live version of `schemeId`. */\n 62 |   candidate(input: { schemeId?: string; rule?: unknown; patch?: unknown }): { ok: true; value: unknown } | Failure {\n 63 |     if (input.rule !== undefined) return { ok: true, value: input.rule };\n 64 |     if (input.patch === undefined) return { ok: false, errors: [\"give either `rule` (a full SchemeRule) or `patch` with `schemeId`\"] };\n 65 |     const base = input.schemeId ? this.currentRule(input.schemeId) : undefined;\n 66 |     if (!base) return { ok: false, errors: [`a patch needs an existing schemeId; \"${input.schemeId ?? \"\"}\" is unknown`] };\n 67 |     return { ok: true, value: applyMergePatch(base, input.patch) };\n 68 |   }\n 69 | \n 70 |   /** zod schema + policy (version bump, provenance). */\n 71 |   validate(input: unknown, notice: string): { ok: true; rule: SchemeRule; current: SchemeRule | null } | Failure {\n 72 |     const parsed = SchemeRule.safeParse(input);\n 73 |     if (!parsed.success) return { ok: false, errors: zodErrors(parsed.error) };\n 74 |     const current = this.currentRule(parsed.data.id) ?? null;\n 75 |     const errors = checkRulePolicy({ rule: parsed.data, current, notice });\n 76 |     return errors.length ? { ok: false, errors } : { ok: true, rule: parsed.data, current };\n 77 |   }\n 78 | \n 79 |   /** Runs the new cases and every regression test of the scheme through the engine. */\n 80 |   runTests(ruleInput: unknown, testsInput: unknown): Checked | Failure {\n 81 |     const rule = SchemeRule.safeParse(ruleInput);\n 82 |     if (!rule.success) return { ok: false, errors: zodErrors(rule.error, \"rule\") };\n 83 |     const tests = z.array(RuleTestCase).max(30).safeParse(testsInput);\n 84 |     if (!tests.success) return { ok: false, errors: zodErrors(tests.error, \"tests\") };\n 85 |     const cases = [\n 86 |       ...tests.data.map((test) => ({ test, origin: \"new\" as const })),\n 87 |       ...this.regressionTests(rule.data.id).map((test) => ({ test, origin: \"regression\" as const })),\n 88 |     ];\n 89 |     return { ok: true, rule: rule.data, tests: tests.data, report: runRuleTests(rule.data, cases) };\n 90 |   }\n 91 | \n 92 |   /** Every check, in order. Used before saving and again before publishing. */\n 93 |   private check(p: Pick<ProposalInput, \"rule\" | \"tests\" | \"notice\">): Checked | Failure {\n 94 |     const valid = this.validate(p.rule, p.notice);\n 95 |     if (!valid.ok) return valid;\n 96 |     const run = this.runTests(valid.rule, p.tests);\n 97 |     if (!run.ok) return run;\n 98 |     const errors = checkTestPolicy({ newTests: run.tests, regressionTestIds: this.regressionTests(valid.rule.id).map((t) => t.id) });\n 99 |     for (const r of run.report.results.filter((x) => !x.passed)) errors.push(`test \"${r.id}\" (${r.origin}) fails: ${r.failures.join(\"; \")}`);\n100 |     return errors.length ? { ok: false, errors } : run;\n101 |   }\n102 | \n103 |   /** Stores a proposal (status `proposed`) only if it is valid and every test passes. Not live until published. */\n104 |   saveProposal(p: ProposalInput): { ok: true; row: RuleVersionRow } | Failure {\n105 |     const res = this.check(p);\n106 |     if (!res.ok) return res;\n107 |     const row = this.store.saveProposal(\n108 |       { rule: res.rule, tests: res.tests, testResult: res.report, sourceNote: p.sourceNote.slice(0, 500), notice: p.notice, summary: p.summary.slice(0, 1000) },\n109 |       this.now(),\n110 |     );\n111 |     return { ok: true, row };\n112 |   }\n113 | \n114 |   /** A person approved it: re-check (the live version may have moved on), then make it live. */\n115 |   publish(id: number): { ok: true; row: RuleVersionRow } | Failure {\n116 |     const row = this.store.get(id);\n117 |     if (!row) return { ok: false, errors: [`rule version ${id} not found`] };\n118 |     if (row.status !== \"proposed\") return { ok: false, errors: [`rule version ${id} is ${row.status}, not proposed`] };\n119 |     const res = this.check({ rule: row.rule, tests: row.tests, notice: row.notice });\n120 |     if (!res.ok) return res;\n121 |     try {\n122 |       const published = this.store.setStatus(id, \"published\", this.now());\n123 |       registerScheme(published.rule);\n124 |       return { ok: true, row: published };\n125 |     } catch (e) {\n126 |       return { ok: false, errors: [message(e)] };\n127 |     }\n128 |   }\n129 | \n130 |   reject(id: number): { ok: true; row: RuleVersionRow } | Failure {\n131 |     try {\n132 |       return { ok: true, row: this.store.setStatus(id, \"rejected\", this.now()) };\n133 |     } catch (e) {\n134 |       return { ok: false, errors: [message(e)] };\n135 |     }\n136 |   }\n137 | \n138 |   history(schemeId?: string): RuleVersionRow[] {\n139 |     return this.store.list(schemeId);\n140 |   }\n141 | \n142 |   get(id: number): RuleVersionRow | undefined {\n143 |     return this.store.get(id);\n144 |   }\n145 | }\n146 | \n147 | let shared: RuleService | null = null;\n148 | \n149 | /** The app-wide service, with published versions loaded into the registry. */\n150 | export function getRuleService(): RuleService {\n151 |   shared ??= new RuleService(getStore());\n152 |   shared.syncRegistry();\n153 |   return shared;\n154 | }\n155 | ","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\core\\schemes\\index.ts","result":" 1 | // Scheme registry: built-in rule packs plus versions registered at runtime (T3 agent). Pure, in-memory.\n 2 | // Old versions are kept; getScheme(id) returns the newest.\n 3 | import { SchemeRule, type Question, type SchemeRuleInput } from \"../types\";\n 4 | import { nsapWidow } from \"./nsap-widow\";\n 5 | import { orunodoi3 } from \"./orunodoi-3\";\n 6 | import { pmKisan } from \"./pm-kisan\";\n 7 | \n 8 | const registry = new Map<string, SchemeRule[]>();\n 9 | \n10 | /** Compares two x.y.z versions numerically: negative if a < b, 0 if equal, positive if a > b. */\n11 | export function compareVersions(a: string, b: string): number {\n12 |   const pa = a.split(\".\").map(Number);\n13 |   const pb = b.split(\".\").map(Number);\n14 |   for (let i = 0; i < 3; i++) {\n15 |     if (pa[i] !== pb[i]) return pa[i] - pb[i];\n16 |   }\n17 |   return 0;\n18 | }\n19 | \n20 | /** Validates and adds a scheme version. Throws if invalid or the same id+version exists. */\n21 | export function registerScheme(rule: SchemeRuleInput): SchemeRule {\n22 |   const parsed = SchemeRule.parse(rule);\n23 |   const versions = registry.get(parsed.id) ?? [];\n24 |   if (versions.some((v) => v.version === parsed.version)) {\n25 |     throw new Error(`scheme ${parsed.id}@${parsed.version} is already registered`);\n26 |   }\n27 |   versions.push(parsed);\n28 |   versions.sort((a, b) => compareVersions(a.version, b.version));\n29 |   registry.set(parsed.id, versions);\n30 |   return parsed;\n31 | }\n32 | \n33 | /** The newest version, or a specific one. */\n34 | export function getScheme(id: string, version?: string): SchemeRule | undefined {\n35 |   const versions = registry.get(id);\n36 |   if (!versions || versions.length === 0) return undefined;\n37 |   if (version === undefined) return versions[versions.length - 1];\n38 |   return versions.find((v) => v.version === version);\n39 | }\n40 | \n41 | /** The newest version of every scheme. */\n42 | export function listSchemes(): SchemeRule[] {\n43 |   return [...registry.values()].map((v) => v[v.length - 1]);\n44 | }\n45 | \n46 | export function listSchemeVersions(id: string): string[] {\n47 |   return (registry.get(id) ?? []).map((v) => v.version);\n48 | }\n49 | \n50 | /** Every yes/no question the user should answer for a scheme, in display order. */\n51 | export function questionsFor(scheme: SchemeRule): Question[] {\n52 |   return [\n53 |     ...scheme.requirements,\n54 |     ...scheme.eligibilityAnyOf,\n55 |     ...scheme.exclusions,\n56 |     ...scheme.nameChecks.flatMap((n) => (n.familyOwnerQuestion ? [n.familyOwnerQuestion] : [])),\n57 |   ];\n58 | }\n59 | \n60 | for (const s of [pmKisan, orunodoi3, nsapWidow]) registerScheme(s);","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\server\\ai.test.ts","result":"  1 | import { describe, expect, it, vi } from \"vitest\";\n  2 | import { type AiLogEntry, extractDocument, isAiConfigured, jsonFromReply, parseImage, replyText } from \"./ai\";\n  3 | \n  4 | // A tiny fake \"image\" (valid base64). No network: fetch is always injected.\n  5 | const IMAGE = `data:image/jpeg;base64,${Buffer.from(\"fake-image-bytes-for-tests-only\").toString(\"base64\")}`;\n  6 | const ENV = { CLINE_API_KEY: \"test-key-not-real\", CLINE_MODEL: \"anthropic/claude-sonnet-5.5\" };\n  7 | \n  8 | function reply(content: string, status = 200) {\n  9 |   return new Response(JSON.stringify({ choices: [{ message: { content } }] }), { status });\n 10 | }\n 11 | \n 12 | function setup(responses: (Response | Error)[]) {\n 13 |   const logs: AiLogEntry[] = [];\n 14 |   const fetchMock = vi.fn(async () => {\n 15 |     const next = responses.shift();\n 16 |     if (!next) throw new Error(\"no more responses\");\n 17 |     if (next instanceof Error) throw next;\n 18 |     return next;\n 19 |   });\n 20 |   return { logs, fetchMock, deps: { fetch: fetchMock as unknown as typeof fetch, env: ENV, log: (e: AiLogEntry) => logs.push(e) } };\n 21 | }\n 22 | \n 23 | describe(\"extractDocument\", () => {\n 24 |   it(\"without a key or model → ai_unavailable, and never calls the network\", async () => {\n 25 |     const { fetchMock, deps } = setup([]);\n 26 |     expect(await extractDocument(IMAGE, \"aadhaar\", { ...deps, env: {} })).toEqual({ error: \"ai_unavailable\" });\n 27 |     expect(await extractDocument(IMAGE, \"aadhaar\", { ...deps, env: { CLINE_API_KEY: \"k\" } })).toEqual({ error: \"ai_unavailable\" });\n 28 |     expect(fetchMock).not.toHaveBeenCalled();\n 29 |     expect(isAiConfigured({})).toBe(false);\n 30 |     expect(isAiConfigured(ENV)).toBe(true);\n 31 |   });\n 32 | \n 33 |   it(\"rejects something that is not an image\", async () => {\n 34 |     const { fetchMock, deps } = setup([]);\n 35 |     expect(await extractDocument(\"not base64 at all!\", undefined, deps)).toEqual({ error: \"invalid_image\" });\n 36 |     expect(fetchMock).not.toHaveBeenCalled();\n 37 |   });\n 38 | \n 39 |   it(\"parses a fenced JSON reply, masks Aadhaar to the last 4 digits, and logs no personal data\", async () => {\n 40 |     const content =\n 41 |       '```json\\n{\"docType\":\"aadhaar\",\"fields\":{\"name\":\"Ramesh Kumar Sharma\",\"dob\":\"12/03/1975\",\"aadhaarLast4\":\"1234 5678 4821\"},\"confidence\":{\"name\":0.97,\"dob\":0.6,\"aadhaarLast4\":0.99}}\\n```';\n 42 |     const { fetchMock, logs, deps } = setup([reply(content)]);\n 43 |     const r = await extractDocument(IMAGE, \"aadhaar\", deps);\n 44 |     expect(r).toEqual({\n 45 |       detectedDocType: \"aadhaar\",\n 46 |       doc: {\n 47 |         docType: \"aadhaar\",\n 48 |         fields: { name: \"Ramesh Kumar Sharma\", dob: \"1975-03-12\", aadhaarLast4: \"4821\" },\n 49 |         confidence: { name: 0.97, dob: 0.6, aadhaarLast4: 0.99 },\n 50 |       },\n 51 |     });\n 52 |     expect(fetchMock).toHaveBeenCalledTimes(1);\n 53 | \n 54 |     const [url, init] = fetchMock.mock.calls[0] as unknown as [string, RequestInit];\n 55 |     expect(url).toBe(\"https://api.cline.bot/api/v1/chat/completions\");\n 56 |     const sent = JSON.parse(String(init.body));\n 57 |     expect(sent.model).toBe(ENV.CLINE_MODEL);\n 58 |     expect(JSON.stringify(sent.messages)).toContain(\"image_url\");\n 59 | \n 60 |     expect(logs).toHaveLength(1);\n 61 |     expect(logs[0]).toMatchObject({ outcome: \"ok\", model: ENV.CLINE_MODEL, promptVersion: \"extract-doc-v1\", attempt: 1 });\n 62 |     expect(logs[0].inputHash).toMatch(/^[0-9a-f]{16}$/);\n 63 |     const logText = JSON.stringify(logs);\n 64 |     for (const secret of [\"Ramesh\", \"4821\", \"12345678\", ENV.CLINE_API_KEY]) expect(logText).not.toContain(secret);\n 65 |   });\n 66 | \n 67 |   it(\"retries once after bad output, then succeeds (Cline API { data } wrapper)\", async () => {\n 68 |     const wrapped = (content: string) => new Response(JSON.stringify({ data: { choices: [{ message: { content } }] } }));\n 69 |     const { fetchMock, logs, deps } = setup([\n 70 |       reply(\"sorry, I cannot help\"),\n 71 |       wrapped('{\"docType\":\"bank_passbook\",\"fields\":{\"name\":\"RAMESH KR SHARMA\",\"ifsc\":\"SBIN0001234\"},\"confidence\":{\"name\":0.9}}'),\n 72 |     ]);\n 73 |     const r = await extractDocument(IMAGE, \"bank_passbook\", deps);\n 74 |     expect(\"doc\" in r && r.doc.fields.name).toBe(\"RAMESH KR SHARMA\");\n 75 |     expect(fetchMock).toHaveBeenCalledTimes(2);\n 76 |     expect(logs.map((l) => l.outcome)).toEqual([\"bad_output\", \"ok\"]);\n 77 |   });\n 78 | \n 79 |   it(\"gives up after one retry with a safe fallback (HTTP error, then network error)\", async () => {\n 80 |     const { fetchMock, logs, deps } = setup([reply(\"{}\", 400), new TypeError(\"fetch failed\")]);\n 81 |     expect(await extractDocument(IMAGE, \"land_record\", deps)).toEqual({ error: \"ai_failed\" });\n 82 |     expect(fetchMock).toHaveBeenCalledTimes(2);\n 83 |     expect(logs.map((l) => l.outcome)).toEqual([\"http_error\", \"network_error\"]);\n 84 |     expect(logs[0].status).toBe(400);\n 85 |   });\n 86 | \n 87 |   it(\"falls back when the reply is valid JSON but the wrong shape\", async () => {\n 88 |     const { deps } = setup([reply('{\"fields\":\"nope\"}'), reply(\"[1,2,3]\")]);\n 89 |     expect(await extractDocument(IMAGE, undefined, deps)).toEqual({ error: \"ai_failed\" });\n 90 |   });\n 91 | });\n 92 | \n 93 | describe(\"helpers\", () => {\n 94 |   it(\"parseImage accepts data URLs and bare base64, rejects junk and huge images\", () => {\n 95 |     expect(parseImage(IMAGE)?.mime).toBe(\"image/jpeg\");\n 96 |     expect(parseImage(IMAGE.replace(\"data:image/jpeg;base64,\", \"\"))?.mime).toBe(\"image/jpeg\");\n 97 |     expect(parseImage(\"data:image/png;base64,@@@@\")).toBeNull();\n 98 |     expect(parseImage(\"A\".repeat(9 * 1024 * 1024))).toBeNull();\n 99 |   });\n100 | \n101 |   it(\"replyText reads plain OpenAI bodies and the Cline API's { data: { choices } } wrapper\", () => {\n102 |     const choices = [{ message: { content: '{\"a\":1}' } }];\n103 |     expect(replyText({ choices })).toBe('{\"a\":1}');\n104 |     expect(replyText({ data: { choices } })).toBe('{\"a\":1}');\n105 |     expect(replyText({ choices: [{ message: { content: [{ type: \"text\", text: \"x\" }, { type: \"text\", text: \"y\" }] } }] })).toBe(\"xy\");\n106 |     expect(replyText(null)).toBe(\"\");\n107 |   });\n108 | \n109 |   it(\"jsonFromReply finds the JSON object inside extra text\", () => {\n110 |     expect(jsonFromReply('Here you go: {\"a\":1} thanks')).toEqual({ a: 1 });\n111 |     expect(() => jsonFromReply(\"no json\")).toThrow();\n112 |   });\n113 | });","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\server\\adminApi.test.ts","result":"  1 | // Admin API handlers. The agent is mocked (no network); the store is a temp node:sqlite file.\n  2 | import { mkdtempSync, rmSync } from \"node:fs\";\n  3 | import { tmpdir } from \"node:os\";\n  4 | import { join } from \"node:path\";\n  5 | import { afterEach, beforeEach, describe, expect, it, vi } from \"vitest\";\n  6 | import type { RuleTestCase } from \"@/core/ruleTests\";\n  7 | import type { SchemeRule } from \"@/core/types\";\n  8 | \n  9 | const runRuleAgent = vi.fn();\n 10 | vi.mock(\"@/server/agents/ruleMaintenance\", async (orig) => ({ ...(await orig<object>()), runRuleAgent }));\n 11 | \n 12 | let dir: string;\n 13 | const previousDbPath = process.env.KAAGAZ_DB_PATH;\n 14 | \n 15 | beforeEach(() => {\n 16 |   vi.resetModules();\n 17 |   runRuleAgent.mockReset();\n 18 |   dir = mkdtempSync(join(tmpdir(), \"kaagaz-admin-\"));\n 19 |   process.env.KAAGAZ_DB_PATH = join(dir, \"admin.db\");\n 20 | });\n 21 | afterEach(async () => {\n 22 |   const { getStore } = await import(\"./store\");\n 23 |   getStore().close();\n 24 |   process.env.KAAGAZ_DB_PATH = previousDbPath;\n 25 |   rmSync(dir, { recursive: true, force: true });\n 26 | });\n 27 | \n 28 | const json = (body: unknown) => new Request(\"http://localhost/x\", { method: \"POST\", headers: { \"Content-Type\": \"application/json\" }, body: JSON.stringify(body) });\n 29 | \n 30 | async function seedProposal() {\n 31 |   const { getScheme } = await import(\"@/core/schemes\");\n 32 |   const { getRuleService } = await import(\"./rules\");\n 33 |   const rule: SchemeRule = structuredClone(getScheme(\"orunodoi-3\")!);\n 34 |   rule.version = \"2.1.0\";\n 35 |   rule.benefit.overrides = [\n 36 |     {\n 37 |       from: \"2026-10-01\",\n 38 |       to: \"2026-10-31\",\n 39 |       stateTopUp: 1500,\n 40 |       noteEn: \"One-time ₹1,500 for October 2026.\",\n 41 |       noteAs: \"অক্টোবৰ ২০২৬ৰ বাবে এবাৰৰ ₹১,৫০০।\",\n 42 |       provenance: { ...rule.benefit.provenance, sourceUrl: null, status: \"provisional\" },\n 43 |     },\n 44 |   ];\n 45 |   const tests: RuleTestCase[] = [\n 46 |     { kind: \"benefit\", id: \"oct_a\", description: \"Oct\", date: \"2026-10-01\", expect: { stateTopUp: 1500 } },\n 47 |     { kind: \"benefit\", id: \"oct_b\", description: \"Oct\", date: \"2026-10-31\", expect: { stateTopUp: 1500 } },\n 48 |     { kind: \"benefit\", id: \"nov_a\", description: \"Nov\", date: \"2026-11-01\", expect: { stateTopUp: 1250 } },\n 49 |   ];\n 50 |   const res = getRuleService().saveProposal({ rule, tests, sourceNote: \"Oct notice\", notice: \"Orunodoi October 2026\", summary: \"Oct override\" });\n 51 |   if (!res.ok) throw new Error(res.errors.join(\"; \"));\n 52 |   return res.row.id;\n 53 | }\n 54 | \n 55 | describe(\"POST /api/admin/rules/propose\", () => {\n 56 |   it(\"streams NDJSON events from the agent and ends with the result\", async () => {\n 57 |     runRuleAgent.mockImplementation(async (_notice: string, opts: { onEvent: (e: unknown) => void }) => {\n 58 |       opts.onEvent({ type: \"tool\", id: \"1\", name: \"getRuleSchema\", phase: \"started\", summary: \"Read the rule format\" });\n 59 |       const result = { ok: false, error: \"no_proposal\", message: \"none\" };\n 60 |       opts.onEvent({ type: \"done\", result });\n 61 |       return result;\n 62 |     });\n 63 |     const { POST } = await import(\"@/app/api/admin/rules/propose/route\");\n 64 |     const res = await POST(json({ notice: \"Orunodoi: October 2026 Rs. 1,500\" }));\n 65 |     expect(res.status).toBe(200);\n 66 |     expect(res.headers.get(\"content-type\")).toMatch(/application\\/x-ndjson/);\n 67 |     const lines = (await res.text()).trim().split(\"\\n\").map((l) => JSON.parse(l));\n 68 |     expect(lines.map((l) => l.type)).toEqual([\"tool\", \"done\"]);\n 69 |     expect(runRuleAgent.mock.calls[0][0]).toBe(\"Orunodoi: October 2026 Rs. 1,500\");\n 70 |   });\n 71 | \n 72 |   it(\"rejects an empty or oversized notice with 400 before running the agent\", async () => {\n 73 |     const { POST } = await import(\"@/app/api/admin/rules/propose/route\");\n 74 |     expect((await POST(json({ notice: \"  \" }))).status).toBe(400);\n 75 |     expect((await POST(json({ notice: \"x\".repeat(20_001) }))).status).toBe(400);\n 76 |     expect((await POST(new Request(\"http://localhost/x\", { method: \"POST\", body: \"{bad\" }))).status).toBe(400);\n 77 |     expect(runRuleAgent).not.toHaveBeenCalled();\n 78 |   });\n 79 | });\n 80 | \n 81 | describe(\"GET /api/admin/rules + publish / reject\", () => {\n 82 |   it(\"lists versions per scheme with diff and test results\", async () => {\n 83 |     const id = await seedProposal();\n 84 |     // The route only adds `await connection()` (needs a real Next request scope) before this handler.\n 85 |     const { handleList } = await import(\"./adminApi\");\n 86 |     const body = await (await handleList()).json();\n 87 |     const oru = body.schemes.find((s: { id: string }) => s.id === \"orunodoi-3\");\n 88 |     expect(oru.liveVersion).to