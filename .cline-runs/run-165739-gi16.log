{"ts":"2026-10-10T11:28:09.683Z","type":"agent_event","event":{"type":"content_end","contentType":"tool","toolName":"read_files","toolCallId":"toolu_012PUZhjy6wWEmnYxibKjy8N","output":[{"query":"C:\\Dev\\cline hackathon\\build\\src\\app\\api\\admin\\rules\\route.ts","result":" 1 | // GET /api/admin/rules: every scheme with its live version and version history (diff + test results).\n 2 | // Runs on Node.js: the default, and the only runtime with cacheComponents. Next 16 rejects an explicit\n 3 | // `export const runtime` when cacheComponents is on, so it is deliberately not exported here.\n 4 | import { connection } from \"next/server\";\n 5 | import { handleList } from \"@/server/adminApi\";\n 6 | \n 7 | export async function GET(): Promise<Response> {\n 8 |   await connection(); // always at request time: the history changes when someone publishes\n 9 |   return handleList();\n10 | }","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\app\\api\\admin\\rules\\propose\\route.ts","result":"1 | // POST /api/admin/rules/propose: { notice } → runs the Rule Maintenance Agent and streams its\n2 | // tool calls as NDJSON. The agent can only save a *proposed* version; a person publishes it.\n3 | // Runs on Node.js: the default, and the only runtime with cacheComponents. Next 16 rejects an explicit\n4 | // `export const runtime` when cacheComponents is on, so it is deliberately not exported here.\n5 | import { handlePropose } from \"@/server/adminApi\";\n6 | \n7 | export async function POST(req: Request): Promise<Response> {\n8 |   return handlePropose(req);\n9 | }","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\app\\api\\admin\\rules\\[id]\\publish\\route.ts","result":" 1 | // POST /api/admin/rules/:id/publish: a person approves a proposed version. It is re-checked\n 2 | // (schema, policy, all tests) and then becomes the live version at once; the old version is kept.\n 3 | // Runs on Node.js: the default, and the only runtime with cacheComponents. Next 16 rejects an explicit\n 4 | // `export const runtime` when cacheComponents is on, so it is deliberately not exported here.\n 5 | import { handleDecision } from \"@/server/adminApi\";\n 6 | \n 7 | export async function POST(_req: Request, ctx: { params: Promise<{ id: string }> }): Promise<Response> {\n 8 |   const { id } = await ctx.params;\n 9 |   return handleDecision(id, \"publish\");\n10 | }","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\app\\api\\admin\\rules\\[id]\\reject\\route.ts","result":"1 | // POST /api/admin/rules/:id/reject: a person rejects a proposed version (kept in the history).\n2 | // Runs on Node.js: the default, and the only runtime with cacheComponents. Next 16 rejects an explicit\n3 | // `export const runtime` when cacheComponents is on, so it is deliberately not exported here.\n4 | import { handleDecision } from \"@/server/adminApi\";\n5 | \n6 | export async function POST(_req: Request, ctx: { params: Promise<{ id: string }> }): Promise<Response> {\n7 |   const { id } = await ctx.params;\n8 |   return handleDecision(id, \"reject\");\n9 | }","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\server\\adminApi.ts","result":"  1 | // Handlers for the admin (rule maintainer) API. The route files are thin wrappers.\n  2 | // POST /api/admin/rules/propose streams the agent's tool calls as NDJSON (one JSON object per line).\n  3 | import { z } from \"zod\";\n  4 | import { MAX_NOTICE_CHARS } from \"@/core/notice\";\n  5 | import { getScheme, listSchemes, listSchemeVersions } from \"@/core/schemes\";\n  6 | import type { SchemeRule } from \"@/core/types\";\n  7 | import { proposalView, runRuleAgent, type AgentEvent, type ProposalView } from \"./agents/ruleMaintenance\";\n  8 | import { getRuleService } from \"./rules\";\n  9 | import type { RuleVersionRow } from \"./store\";\n 10 | \n 11 | const json = (body: unknown, status = 200) => Response.json(body, { status });\n 12 | \n 13 | export const ProposeRequest = z.object({ notice: z.string().trim().min(1).max(MAX_NOTICE_CHARS) });\n 14 | \n 15 | async function readJson(req: Request): Promise<unknown> {\n 16 |   try {\n 17 |     return JSON.parse(await req.text());\n 18 |   } catch {\n 19 |     return undefined;\n 20 |   }\n 21 | }\n 22 | \n 23 | export async function handlePropose(req: Request): Promise<Response> {\n 24 |   const body = await readJson(req);\n 25 |   if (body === undefined) return json({ error: \"invalid_json\" }, 400);\n 26 |   const parsed = ProposeRequest.safeParse(body);\n 27 |   if (!parsed.success) return json({ error: \"invalid_request\", issues: parsed.error.issues.map((i) => ({ path: i.path.join(\".\"), code: i.code })) }, 400);\n 28 | \n 29 |   const encoder = new TextEncoder();\n 30 |   const abort = new AbortController();\n 31 |   req.signal?.addEventListener(\"abort\", () => abort.abort(), { once: true });\n 32 |   const stream = new ReadableStream<Uint8Array>({\n 33 |     async start(controller) {\n 34 |       const send = (e: AgentEvent) => {\n 35 |         try {\n 36 |           controller.enqueue(encoder.encode(`${JSON.stringify(e)}\\n`));\n 37 |         } catch {\n 38 |           // The stream is closed (the client left); the run is being aborted below.\n 39 |         }\n 40 |       };\n 41 |       try {\n 42 |         await runRuleAgent(parsed.data.notice, { onEvent: send, signal: abort.signal });\n 43 |       } catch {\n 44 |         send({ type: \"done\", result: { ok: false, error: \"ai_failed\", message: \"The agent stopped unexpectedly. Nothing was published.\" } });\n 45 |       } finally {\n 46 |         controller.close();\n 47 |       }\n 48 |     },\n 49 |     cancel() {\n 50 |       abort.abort();\n 51 |     },\n 52 |   });\n 53 |   return new Response(stream, { headers: { \"Content-Type\": \"application/x-ndjson; charset=utf-8\", \"Cache-Control\": \"no-store\" } });\n 54 | }\n 55 | \n 56 | export interface SchemeHistory {\n 57 |   id: string;\n 58 |   nameEn: string;\n 59 |   liveVersion: string | null;\n 60 |   builtinVersion: string | null;\n 61 |   /** Newest first. */\n 62 |   versions: ProposalView[];\n 63 | }\n 64 | \n 65 | /**\n 66 |  * Newest first. Each row is diffed against the version that was live when it was proposed:\n 67 |  * the last version published before it, or the built-in pack (null for a brand-new scheme).\n 68 |  */\n 69 | function historyOf(builtin: SchemeRule | null, rows: RuleVersionRow[]): ProposalView[] {\n 70 |   let live = builtin;\n 71 |   const views: ProposalView[] = [];\n 72 |   for (const row of [...rows].reverse()) {\n 73 |     views.push(proposalView(row, live));\n 74 |     if (row.status === \"published\") live = row.rule;\n 75 |   }\n 76 |   return views.reverse();\n 77 | }\n 78 | \n 79 | /** The built-in (code) version of a scheme, if it has one. */\n 80 | function builtinOf(schemeId: string, rows: RuleVersionRow[]): SchemeRule | null {\n 81 |   const first = listSchemeVersions(schemeId)[0];\n 82 |   if (!first || rows.some((r) => r.version === first && r.status === \"published\")) return null;\n 83 |   return getScheme(schemeId, first) ?? null;\n 84 | }\n 85 | \n 86 | export async function handleList(): Promise<Response> {\n 87 |   return json({ schemes: schemeHistories() });\n 88 | }\n 89 | \n 90 | /** Every scheme (built-in and agent-added) with its live version and history. */\n 91 | export function schemeHistories(): SchemeHistory[] {\n 92 |   const svc = getRuleService();\n 93 |   const rows = svc.history();\n 94 |   const ids = [...new Set([...listSchemes().map((s) => s.id), ...rows.map((r) => r.schemeId)])];\n 95 |   const schemes: SchemeHistory[] = ids.map((id) => {\n 96 |     const live = getScheme(id);\n 97 |     const own = rows.filter((r) => r.schemeId === id);\n 98 |     const builtin = builtinOf(id, own);\n 99 |     return {\n100 |       id,\n101 |       nameEn: live?.nameEn ?? own[0]?.rule.nameEn ?? id,\n102 |       liveVersion: live?.version ?? null,\n103 |       builtinVersion: builtin?.version ?? null,\n104 |       versions: historyOf(builtin, own),\n105 |     };\n106 |   });\n107 |   return schemes;\n108 | }\n109 | \n110 | const Id = z.coerce.number().int().positive();\n111 | \n112 | export async function handleDecision(idParam: string, decision: \"publish\" | \"reject\"): Promise<Response> {\n113 |   const id = Id.safeParse(idParam);\n114 |   if (!id.success) return json({ error: \"invalid_id\" }, 400);\n115 |   const svc = getRuleService();\n116 |   const res = decision === \"publish\" ? svc.publish(id.data) : svc.reject(id.data);\n117 |   if (!res.ok) return json({ error: \"not_allowed\", errors: res.errors }, 409);\n118 |   return json({ row: { id: res.row.id, schemeId: res.row.schemeId, version: res.row.version, status: res.row.status, approvedAt: res.row.approvedAt } });\n119 | }","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\app\\admin\\page.tsx","result":" 1 | // /admin: the rule maintainer's page (English; helper organisations, not citizens).\n 2 | // Server component: loads the two demo notices from docs/ and the version history at request\n 3 | // time, and hands plain data to the client.\n 4 | import { readFile } from \"node:fs/promises\";\n 5 | import { join } from \"node:path\";\n 6 | import type { Metadata } from \"next\";\n 7 | import { connection } from \"next/server\";\n 8 | import { Suspense } from \"react\";\n 9 | import { noticeFromDemoFile } from \"@/core/notice\";\n10 | import { schemeHistories } from \"@/server/adminApi\";\n11 | import { AdminApp, type DemoNotice } from \"./AdminApp\";\n12 | \n13 | export const metadata: Metadata = { title: \"Rule Maintenance Agent · KaagazCheck\" };\n14 | \n15 | const DEMOS = [\n16 |   { id: \"ignoaps\", label: \"Load demo notice: Old Age Pension (new scheme)\", file: \"sample-guideline-ignoaps.md\" },\n17 |   { id: \"orunodoi\", label: \"Load demo notice: Orunodoi October 2026 (one-time ₹1,500)\", file: \"sample-notice-orunodoi-oct2026.md\" },\n18 | ];\n19 | \n20 | async function loadDemos(): Promise<DemoNotice[]> {\n21 |   const out: DemoNotice[] = [];\n22 |   for (const d of DEMOS) {\n23 |     try {\n24 |       const md = await readFile(join(process.cwd(), \"docs\", d.file), \"utf8\");\n25 |       out.push({ id: d.id, label: d.label, text: noticeFromDemoFile(md) });\n26 |     } catch {\n27 |       // A missing demo file just hides its button.\n28 |     }\n29 |   }\n30 |   return out;\n31 | }\n32 | \n33 | async function LiveAdmin() {\n34 |   await connection(); // the history changes whenever someone publishes\n35 |   const [demos, history] = await Promise.all([loadDemos(), Promise.resolve(schemeHistories())]);\n36 |   return <AdminApp demos={demos} initialHistory={history} />;\n37 | }\n38 | \n39 | export default function AdminPage() {\n40 |   return (\n41 |     <Suspense fallback={<p className=\"p-6 text-center text-zinc-600\">Loading…</p>}>\n42 |       <LiveAdmin />\n43 |     </Suspense>\n44 |   );\n45 | }","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\app\\admin\\AdminApp.tsx","result":"  1 | \"use client\";\n  2 | // The rule maintainer's flow: paste a notice → the Cline SDK agent works (live tool log) →\n  3 | // readable diff + test results → a person publishes or rejects. Version history per scheme.\n  4 | import Link from \"next/link\";\n  5 | import { useCallback, useRef, useState } from \"react\";\n  6 | import { Card, btn } from \"../_components/ui\";\n  7 | import { AgentLog, type LogLine } from \"./AgentLog\";\n  8 | import { ProposalCard, type Proposal } from \"./ProposalCard\";\n  9 | import { VersionHistory, type SchemeHistory } from \"./VersionHistory\";\n 10 | \n 11 | export interface DemoNotice {\n 12 |   id: string;\n 13 |   label: string;\n 14 |   text: string;\n 15 | }\n 16 | \n 17 | type RunResult = { ok: true; proposal: Proposal; agentText: string } | { ok: false; error: string; message: string; agentText?: string };\n 18 | type AgentEvent =\n 19 |   | { type: \"status\"; message: string }\n 20 |   | { type: \"tool\"; id: string; name: string; phase: \"started\" | \"finished\"; summary: string; isError?: boolean }\n 21 |   | { type: \"text\"; text: string }\n 22 |   | { type: \"done\"; result: RunResult };\n 23 | \n 24 | /** Reads an NDJSON response body line by line. */\n 25 | async function readNdjson(body: ReadableStream<Uint8Array>, onLine: (value: unknown) => void) {\n 26 |   const reader = body.getReader();\n 27 |   const decoder = new TextDecoder();\n 28 |   let buffer = \"\";\n 29 |   for (;;) {\n 30 |     const { value, done } = await reader.read();\n 31 |     if (done) break;\n 32 |     buffer += decoder.decode(value, { stream: true });\n 33 |     const lines = buffer.split(\"\\n\");\n 34 |     buffer = lines.pop() ?? \"\";\n 35 |     for (const line of lines) if (line.trim()) onLine(JSON.parse(line));\n 36 |   }\n 37 |   if (buffer.trim()) onLine(JSON.parse(buffer));\n 38 | }\n 39 | \n 40 | export function AdminApp({ demos, initialHistory }: { demos: DemoNotice[]; initialHistory: SchemeHistory[] }) {\n 41 |   const [notice, setNotice] = useState(\"\");\n 42 |   const [running, setRunning] = useState(false);\n 43 |   const [log, setLog] = useState<LogLine[]>([]);\n 44 |   const [agentText, setAgentText] = useState(\"\");\n 45 |   const [result, setResult] = useState<RunResult | null>(null);\n 46 |   const [history, setHistory] = useState<SchemeHistory[]>(initialHistory);\n 47 |   const [message, setMessage] = useState<{ tone: \"ok\" | \"error\"; text: string } | null>(null);\n 48 |   const abortRef = useRef<AbortController | null>(null);\n 49 | \n 50 |   const refresh = useCallback(async () => {\n 51 |     try {\n 52 |       const res = await fetch(\"/api/admin/rules\", { cache: \"no-store\" });\n 53 |       if (res.ok) setHistory(((await res.json()) as { schemes: SchemeHistory[] }).schemes);\n 54 |     } catch {\n 55 |       // The history is a convenience; the page still works without it.\n 56 |     }\n 57 |   }, []);\n 58 | \n 59 |   function onEvent(e: AgentEvent) {\n 60 |     if (e.type === \"tool\") {\n 61 |       setLog((l) => {\n 62 |         const i = e.id ? l.findIndex((x) => x.id === e.id) : -1;\n 63 |         const line: LogLine = { id: e.id || `line-${l.length}`, name: e.name, summary: e.summary, phase: e.phase, isError: e.isError };\n 64 |         if (e.phase === \"finished\" && i >= 0) return l.map((x, j) => (j === i ? { ...line, request: x.summary } : x));\n 65 |         return [...l, line];\n 66 |       });\n 67 |     } else if (e.type === \"text\") setAgentText(e.text);\n 68 |     else if (e.type === \"done\") setResult(e.result);\n 69 |   }\n 70 | \n 71 |   async function run() {\n 72 |     setRunning(true);\n 73 |     setLog([]);\n 74 |     setAgentText(\"\");\n 75 |     setResult(null);\n 76 |     setMessage(null);\n 77 |     const abort = new AbortController();\n 78 |     abortRef.current = abort;\n 79 |     try {\n 80 |       const res = await fetch(\"/api/admin/rules/propose\", {\n 81 |         method: \"POST\",\n 82 |         headers: { \"Content-Type\": \"application/json\" },\n 83 |         body: JSON.stringify({ notice }),\n 84 |         signal: abort.signal,\n 85 |       });\n 86 |       if (!res.ok || !res.body) {\n 87 |         setResult({ ok: false, error: \"request_failed\", message: `The request was refused (${res.status}).` });\n 88 |         return;\n 89 |       }\n 90 |       await readNdjson(res.body, (v) => onEvent(v as AgentEvent));\n 91 |     } catch {\n 92 |       if (!abort.signal.aborted) setResult({ ok: false, error: \"network\", message: \"The connection to the agent was lost.\" });\n 93 |     } finally {\n 94 |       setRunning(false);\n 95 |       abortRef.current = null;\n 96 |       void refresh();\n 97 |     }\n 98 |   }\n 99 | \n100 |   async function decide(id: number, decision: \"publish\" | \"reject\") {\n101 |     setMessage(null);\n102 |     try {\n103 |       const res = await fetch(`/api/admin/rules/${id}/${decision}`, { method: \"POST\" });\n104 |       const body = (await res.json()) as { row?: { schemeId: string; version: string }; errors?: string[] };\n105 |       if (!res.ok || !body.row) {\n106 |         setMessage({ tone: \"error\", text: (body.errors ?? [\"Not allowed.\"]).join(\" \") });\n107 |         return;\n108 |       }\n109 |       setMessage({\n110 |         tone: \"ok\",\n111 |         text:\n112 |           decision === \"publish\"\n113 |             ? `Published ${body.row.schemeId} ${body.row.version}. Citizens see it now; the old version is kept.`\n114 |             : `Rejected ${body.row.schemeId} ${body.row.version}. Nothing changed for citizens.`,\n115 |       });\n116 |       const status = decision === \"publish\" ? \"published\" : \"rejected\";\n117 |       setResult((r) => (r && r.ok && r.proposal.id === id ? { ...r, proposal: { ...r.proposal, status } } : r));\n118 |     } catch {\n119 |       setMessage({ tone: \"error\", text: \"Could not reach the server.\" });\n120 |     } finally {\n121 |       void refresh();\n122 |     }\n123 |   }\n124 | \n125 |   return (\n126 |     <div className=\"mx-auto flex w-full max-w-3xl flex-1 flex-col gap-5 px-4 pb-12 pt-6\" lang=\"en\">\n127 |       <header className=\"flex flex-wrap items-start justify-between gap-3\">\n128 |         <div>\n129 |           <p className=\"text-sm font-semibold uppercase tracking-wide text-teal-800\">KaagazCheck · rule maintainers</p>\n130 |           <h1 className=\"text-2xl font-bold\">Rule Maintenance Agent</h1>\n131 |           <p className=\"mt-1 text-zinc-700\">\n132 |             Paste an official notice. A Cline SDK agent proposes a rule change with sources and tests, runs it through the rule engine,\n133 |             and waits for your approval. It can only use its five tools: it cannot edit code or publish.\n134 |           </p>\n135 |         </div>\n136 |         <Link href=\"/\" className={btn.quiet}>\n137 |           ← Citizen app\n138 |         </Link>\n139 |       </header>\n140 | \n141 |       <Card>\n142 |         <label htmlFor=\"notice\" className=\"text-lg font-semibold\">\n143 |           Scheme notice\n144 |         </label>\n145 |         <div className=\"mt-2 flex flex-wrap gap-2\">\n146 |           {demos.map((d) => (\n147 |             <button key={d.id} type=\"button\" className={`${btn.secondary} text-left`} disabled={running} onClick={() => setNotice(d.text)}>\n148 |               📄 {d.label}\n149 |             </button>\n150 |           ))}\n151 |         </div>\n152 |         <textarea\n153 |           id=\"notice\"\n154 |           value={notice}\n155 |           onChange={(e) => setNotice(e.target.value)}\n156 |           rows={8}\n157 |           maxLength={20000}\n158 |           placeholder=\"Paste the text of a government notice or guideline…\"\n159 |           className=\"mt-3 w-full rounded-xl border-2 border-zinc-300 bg-white px-3 py-2 text-base focus-visible:outline-3 focus-visible:outline-teal-500\"\n160 |         />\n161 |         <div className=\"mt-3 flex flex-wrap gap-2\">\n162 |           <button type=\"button\" className={btn.primary} disabled={running || notice.trim() === \"\"} onClick={() => void run()}>\n163 |             {running ? \"⏳ Agent is working…\" : \"🤖 Propose rule change\"}\n164 |           </button>\n165 |           {running && (\n166 |             <button type=\"button\" className={btn.quiet} onClick={() => abortRef.current?.abort()}>\n167 |               Stop\n168 |             </button>\n169 |           )}\n170 |         </div>\n171 |       </Card>\n172 | \n173 |       {(running || log.length > 0) && <AgentLog lines={log} running={running} agentText={agentText} />}\n174 | \n175 |       {result && !result.ok && (\n176 |         <p role=\"alert\" className=\"rounded-xl border-l-8 border-red-700 bg-red-50 p-4 text-red-950\">\n177 |           {result.message}\n178 |         </p>\n179 |       )}\n180 |       {message && (\n181 |         <p role=\"status\" className={`rounded-xl p-3 font-medium ${message.tone === \"ok\" ? \"bg-green-50 text-green-900\" : \"bg-red-50 text-red-900\"}`}>\n182 |           {message.text}\n183 |         </p>\n184 |       )}\n185 |       {result && result.ok && <ProposalCard proposal={result.proposal} onDecide={decide} />}\n186 | \n187 |       <VersionHistory schemes={history} onDecide={decide} />\n188 |     </div>\n189 |   );\n190 | }\n191 | ","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\app\\admin\\ProposalCard.tsx","result":"  1 | // One proposed (or past) rule version: summary, readable before/after diff, test results, and\n  2 | // Publish / Reject while it is still proposed.\n  3 | import { changeLabel, formatValue } from \"@/core/ruleDiffView\";\n  4 | import { Badge, Card, btn } from \"../_components/ui\";\n  5 | \n  6 | export interface Proposal {\n  7 |   id: number;\n  8 |   schemeId: string;\n  9 |   version: string;\n 10 |   previousVersion: string | null;\n 11 |   nameEn: string;\n 12 |   status: \"proposed\" | \"published\" | \"rejected\";\n 13 |   sourceNote: string;\n 14 |   summary: string;\n 15 |   createdAt: string;\n 16 |   approvedAt: string | null;\n 17 |   changes: { path: string; kind: \"added\" | \"removed\" | \"changed\"; before?: unknown; after?: unknown }[];\n 18 |   testResult: {\n 19 |     total: number;\n 20 |     passed: number;\n 21 |     failed: number;\n 22 |     results: { id: string; description: string; origin: \"new\" | \"regression\"; passed: boolean; failures: string[] }[];\n 23 |   };\n 24 | }\n 25 | \n 26 | const STATUS_TONE = { proposed: \"amber\", published: \"green\", rejected: \"zinc\" } as const;\n 27 | const KIND_STYLE = { added: \"border-green-600 bg-green-50\", removed: \"border-red-600 bg-red-50\", changed: \"border-amber-500 bg-amber-50\" } as const;\n 28 | \n 29 | export function ProposalCard({ proposal: p, onDecide, compact = false }: { proposal: Proposal; onDecide: (id: number, d: \"publish\" | \"reject\") => void; compact?: boolean }) {\n 30 |   const newTests = p.testResult.results.filter((r) => r.origin === \"new\");\n 31 |   const regression = p.testResult.results.filter((r) => r.origin === \"regression\");\n 32 |   const allPass = p.testResult.failed === 0;\n 33 |   return (\n 34 |     <Card className={compact ? \"\" : \"border-2 border-teal-600\"}>\n 35 |       <div className=\"flex flex-wrap items-center justify-between gap-2\">\n 36 |         <h2 className=\"text-lg font-semibold\">\n 37 |           {p.nameEn} <span className=\"font-mono text-base text-zinc-600\">{p.previousVersion ? `${p.previousVersion} → ${p.version}` : `new · ${p.version}`}</span>\n 38 |         </h2>\n 39 |         <Badge tone={STATUS_TONE[p.status]}>{p.status}</Badge>\n 40 |       </div>\n 41 |       <p className=\"mt-1 text-zinc-800\">{p.summary}</p>\n 42 |       <p className=\"mt-1 text-sm text-zinc-600\">Source: {p.sourceNote}</p>\n 43 | \n 44 |       <h3 className=\"mt-4 font-semibold\">What changes ({p.changes.length})</h3>\n 45 |       <ul className=\"mt-2 flex flex-col gap-2\">\n 46 |         {p.changes.map((c) => (\n 47 |           <li key={`${c.kind}-${c.path}`} className={`rounded-xl border-l-4 px-3 py-2 text-sm ${KIND_STYLE[c.kind]}`}>\n 48 |             <p className=\"font-semibold\">\n 49 |               {c.kind === \"added\" ? \"➕\" : c.kind === \"removed\" ? \"➖\" : \"✏️\"} {changeLabel(c.path)}\n 50 |             </p>\n 51 |             {c.kind !== \"added\" && (\n 52 |               <p className=\"mt-0.5 text-zinc-700\">\n 53 |                 <span className=\"font-medium\">Before:</span> <s>{formatValue(c.before)}</s>\n 54 |               </p>\n 55 |             )}\n 56 |             {c.kind !== \"removed\" && (\n 57 |               <p className=\"mt-0.5 text-zinc-900\">\n 58 |                 <span className=\"font-medium\">After:</span> {formatValue(c.after)}\n 59 |               </p>\n 60 |             )}\n 61 |           </li>\n 62 |         ))}\n 63 |       </ul>\n 64 | \n 65 |       <h3 className=\"mt-4 font-semibold\">\n 66 |         Tests: {allPass ? \"✅\" : \"❌\"} {p.testResult.passed} passed, {p.testResult.failed} failed\n 67 |       </h3>\n 68 |       <TestList title={`New tests written by the agent (${newTests.length})`} rows={newTests} open />\n 69 |       <TestList title={`Regression tests: existing behaviour (${regression.length})`} rows={regression} open={!compact} />\n 70 | \n 71 |       {p.status === \"proposed\" && (\n 72 |         <div className=\"mt-4 flex flex-wrap gap-2\">\n 73 |           <button type=\"button\" className={btn.primary} disabled={!allPass} onClick={() => onDecide(p.id, \"publish\")}>\n 74 |             ✅ Publish {p.version}\n 75 |           </button>\n 76 |           <button type=\"button\" className={btn.secondary} onClick={() => onDecide(p.id, \"reject\")}>\n 77 |             ✖ Reject\n 78 |           </button>\n 79 |         </div>\n 80 |       )}\n 81 |       {p.approvedAt && <p className=\"mt-2 text-sm text-zinc-600\">Decided {new Date(p.approvedAt).toLocaleString()}</p>}\n 82 |     </Card>\n 83 |   );\n 84 | }\n 85 | \n 86 | function TestList({ title, rows, open }: { title: string; rows: Proposal[\"testResult\"][\"results\"]; open: boolean }) {\n 87 |   return (\n 88 |     <details className=\"mt-2\" open={open}>\n 89 |       <summary className=\"cursor-pointer text-sm font-medium text-zinc-800\">{title}</summary>\n 90 |       <ul className=\"mt-1 flex flex-col gap-1\">\n 91 |         {rows.map((r) => (\n 92 |           <li key={`${r.origin}-${r.id}`} className=\"text-sm\">\n 93 |             <span aria-label={r.passed ? \"passed\" : \"failed\"}>{r.passed ? \"✓\" : \"✗\"}</span> <code className=\"text-zinc-600\">{r.id}</code> {r.description}\n 94 |             {!r.passed && <span className=\"block pl-5 text-red-800\">{r.failures.join(\"; \")}</span>}\n 95 |           </li>\n 96 |         ))}\n 97 |       </ul>\n 98 |     </details>\n 99 |   );\n100 | }","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\server\\ai.ts","result":"  1 | // The ONLY module that calls a model (Cline API, OpenAI-compatible).\n  2 | // Structured JSON → zod → one retry → safe fallback `{ error }`. Never throws to the caller.\n  3 | // Logs model, prompt version and an input hash; never the image, the extracted text or any secret.\n  4 | // Images are processed in memory only and never stored.\n  5 | import { createHash } from \"node:crypto\";\n  6 | import { RawExtraction, toExtractedDoc } from \"@/core/extraction\";\n  7 | import { DocType as DocTypeSchema, type DocType, type ExtractedDoc } from \"@/core/types\";\n  8 | \n  9 | export const DEFAULT_BASE_URL = \"https://api.cline.bot/api/v1\";\n 10 | export const EXTRACT_PROMPT_VERSION = \"extract-doc-v1\";\n 11 | /** Decoded image size limit (the browser downsizes photos well below this). */\n 12 | export const MAX_IMAGE_BYTES = 6 * 1024 * 1024;\n 13 | const DEFAULT_TIMEOUT_MS = 45_000;\n 14 | \n 15 | export type AiError = \"ai_unavailable\" | \"ai_failed\" | \"invalid_image\";\n 16 | export type ExtractResult = { doc: ExtractedDoc; detectedDocType: DocType | null } | { error: AiError };\n 17 | \n 18 | export interface AiLogEntry {\n 19 |   fn: \"extractDocument\" | \"runToolAgent\";\n 20 |   model: string | null;\n 21 |   promptVersion: string;\n 22 |   inputHash: string | null;\n 23 |   attempt: number;\n 24 |   outcome: \"ok\" | \"unavailable\" | \"invalid_image\" | \"http_error\" | \"bad_output\" | \"network_error\" | \"run_failed\";\n 25 |   status?: number;\n 26 |   ms?: number;\n 27 |   toolCalls?: number;\n 28 | }\n 29 | \n 30 | export interface AiDeps {\n 31 |   fetch?: typeof fetch;\n 32 |   env?: Record<string, string | undefined>;\n 33 |   log?: (entry: AiLogEntry) => void;\n 34 |   timeoutMs?: number;\n 35 | }\n 36 | \n 37 | interface AiConfig {\n 38 |   apiKey: string;\n 39 |   model: string;\n 40 |   baseUrl: string;\n 41 | }\n 42 | \n 43 | function configFrom(env: Record<string, string | undefined>): AiConfig | null {\n 44 |   const apiKey = env.CLINE_API_KEY?.trim();\n 45 |   const model = env.CLINE_MODEL?.trim();\n 46 |   if (!apiKey || !model) return null;\n 47 |   return { apiKey, model, baseUrl: (env.CLINE_BASE_URL?.trim() || DEFAULT_BASE_URL).replace(/\\/+$/, \"\") };\n 48 | }\n 49 | \n 50 | /** True when a key and model are configured (does not call the model). */\n 51 | export function isAiConfigured(env: Record<string, string | undefined> = process.env): boolean {\n 52 |   return configFrom(env) !== null;\n 53 | }\n 54 | \n 55 | const defaultLog = (entry: AiLogEntry) => console.info(`[ai] ${JSON.stringify(entry)}`);\n 56 | \n 57 | const DATA_URL = /^data:(image\\/(?:jpeg|png|webp|gif|heic|heif));base64,/i;\n 58 | const BASE64 = /^[A-Za-z0-9+/]+={0,2}$/;\n 59 | \n 60 | /** Accepts a data URL or bare base64. Returns null if it is not a plausible image of allowed size. */\n 61 | export function parseImage(input: string): { mime: string; data: string } | null {\n 62 |   const m = DATA_URL.exec(input);\n 63 |   const mime = m ? m[1].toLowerCase() : \"image/jpeg\";\n 64 |   const data = (m ? input.slice(m[0].length) : input).replace(/\\s/g, \"\");\n 65 |   if (data.length < 16 || data.length % 4 !== 0 || !BASE64.test(data)) return null;\n 66 |   if ((data.length / 4) * 3 > MAX_IMAGE_BYTES) return null;\n 67 |   return { mime, data };\n 68 | }\n 69 | \n 70 | const SYSTEM_PROMPT = `You read photos of Indian government documents for a welfare-application checker.\n 71 | Return ONLY one JSON object, no other text:\n 72 | {\"docType\": string, \"fields\": {...}, \"confidence\": {...}}\n 73 | - docType: one of ${DocTypeSchema.options.join(\", \")}.\n 74 | - fields (omit any you cannot read; never guess):\n 75 |   name: the person's name exactly as printed (keep the original script and spelling);\n 76 |   dob: date of birth as YYYY-MM-DD;\n 77 |   aadhaarLast4: ONLY the last 4 digits of the Aadhaar number. Never return the full Aadhaar number;\n 78 |   accountNo: bank account number, digits only;\n 79 |   ifsc: IFSC code;\n 80 |   ownerNames: array of land owner names as printed (land records).\n 81 | - confidence: for each field you returned, a number from 0 to 1 for how sure you are of the exact text.`;\n 82 | \n 83 | function userPrompt(hint?: DocType): string {\n 84 |   return hint\n 85 |     ? `The user says this photo is a ${hint}. Read it and return the JSON.`\n 86 |     : \"Read this document photo and return the JSON.\";\n 87 | }\n 88 | \n 89 | /** Pulls the first JSON object out of the model's reply (tolerates code fences or extra words). */\n 90 | export function jsonFromReply(content: string): unknown {\n 91 |   const start = content.indexOf(\"{\");\n 92 |   const end = content.lastIndexOf(\"}\");\n 93 |   if (start < 0 || end <= start) throw new SyntaxError(\"no JSON object in reply\");\n 94 |   return JSON.parse(content.slice(start, end + 1));\n 95 | }\n 96 | \n 97 | type Completion = { choices?: { message?: { content?: unknown } }[] };\n 98 | \n 99 | /** The reply text. The Cline API wraps the OpenAI-style body in `{ data: { choices } }`; plain bodies work too. */\n100 | export function replyText(body: unknown): string {\n101 |   const b = body as (Completion & { data?: Completion }) | null;\n102 |   const content = (b?.choices ?? b?.data?.choices)?.[0]?.message?.content;\n103 |   if (typeof content === \"string\") return content;\n104 |   if (Array.isArray(content)) {\n105 |     return content.map((p: { text?: unknown }) => (typeof p?.text === \"string\" ? p.text : \"\")).join(\"\");\n106 |   }\n107 |   return \"\";\n108 | }\n109 | \n110 | /**\n111 |  * Reads one document photo → ExtractedDoc with per-field confidence (Aadhaar reduced to the last 4 digits).\n112 |  * Returns `{ error: \"ai_unavailable\" }` when no key/model is configured, so the UI falls back to manual entry.\n113 |  */\n114 | export async function extractDocument(imageBase64: string, hintDocType?: DocType, deps: AiDeps = {}): Promise<ExtractResult> {\n115 |   const log = deps.log ?? defaultLog;\n116 |   const config = configFrom(deps.env ?? process.env);\n117 |   const base = { fn: \"extractDocument\" as const, model: config?.model ?? null, promptVersion: EXTRACT_PROMPT_VERSION };\n118 | \n119 |   if (!config) {\n120 |     log({ ...base, inputHash: null, attempt: 0, outcome: \"unavailable\" });\n121 |     return { error: \"ai_unavailable\" };\n122 |   }\n123 |   const image = parseImage(imageBase64);\n124 |   if (!image) {\n125 |     log({ ...base, inputHash: null, attempt: 0, outcome: \"invalid_image\" });\n126 |     return { error: \"invalid_image\" };\n127 |   }\n128 |   const inputHash = createHash(\"sha256\").update(image.data).update(hintDocType ?? \"\").digest(\"hex\").slice(0, 16);\n129 |   const doFetch = deps.fetch ?? fetch;\n130 |   const body = JSON.stringify({\n131 |     model: config.model,\n132 |     temperature: 0,\n133 |     messages: [\n134 |       { role: \"system\", content: SYSTEM_PROMPT },\n135 |       {\n136 |         role: \"user\",\n137 |         content: [\n138 |           { type: \"text\", text: userPrompt(hintDocType) },\n139 |           { type: \"image_url\", image_url: { url: `data:${image.mime};base64,${image.data}` } },\n140 |         ],\n141 |       },\n142 |     ],\n143 |   });\n144 | \n145 |   // First attempt + one retry, then the safe fallback.\n146 |   for (let attempt = 1; attempt <= 2; attempt++) {\n147 |     const started = Date.now();\n148 |     const entry = { ...base, inputHash, attempt };\n149 |     try {\n150 |       const res = await doFetch(`${config.baseUrl}/chat/completions`, {\n151 |         method: \"POST\",\n152 |         headers: { Authorization: `Bearer ${config.apiKey}`, \"Content-Type\": \"application/json\" },\n153 |         body,\n154 |         signal: AbortSignal.timeout(deps.timeoutMs ?? DEFAULT_TIMEOUT_MS),\n155 |       });\n156 |       if (!res.ok) {\n157 |         log({ ...entry, outcome: \"http_error\", status: res.status, ms: Date.now() - started });\n158 |         continue;\n159 |       }\n160 |       const json: unknown = await res.json();\n161 |       const raw = RawExtraction.safeParse(jsonFromReply(replyText(json)));\n162 |       if (!raw.success) {\n163 |         log({ ...entry, outcome: \"bad_output\", ms: Date.now() - started });\n164 |         continue;\n165 |       }\n166 |       const result = toExtractedDoc(raw.data, hintDocType);\n167 |       log({ ...entry, outcome: \"ok\", ms: Date.now() - started });\n168 |       return result;\n169 |     } catch (e) {\n170 |       log({ ...entry, outcome: e instanceof SyntaxError ? \"bad_output\" : \"network_error\", ms: Date.now() - started });\n171 |     }\n172 |   }\n173 |   return { error: \"ai_failed\" };\n174 | }\n175 | \n176 | \n177 | // ---------- tool-using agent (Cline SDK) ----------\n178 | // The Rule Maintenance Agent runs here, so this file stays the one place that talks to a model.\n179 | // The agent can only act through the tools it is given; its free text never decides anything.\n180 | \n181 | /** The part of the `@cline/sdk` Agent we use (lets tests inject a fake). */\n182 | export interface AgentLike {\n183 |   run(input: string): Promise<{ status: string; outputText: string; iterations: number; error?: Error }>;\n184 |   subscribe(listener: (event: { type: string } & Record<string, unknown>) => void): () => void;\n185 |   abort(reason?: unknown): void;\n186 | }\n187 | \n188 | export type AgentFactory = (config: Record<string, unknown>) => AgentLike | Promise<AgentLike>;\n189 | \n190 | export interface ToolAgentDeps {\n191 |   env?: Record<string, string | undefined>;\n192 |   log?: (entry: AiLogEntry) => void;\n193 |   createAgent?: AgentFactory;\n194 |   timeoutMs?: number;\n195 | }\n196 | \n197 | export interface ToolAgentRequest {\n198 |   promptVersion: string;\n199 |   systemPrompt: string;\n200 |   input: string;\n201 |   /** Tools made with `createTool` from `@cline/sdk` (zod input schemas). */\n202 |   tools: readonly unknown[];\n203 |   maxIterations?: number;\n204 |   onEvent?: (event: { type: string } & Record<string, unknown>) => void;\n205 |   signal?: AbortSignal;\n206 |   deps?: ToolAgentDeps;\n207 | }\n208 | \n209 | export type ToolAgentResult = { status: \"completed\" | \"aborted\"; outputText: string; attempts: number } | { error: \"ai_unavailable\" | \"ai_failed\" };\n210 | \n211 | const AGENT_TIMEOUT_MS = 240_000;\n212 | \n213 | /** The real factory: `new Agent(...)` from `@cline/sdk`, loaded only when an agent actually runs. */\n214 | const sdkAgentFactory: AgentFactory = async (config) => {\n215 |   const { Agent } = await import(\"@cline/sdk\");\n216 |   return new Agent(config as unknown as ConstructorParameters<typeof Agent>[0]) as unknown as AgentLike;\n217 | };\n218 | \n219 | /**\n220 |  * Runs a Cline SDK agent with the given tools against the Cline API (OpenAI-compatible).\n221 |  * One retry if the run failed before any tool ran; then `{ error: \"ai_failed\" }`. Never throws.\n222 |  */\n223 | export async function runToolAgent(req: ToolAgentRequest): Promise<ToolAgentResult> {\n224 |   const deps = req.deps ?? {};\n225 |   const log = deps.log ?? defaultLog;\n226 |   const config = configFrom(deps.env ?? process.env);\n227 |   const inputHash = createHash(\"sha256\").update(req.input).digest(\"hex\").slice(0, 16);\n228 |   const base = { fn: \"runToolAgent\" as const, model: config?.model ?? null, promptVersion: req.promptVersion, inputHash };\n229 | \n230 |   if (!config) {\n231 |     log({ ...base, inputHash: null, attempt: 0, outcome: \"unavailable\" });\n232 |     return { error: \"ai_unavailable\" };\n233 |   }\n234 |   const createAgent = deps.createAgent ?? sdkAgentFactory;\n235 | \n236 |   for (let attempt = 1; attempt <= 2; attempt++) {\n237 |     const started = Date.now();\n238 |     let toolCalls = 0;\n239 |     let timer: ReturnType<typeof setTimeout> | undefined;\n240 |     let agent: AgentLike | undefined;\n241 |     const onAbort = () => agent?.abort(\"cancelled\");\n242 |     try {\n243 |       agent = await createAgent({\n244 |         providerId: \"openai-compatible\",\n245 |         baseUrl: config.baseUrl,\n246 |         apiKey: config.apiKey,\n247 |         modelId: config.model,\n248 |         systemPrompt: req.systemPrompt,\n249 |         tools: req.tools,\n250 |         maxIterations: req.maxIterations ?? 16,\n251 |         toolExecution: \"sequential\",\n252 |       });\n253 |       agent.subscribe((event) => {\n254 |         if (event.type === \"tool-finished\") toolCalls++;\n255 |         req.onEvent?.(event);\n256 |       });\n257 |       req.signal?.addEventListener(\"abort\", onAbort, { once: true });\n258 |       timer = setTimeout(() => agent?.abort(\"timeout\"), deps.timeoutMs ?? AGENT_TIMEOUT_MS);\n259 |       const result = await agent.run(req.input);\n260 |       const ms = Date.now() - started;\n261 |       if (result.status === \"completed\" || result.status === \"aborted\") {\n262 |         log({ ...base, attempt, outcome: result.status === \"completed\" ? \"ok\" : \"run_failed\", ms, toolCalls });\n263 |         return { status: result.status, outputText: result.outputText, attempts: attempt };\n264 |       }\n265 |       log({ ...base, attempt, outcome: \"run_failed\", ms, toolCalls });\n266 |     } catch {\n267 |       log({ ...base, attempt, outcome: \"network_error\", ms: Date.now() - started, toolCalls });\n268 |     } finally {\n269 |       if (timer) clearTimeout(timer);\n270 |       req.signal?.removeEventListener(\"abort\", onAbort);\n271 |     }\n272 |     // Retry only if nothing happened yet: a second run after tool calls could repeat side effects.\n273 |     if (toolCalls > 0 || req.signal?.aborted) break;\n274 |   }\n275 |   return { error: \"ai_failed\" };\n276 | }\n277 | ","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\core\\rejectionCodes.ts","result":"  1 | // Known rejection reasons → fix steps (English + Assamese). Pure.\n  2 | // Used by the rejection decoder (T4): the AI only maps notice text to a code; these steps are fixed.\n  3 | import { z } from \"zod\";\n  4 | import type { FixWhere } from \"./types\";\n  5 | \n  6 | export const REJECTION_CODES = [\n  7 |   \"NAME_MISMATCH_AADHAAR\",\n  8 |   \"AADHAAR_NOT_SEEDED_BANK\",\n  9 |   \"INVALID_ACCOUNT_IFSC\",\n 10 |   \"ACCOUNT_INACTIVE\",\n 11 |   \"LAND_NOT_VERIFIED\",\n 12 |   \"EKYC_PENDING\",\n 13 |   \"PENDING_STATE_ACTION\",\n 14 |   \"UNKNOWN\",\n 15 | ] as const;\n 16 | \n 17 | export const RejectionCode = z.enum(REJECTION_CODES);\n 18 | export type RejectionCode = z.infer<typeof RejectionCode>;\n 19 | \n 20 | export interface FixSteps {\n 21 |   code: RejectionCode;\n 22 |   titleEn: string;\n 23 |   titleAs: string;\n 24 |   stepsEn: string[];\n 25 |   stepsAs: string[];\n 26 |   fixWhere: FixWhere;\n 27 | }\n 28 | \n 29 | const FIXES: Record<RejectionCode, Omit<FixSteps, \"code\">> = {\n 30 |   NAME_MISMATCH_AADHAAR: {\n 31 |     titleEn: \"Your name does not match your Aadhaar\",\n 32 |     titleAs: \"আপোনাৰ নাম আধাৰৰ সৈতে মিল নাই\",\n 33 |     stepsEn: [\n 34 |       \"Compare the name on your Aadhaar, bank passbook and application letter by letter.\",\n 35 |       \"Ask your bank branch to correct the account name to match Aadhaar exactly (or update Aadhaar at an Aadhaar centre if Aadhaar is wrong).\",\n 36 |       \"Then ask for the name to be corrected in the scheme record (CSC or scheme office).\",\n 37 |     ],\n 38 |     stepsAs: [\n 39 |       \"আধাৰ, বেংক পাছবুক আৰু আবেদনত থকা নামটো আখৰে আখৰে মিলাই চাওক।\",\n 40 |       \"আধাৰৰ সৈতে হুবহু মিলাবলৈ বেংকৰ শাখাত একাউণ্টৰ নাম শুধৰাবলৈ কওক (আধাৰ ভুল হ'লে আধাৰ কেন্দ্ৰত আধাৰ আপডেট কৰক)।\",\n 41 |       \"তাৰ পিছত আঁচনিৰ নথিত নামটো শুধৰাবলৈ কওক (CSC বা আঁচনিৰ কাৰ্যালয়ত)।\",\n 42 |     ],\n 43 |     fixWhere: \"bank\",\n 44 |   },\n 45 |   AADHAAR_NOT_SEEDED_BANK: {\n 46 |     titleEn: \"Aadhaar is not linked (seeded) to your bank account\",\n 47 |     titleAs: \"আপোনাৰ বেংক একাউণ্টত আধাৰ সংযোগ (ছিডিং) হোৱা নাই\",\n 48 |    