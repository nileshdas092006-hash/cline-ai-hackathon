  docType: \"land_record\",\r\n  fields: { ownerNames: [owner], ...extra },\r\n  confidence: {},\r\n17: const widow = scheme(\"nsap-widow\");\r\n196: // ---------- Widow pension ----------\r\n197: const widowDocs = (dob: string, withDeathCert = true): ExtractedDoc[] => [\r\n205: const widowYes: Answers = { is_widow: true, bpl_household: true };\r\n207: describe(\"evaluate: widow pension (IGNWPS)\", () => {\r\n209: const r = evaluate(widow, widowDocs(\"1986-10-11\"), widowYes, AS_OF);\r\n214: const r = evaluate(widow, widowDocs(\"1986-10-10\"), widowYes, AS_OF);\r\n220: expect(evaluate(widow, widowDocs(\"1946-10-11\"), widowYes, AS_OF).eligibility).toBe(\"likely_eligible\");\r\n223: const r = evaluate(widow, widowDocs(\"1946-10-10\"), widowYes, AS_OF);\r\n228: expect(evaluate(widow, widowDocs(\"1986-10-10\"), widowYes, \"2026-10-09\").eligibility).toBe(\"not_eligible\");\r\n231: const r = evaluate(widow, widowDocs(\"1970-01-01\"), widowYes, AS_OF);\r\n237: expect(evaluate(widow, widowDocs(\"1970-01-01\"), { ...widowYes, bpl_household: false }, AS_OF).eligibility).toBe(\"not_eligible\");\r\n      v.stateTopUp !== undefined && `state ${v.stateTopUp === null ? \"unconfirmed\" : `â‚¹${String(v.stateTopUp)}`}`,\r\n      typeof v.noteEn === \"string\" && `\"${v.noteEn}\"`,\r\n      source(v.provenance),\r\n    );\r\n  }\r\n  if (\"min\" in v && \"max\" in v) return join(`${String(v.min)}â€“${String(v.max)} years (date of birth from ${String(v.dobFrom)})`, source(v.provenance));\r\n  if (\"textEn\" in v) return join(`\"${String(v.textEn)}\"`, source(v.provenance));\r\n  if (\"docType\" in v) return join(`${String(v.docType)}${v.fixWhere ? ` (from ${String(v.fixWhere)})` : \"\"}`, source(v.provenance));\r\n  if (\"status\" in v && \"sourceTitle\" in v) return join(source(v), typeof v.clause === \"string\" && `\"${v.clause}\"`, typeof v.sourceUrl === \"string\" && v.sourceUrl);\r\n  if (\"labelEn\" in v) return join(String(v.labelEn), source(v.provenance));\r\n","success":tru