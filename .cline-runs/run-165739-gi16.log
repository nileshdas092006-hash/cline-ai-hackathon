   expect(f.titleEn.length).toBeGreaterThan(3);\n27 |     expect(ASSAMESE.test(f.titleAs)).toBe(true);\n28 |     expect(f.stepsEn.length).toBeGreaterThan(0);\n29 |     expect(f.stepsAs.length).toBe(f.stepsEn.length);\n30 |     for (const s of f.stepsAs) expect(ASSAMESE.test(s)).toBe(true);\n31 |   });\n32 | \n33 |   it(\"points name mismatches to the bank or Aadhaar centre and land to the circle office\", () => {\n34 |     expect(fixStepsFor(\"NAME_MISMATCH_AADHAAR\").fixWhere).toBe(\"bank\");\n35 |     expect(fixStepsFor(\"LAND_NOT_VERIFIED\").fixWhere).toBe(\"circle_office\");\n36 |     expect(fixStepsFor(\"EKYC_PENDING\").fixWhere).toBe(\"pm_kisan_portal\");\n37 |   });\n38 | });","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\app\\page.tsx","result":" 1 | // Server component: builds the scheme catalog from the registry and hands plain data to the client flow.\n 2 | // The catalog is read at request time (not prerendered), so a rule version published in /admin\n 3 | // shows up for citizens at once.\n 4 | import { connection } from \"next/server\";\n 5 | import { Suspense } from \"react\";\n 6 | import { catalogOf } from \"@/core/catalog\";\n 7 | import { SAMPLES } from \"@/core/samples\";\n 8 | import { listSchemes } from \"@/core/schemes\";\n 9 | import { getRuleService } from \"@/server/rules\";\n10 | import { KaagazApp } from \"./_components/KaagazApp\";\n11 | \n12 | async function LiveApp() {\n13 |   await connection();\n14 |   getRuleService().syncRegistry();\n15 |   return <KaagazApp catalog={catalogOf(listSchemes())} samples={Object.values(SAMPLES)} />;\n16 | }\n17 | \n18 | export default function Home() {\n19 |   return (\n20 |     <Suspense fallback={<p className=\"p-6 text-center text-zinc-600\">…</p>}>\n21 |       <LiveApp />\n22 |     </Suspense>\n23 |   );\n24 | }","success":true}],"durationMs":5}}
