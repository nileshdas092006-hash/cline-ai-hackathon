+requestId.current;\n 88 |     setStep(\"report\");\n 89 |     setReportState({ status: \"loading\" });\n 90 |     try {\n 91 |       const res = await fetch(\"/api/check\", {\n 92 |         method: \"POST\",\n 93 |         headers: { \"Content-Type\": \"application/json\" },\n 94 |         body: JSON.stringify({\n 95 |           schemeId: scheme.id,\n 96 |           schemeVersion: scheme.version,\n 97 |           // An empty typed-in document does not count, so the engine reports it as missing.\n 98 |           docs: countedDocs(docs),\n 99 |           answers: relevantAnswers(scheme.questions, answers),\n100 |         }),\n101 |       });\n102 |       const parsed = Report.safeParse(await res.json());\n103 |       if (id !== requestId.current) return;\n104 |       setReportState(res.ok && parsed.success ? { status: \"done\", report: parsed.data } : { status: \"error\" });\n105 |     } catch {\n106 |       if (id === requestId.current) setReportState({ status: \"error\" });\n107 |     }\n108 |   }\n109 | \n110 |   const titles: Record<Step, string> = {\n111 |     scheme: t.scheme.title,\n112 |     docs: t.docs.title,\n113 |     confirm: t.confirm.title,\n114 |     questions: t.questions.title,\n115 |     report: scheme ? (lang === \"as\" ? scheme.nameAs : scheme.nameEn) : \"\",\n116 |   };\n117 |   const backTo = BACK[step];\n118 |   const report = reportState.status === \"done\" ? reportState.report : null;\n119 | \n120 |   return (\n121 |     <>\n122 |       <div className=\"mx-auto flex w-full max-w-xl flex-1 flex-col gap-4 px-4 pb-10 pt-4 print:hidden\">\n123 |         <header className=\"flex items-start justify-between gap-3\">\n124 |           <div>\n125 |             <p className=\"text-xl font-bold leading-tight\">\n126 |               <span lang=\"en\">{APP_NAME}</span> · {APP_NAME_AS}\n127 |             </p>\n128 |             <p className=\"text-sm text-zinc-600\">{lang === \"as\" ? APP_TAGLINE_AS : APP_TAGLINE_EN}</p>\n129 |           </div>\n130 |           <button\n131 |             type=\"button\"\n132 |             className={btn.secondary}\n133 |             onClick={() => setLang(lang === \"as\" ? \"en\" : \"as\")}\n134 |             aria-label={t.langToggleAria}\n135 |             lang={lang === \"as\" ? \"en\" : \"as\"}\n136 |           >\n137 |             {t.langToggle}\n138 |           </button>\n139 |         </header>\n140 | \n141 |         <div>\n142 |           <p className=\"text-sm font-medium text-zinc-600\">{t.stepOf(stepNo, STEPS.length)}</p>\n143 |           <div className=\"mt-1 h-2 rounded-full bg-zinc-200\" aria-hidden=\"true\">\n144 |             <div className=\"h-2 rounded-full bg-teal-600 transition-all\" style={{ width: `${(stepNo / STEPS.length) * 100}%` }} />\n145 |           </div>\n146 |         </div>\n147 | \n148 |         {sampleId && <DemoLabel text={`${t.demoMode} (${sampleId})`} />}\n149 | \n150 |         <main className=\"flex flex-col gap-4\">\n151 |           <h1 ref={headingRef} tabIndex={-1} className=\"text-2xl font-bold leading-snug outline-none\">\n152 |             {titles[step]}\n153 |           </h1>\n154 | \n155 |           {step === \"scheme\" && <SchemeStep lang={lang} catalog={catalog} selected={schemeId} onChoose={chooseScheme} />}\n156 |           {step === \"docs\" && scheme && (\n157 |             <DocsStep\n158 |               lang={lang}\n159 |               scheme={scheme}\n160 |               docs={docs}\n161 |               samples={samples.filter((s) => s.schemeId === scheme.id)}\n162 |               aiOff={aiOff}\n163 |               onAiOff={() => setAiOff(true)}\n164 |               onDocs={setDocs}\n165 |               onSample={chooseSample}\n166 |               onNext={() => setStep(\"confirm\")}\n167 |             />\n168 |           )}\n169 |           {step === \"confirm\" && scheme && (\n170 |             <ConfirmStep lang={lang} docs={docs} onDocs={setDocs} onNext={() => setStep(\"questions\")} />\n171 |           )}\n172 |           {step === \"questions\" && scheme && (\n173 |             <QuestionsStep lang={lang} questions={scheme.questions} answers={answers} onAnswers={setAnswers} onNext={runCheck} />\n174 |           )}\n175 |           {step === \"report\" && scheme && (\n176 |             <ReportStep lang={lang} scheme={scheme} state={reportState} onRetry={runCheck} onStartOver={startOver} />\n177 |           )}\n178 | \n179 |           {backTo && (\n180 |             <button type=\"button\" className={`${btn.quiet} self-start`} onClick={() => setStep(backTo)}>\n181 |               ← {t.back}\n182 |             </button>\n183 |           )}\n184 |         </main>\n185 |       </div>\n186 |       {report && scheme && <CoverSheet lang={lang} scheme={scheme} report={report} docs={countedDocs(docs)} sampleId={sampleId} />}\n187 |     </>\n188 |   );\n189 | }\n190 | ","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\app\\_components\\ReportStep.tsx","result":"  1 | \"use client\";\n  2 | import type { SchemeView } from \"@/core/catalog\";\n  3 | import { sectionsOf, toneOf } from \"@/core/reportView\";\n  4 | import type { Report } from \"@/core/types\";\n  5 | import { STRINGS, pick, type Lang } from \"@/i18n\";\n  6 | import { BenefitCard } from \"./BenefitCard\";\n  7 | import { CheckItem } from \"./CheckItem\";\n  8 | import { Badge, Card, VerdictBanner, btn } from \"./ui\";\n  9 | \n 10 | export type ReportState = { status: \"idle\" } | { status: \"loading\" } | { status: \"error\" } | { status: \"done\"; report: Report };\n 11 | \n 12 | export function ReportStep({\n 13 |   lang,\n 14 |   scheme,\n 15 |   state,\n 16 |   onRetry,\n 17 |   onStartOver,\n 18 | }: {\n 19 |   lang: Lang;\n 20 |   scheme: SchemeView;\n 21 |   state: ReportState;\n 22 |   onRetry: () => void;\n 23 |   onStartOver: () => void;\n 24 | }) {\n 25 |   const t = STRINGS[lang].report;\n 26 |   if (state.status === \"error\") {\n 27 |     return (\n 28 |       <div role=\"alert\" className=\"flex flex-col g