confirmLocally: \"ৰাজ্যৰ অতিৰিক্ত ধন: স্থানীয়ভাৱে নিশ্চিত কৰক\",\n215 |     total: \"মুঠ\",\n216 |     perMonth: \"প্ৰতি মাহে\",\n217 |     perYear: \"প্ৰতি বছৰে\",\n218 |     instalments: (n: number) => `${n}টা কিস্তিত`,\n219 |     supportingTitle: \"সহায়ক নথি (সাধাৰণতে বিচৰা হয়)\",\n220 |     present: \"যোগ কৰা হৈছে\",\n221 |     absent: \"যোগ কৰা হোৱা নাই\",\n222 |     asOf: (d: string) => `${d} তাৰিখৰ নিয়ম অনুসৰি`,\n223 |     ruleVersion: (v: string) => `নিয়মৰ সংস্কৰণ v${v}`,\n224 |     print: \"কভাৰ শ্বীট প্ৰিণ্ট কৰক\",\n225 |     coverTitle: \"আবেদনৰ কভাৰ শ্বীট\",\n226 |     coverDocs: \"যোগ কৰা নথি\",\n227 |   },\n228 | };\n229 | \n230 | export const STRINGS: Record<Lang, Strings> = { as, en };\n231 | \n232 | export function pick(lang: Lang, enText: string, asText: string): string {\n233 |   return lang === \"as\" ? asText : enText;\n234 | }\n235 | \n236 | /** Document name as a title, e.g. \"Bank passbook\" / \"বেংক পাছবুক\". */\n237 | export function docTitle(lang: Lang, docType: DocType): string {\n238 |   const l = DOC_LABELS[docType];\n239 |   return lang === \"as\" ? l.as : l.en.charAt(0).toUpperCase() + l.en.slice(1);\n240 | }\n241 | \n242 | export function fixWhereLabel(lang: Lang, where: FixWhere): string {\n243 |   const l = FIX_WHERE_LABELS[where];\n244 |   return lang === \"as\" ? l.as : l.en;\n245 | }\n246 | ","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\core\\reportView.ts","result":" 1 | // Pure view-model helpers for the report screen: grouping, colours and money formatting.\n 2 | // Grouping only re-arranges the engine's checks; it never changes a result.\n 3 | import type { BenefitOn, Check, Eligibility, Readiness } from \"./types\";\n 4 | \n 5 | export type Tone = \"green\" | \"red\" | \"yellow\" | \"grey\";\n 6 | \n 7 | export const TONE_EMOJI: Record<Tone, string> = { green: \"🟢\", red: \"🔴\", yellow: \"🟡\", grey: \"⚪\" };\n 8 | \n 9 | export function toneOf(verdict: Eligibility | Readiness): Tone {\n10 |   switch (verdict) {\n11 |     case \"likely_eligible\":\n12 |     case \"ready_for_review\":\n13 |       return \"green\";\n14 |     case \"not_eligible\":\n15 |     case \"action_required\":\n16 |       return \"red\";\n17 |     case \"needs_verification\":\n18 |       return \"yellow\";\n19 |   }\n20 | }\n21 | \n22 | export interface ReportSections {\n23 |   /** action_required: fix these before applying. */\n24 |   fix: Check[];\n25 |   /** needs_verification: details first, then facts to confirm at the bank/office (external). */\n26 |   verify: Check[];\n27 |   /** The external checks (also inside `verify`), for the \"confirm at the bank\" list. */\n28 |   external: Check[];\n29 |   /** ok and not_applicable. */\n30 |   ok: Check[];\n31 | }\n32 | \n33 | export function sectionsOf(report: { checks: readonly Check[] }): ReportSections {\n34 |   const checks = report.checks;\n35 |   const external = checks.filter((c) => c.kind === \"external\" && c.result === \"needs_verification\");\n36 |   return {\n37 |     fix: checks.filter((c) => c.result === \"action_required\"),\n38 |     verify: [...checks.filter((c) => c.result === \"needs_verification\" && c.kind !== \"external\"), ...external],\n39 |     external,\n40 |     ok: checks.filter((c) => c.result === \"ok\" || c.result === \"not_applicable\"),\n41 |   };\n42 | }\n43 | \n44 | /** Indian digit grouping: 125000 → \"₹1,25,000\". Rounds to whole rupees. */\n45 | export function formatInr(amount: number): string {\n46 |   const neg = amount < 0;\n47 |   const digits = String(Math.round(Math.abs(amount)));\n48 |   const last3 = digits.slice(-3);\n49 |   const rest = digits.slice(0, -3);\n50 |   const grouped = rest === \"\" ? last3 : `${rest.replace(/\\B(?=(\\d{2})+(?!\\d))/g, \",\")},${last3}`;\n51 |   return `${neg ? \"-\" : \"\"}₹${grouped}`;\n52 | }\n53 | \n54 | export interface BenefitView {\n55 |   central: string;\n56 |   /** null = unconfirmed (\"confirm locally\"). */\n57 |   stateTopUp: string | null;\n58 |   /** null whenever the state top-up is unconfirmed. */\n59 |   total: string | null;\n60 |   period: BenefitOn[\"period\"];\n61 |   instalments?: number;\n62 |   isOverride: boolean;\n63 |   noteEn?: string;\n64 |   noteAs?: string;\n65 | }\n66 | \n67 | export function benefitView(b: BenefitOn): BenefitView {\n68 |   return {\n69 |     central: formatInr(b.centralShare),\n70 |     stateTopUp: b.stateTopUp === null ? null : formatInr(b.stateTopUp),\n71 |     total: b.total === null ? null : formatInr(b.total),\n72 |     period: b.period,\n73 |     ...(b.instalments !== undefined ? { instalments: b.instalments } : {}),\n74 |     isOverride: b.isOverride,\n75 |     ...(b.noteEn ? { noteEn: b.noteEn } : {}),\n76 |     ...(b.noteAs ? { noteAs: b.noteAs } : {}),\n77 |   };\n78 | }","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\core\\aadhaar.ts","result":"1 | // Aadhaar masking: only the last 4 digits are ever shown. Pure.\n2 | \n3 | /** \"1234 5678 9012\" → \"XXXX XXXX 9012\". Fewer than 4 digits → no digits at all. */\n4 | export function maskAadhaar(input: string): string {\n5 |   const digits = input.replace(/\\D/g, \"\");\n6 |   if (digits.length < 4) return \"XXXX XXXX XXXX\";\n7 |   return `XXXX XXXX ${digits.slice(-4)}`;\n8 | }","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\i18n.test.ts","result":" 1 | import { describe, expect, it } from \"vitest\";\n 2 | import { DEFAULT_LANG, STRINGS, docTitle, fixWhereLabel, pick } from \"./i18n\";\n 3 | \n 4 | function leaves(obj: unknown, path = \"\"): [string, unknown][] {\n 5 |   if (obj && typeof obj === \"object\") {\n 6 |     return Object.entries(obj as Record<string, unknown>).flatMap(([k, v]) => leaves(v, path ? `${path}.${k}` : k));\n 7 |   }\n 8 |   return [[path, obj]];\n 9 | }\n10 | \n11 | describe(\"i18n\", () => {\n12 |   it(\"defaults to Assamese\", () => {\n13 |     expect(DEFAULT_LANG).toBe(\"as\");\n14 |   });\n15 | \n16 |   it(\"has the same keys and value types in Assamese and English\", () => {\n17 |     const en = new Map(leaves(STRINGS.en));\n18 |     const as = new Map(leaves(STRINGS.as));\n19 |     expect([...as.keys()].sort()).toEqual([...en.keys()].sort());\n20 |     for (const [k, v] of en) expect(typeof as.get(k), k).toBe(typeof v);\n21 |   });\n22 | \n23 |   it(\"has no empty strings, and functions return text\", () => {\n24 |     for (const lang of [\"as\", \"en\"] as const) {\n25 |       for (const [k, v] of leaves(STRINGS[lang])) {\n26 |         const text = typeof v === \"function\" ? (v as (...a: unknown[]) => string)(2, \"x\") : v;\n27 |         expect(typeof text, `${lang}.${k}`).toBe(\"string\");\n28 |         expect((text as string).trim().length, `${lang}.${k}`).toBeGreaterThan(0);\n29 |       }\n30 |     }\n31 |   });\n32 | \n33 |   it(\"Assamese strings use ৰ (U+09F0), never Bengali র (U+09B0)\", () => {\n34 |     for (const [k, v] of leaves(STRINGS.as)) {\n35 |       const text = typeof v === \"function\" ? (v as (...a: unknown[]) => string)(2, \"x\") : String(v);\n36 |       expect(text.includes(\"\\u09B0\"), k).toBe(false);\n37 |     }\n38 |   });\n39 | \n40 |   it(\"reuses the engine labels for documents and places\", () => {\n41 |     expect(docTitle(\"en\", \"bank_passbook\")).toBe(\"Bank passbook\");\n42 |     expect(docTitle(\"as\", \"aadhaar\")).toBe(\"আধাৰ কাৰ্ড\");\n43 |     expect(fixWhereLabel(\"en\", \"bank\")).toBe(\"your bank branch\");\n44 |     expect(pick(\"as\", \"hello\", \"নমস্কাৰ\")).toBe(\"নমস্কাৰ\");\n45 |     expect(pick(\"en\", \"hello\", \"নমস্কাৰ\")).toBe(\"hello\");\n46 |   });\n47 | });","success":true}],"durationMs":5}}
