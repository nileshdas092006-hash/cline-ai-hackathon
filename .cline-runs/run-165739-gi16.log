).toEqual([]);\n63 |   });\n64 | \n65 |   it(\"only one published row per scheme + version\", () => {\n66 |     const a = store.saveProposal(proposal(\"2.1.0\"), \"2026-10-10T10:00:00.000Z\");\n67 |     const b = store.saveProposal(proposal(\"2.1.0\"), \"2026-10-10T10:01:00.000Z\");\n68 |     store.setStatus(a.id, \"published\", \"2026-10-10T10:02:00.000Z\");\n69 |     expect(() => store.setStatus(b.id, \"published\", \"2026-10-10T10:03:00.000Z\")).toThrow(/already published/);\n70 |     expect(store.get(b.id)?.status).toBe(\"proposed\"); // the failed publish was rolled back\n71 |   });\n72 | \n73 |   it(\"lists newest first, optionally by scheme; unknown id → undefined\", () => {\n74 |     store.saveProposal(proposal(\"2.1.0\"), \"2026-10-10T10:00:00.000Z\");\n75 |     store.saveProposal({ ...proposal(\"1.0.0\"), rule: { ...getScheme(\"nsap-widow\")!, id: \"nsap-old-age\", version: \"1.0.0\" } }, \"2026-10-10T11:00:00.000Z\");\n76 |     expect(store.list().map((r) => r.schemeId)).toEqual([\"nsap-old-age\", \"orunodoi-3\"]);\n77 |     expect(store.list(\"orunodoi-3\")).toHaveLength(1);\n78 |     expect(store.get(999)).toBeUndefined();\n79 |   });\n80 | \n81 |   it(\"persists across connections\", () => {\n82 |     const { id } = store.saveProposal(proposal(\"2.1.0\"), \"2026-10-10T10:00:00.000Z\");\n83 |     store.setStatus(id, \"published\", \"2026-10-10T10:05:00.000Z\");\n84 |     store.close();\n85 |     store = new RuleStore(join(dir, \"rules.db\"));\n86 |     expect(store.publishedVersions()).toHaveLength(1);\n87 |   });\n88 | });","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\tsconfig.json","result":" 1 | {\n 2 |   \"compilerOptions\": {\n 3 |     \"target\": \"ES2017\",\n 4 |     \"lib\": [\"dom\", \"dom.iterable\", \"esnext\"],\n 5 |     \"allowJs\": true,\n 6 |     \"skipLibCheck\": true,\n 7 |     \"strict\": true,\n 8 |     \"noEmit\": true,\n 9 |     \"esModuleInterop\": true,\n10 |     \"module\": \"esnext\",\n11 |     \"moduleResolution\"