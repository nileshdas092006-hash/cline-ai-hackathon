de = z\n185 |   .object({\n186 |     from: IsoDate,\n187 |     to: IsoDate,\n188 |     centralShare: z.number().nonnegative().optional(),\n189 |     stateTopUp: z.number().nonnegative().nullable().optional(),\n190 |     noteEn: z.string().min(1),\n191 |     noteAs: z.string().min(1),\n192 |     provenance: RuleProvenance,\n193 |   })\n194 |   .refine((o) => o.from <= o.to, { message: \"override 'to' must not be before 'from'\", path: [\"to\"] });\n195 | export type BenefitOverride = z.infer<typeof BenefitOverride>;\n196 | \n197 | export const Benefit = z.object({\n198 |   centralShare: z.number().nonnegative(),\n199 |   /** null = unconfirmed; never show a total then. */\n200 |   stateTopUp: z.number().nonnegative().nullable(),\n201 |   period: z.enum([\"month\", \"year\"]),\n202 |   instalments: z.int().positive().optional(),\n203 |   effectiveDate: IsoDate.nullable().optional(),\n204 |   provenance: RuleProvenance,\n205 |   /** Time-bounded changes (e.g. a one-time payment for one month). Later entries win. */\n206 |   overrides: z.array(BenefitOverride).default([]),\n207 | });\n208 | export type Benefit = z.infer<typeof Benefit>;\n209 | \n210 | export const SchemeNote = z.object({\n211 |   id: z.string().regex(SNAKE_ID),\n212 |   textEn: z.string().min(1),\n213 |   textAs: z.string().min(1),\n214 |   provenance: RuleProvenance,\n215 | });\n216 | export type SchemeNote = z.infer<typeof SchemeNote>;\n217 | \n218 | // ---------- scheme rule pack ----------\n219 | export const SchemeRule = z.object({\n220 |   id: z.string().regex(SCHEME_ID),\n221 |   version: z.string().regex(SEMVER),\n222 |   nameEn: z.string().min(1),\n223 |   nameAs: z.string().min(1),\n224 |   /** Default place to confirm provisional rules. */\n225 |   confirmAt: FixWhere,\n226 |   benefit: Benefit,\n227 |   mandatoryDocs: z.array(DocRequirement),\n228 |   supportingDocs: z.array(DocRequirement).default([]),\n229 |   supportingDocsNoteEn: z.string().nullable().default(null),\n230 |   supportingDo