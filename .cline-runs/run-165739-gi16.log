ullable().optional(),\n 22 |     verifiedOn: IsoDate,\n 23 |     version: z.string().regex(SEMVER),\n 24 |     status: RuleStatus,\n 25 |   })\n 26 |   // A rule can only be \"verified\" if we can point to its source.\n 27 |   .refine((p) => p.status === \"provisional\" || p.sourceUrl !== null, {\n 28 |     message: \"a verified rule needs a sourceUrl\",\n 29 |     path: [\"sourceUrl\"],\n 30 |   });\n 31 | export type RuleProvenance = z.infer<typeof RuleProvenance>;\n 32 | \n 33 | // ---------- vocabulary ----------\n 34 | export const DocType = z.enum([\n 35 |   \"aadhaar\",\n 36 |   \"bank_passbook\",\n 37 |   \"land_record\",\n 38 |   \"ration_card\",\n 39 |   \"death_certificate\",\n 40 |   \"bpl_proof\",\n 41 |   \"voter_id\",\n 42 |   \"age_proof\",\n 43 |   \"address_proof\",\n 44 |   \"self_declaration\",\n 45 |   \"income_certificate\",\n 46 |   \"other\",\n 47 | ]);\n 48 | export type DocType = z.infer<typeof DocType>;\n 49 | \n 50 | /** Where the citizen goes to fix or confirm something. */\n 51 | export const FixWhere = z.enum([\n 52 |   \"bank\",\n 53 |   \"aadhaar_centre\",\n 54 |   \"circle_office\",\n 55 |   \"gram_panchayat\",\n 56 |   \"block_office\",\n 57 |   \"csc\",\n 58 |   \"pm_kisan_portal\",\n 59 |   \"supply_office\",\n 60 |   \"registrar\",\n 61 |   \"applicant\",\n 62 |   \"none\",\n 63 | ]);\n 64 | export type FixWhere = z.infer<typeof FixWhere>;\n 65 | \n 66 | export const FieldName = z.enum([\n 67 |   \"name\",\n 68 |   \"dob\",\n 69 |   \"aadhaarLast4\",\n 70 |   \"accountNo\",\n 71 |   \"ifsc\",\n 72 |   \"ownerNames\",\n 73 |   \"husbandName\",\n 74 |   \"landAreaHectares\",\n 75 | ]);\n 76 | export type FieldName = z.infer<typeof FieldName>;\n 77 | \n 78 | // ---------- extracted documents (from the AI reader or manual entry) ----------\n 79 | export const ExtractedDoc = z.object({\n 80 |   docType: DocType,\n 81 |   fields: z\n 82 |     .object({\n 83 |       name: z.string().optional(),\n 84 |       dob: z.string().optional(),\n 85 |       /** Only the last 4 digits of Aadhaar are ever kept. */\n 86 |       aadhaarLast4: z.string().regex(/^\\d{4}$/).optional(),\n 87 |       accountNo: z.string().optional(),\n 88 |       ifsc: z.string().optional(),\n 89 |       ownerNames: z.array(z.string()).optional(),\n 90 |       husbandName: z.string().optional(),\n 91 |       landAreaHectares: z.number().nonnegative().optional(),\n 92 |     })\n 93 |     .strict(),\n 94 |   /** Per-field confidence 0–1. A missing entry means \"entered or confirmed by the user\". */\n 95 |   confidence: z.partialRecord(FieldName, z.number().min(0).max(1)),\n 96 | });\n 97 | export type ExtractedDoc = z.infer<typeof ExtractedDoc>;\n 98 | \n 99 | /** Yes/no answers keyed by question id. Missing key = not answered. */\n100 | export const Answers = z.record(z.string(), z.boolean());\n101 | export type Answers = z.infer<typeof Answers>;\n102 | \n103 | // ---------- scheme rule pack: building blocks ----------\n104 | export const Question = z.object({\n105 |   id: z.string().regex(SNAKE_ID),\n106 |   /** Short label used inside messages, e.g. \"income tax payer\". */\n107 |   labelEn: z.string().min(1),\n108 |   labelAs: z.string().min(1),\n109 |   textEn: z.string().min(1),\n110 |   textAs: z.string().min(1),\n111 |   /** Where to confirm this (defaults to the scheme's confirmAt). */\n112 |   fixWhere: FixWhere.optional(),\n113 |   provenance: RuleProvenance,\n114 | });\n115 | export type Question = z.infer<typeof Question>;\n116 | \n117 | export const DocRequirement = z.object({\n118 |   docType: DocType,\n119 |   fixWhere: FixWhere,\n120 |   provenance: RuleProvenance,\n121 | });\n122 | export type DocRequirement = z.infer<typeof DocRequirement>;\n123 | \n124 | export const NameCheckRule = z.object({\n125 |   docType: DocType,\n126 |   field: z.enum([\"name\", \"ownerNames\"]),\n127 |   fixWhere: FixWhere,\n128 |   provenance: RuleProvenance,\n129 |   /** If answered yes, an owner-name mismatch becomes \"confirm\" inste