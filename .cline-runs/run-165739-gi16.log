{"ts":"2026-10-10T11:47:00.447Z","type":"agent_event","event":{"type":"content_start","contentType":"tool","toolName":"editor","toolCallId":"toolu_01VPK2KaPDvB2FzNztC4hLHE","input":{"path":"C:\\Users\\NILESH~1\\AppData\\Local\\Temp\\kz-t4-smoke.mjs","new_text":"const base = process.argv[2];\nconst mode = process.argv[3]; // \"open\" | \"locked\"\nconst get = async (p, headers = {}) => { const r = await fetch(base + p, { headers }); return { status: r.status, text: await r.text() }; };\nconst post = async (p, body, headers = {}) => {\n  const r = await fetch(base + p, { method: \"POST\", headers: { \"Content-Type\": \"application/json\", ...headers }, body: JSON.stringify(body) });\n  return { status: r.status, text: await r.text() };\n};\nconst home = await get(\"/\");\nconsole.log(\"home:\", { status: home.status, decodeLink: home.text.includes('href=\"/decode\"'), pmKisan: home.text.includes(\"PM-KISAN\"), oldAge: home.text.includes(\"Old Age Pension\") });\nconst dec = await get(\"/decode\");\nconsole.log(\"/decode:\", dec.status, dec.text.includes(\"নাকচ জাননীৰ অৰ্থ জানক\"));\nconst admin = await get(\"/admin\");\nconsole.log(\"/admin:\", admin.status, { unprotectedBanner: admin.text.includes(\"Demo mode: unprotected\") });\nconst list = await get(\"/api/admin/rules\");\nconsole.log(\"GET /api/admin/rules (no header):\", list.status);\nif (mode === \"locked\") {\n  console.log(\"GET with wrong passcode:\", (await get(\"/api/admin/rules\", { \"x-admin-passcode\": \"nope\" })).status);\n  const ok = await get(\"/api/admin/rules\", { \"x-admin-passcode\": \"smoke-pass\" });\n  console.log(\"GET with right passcode:\", ok.status, JSON.parse(ok.text).schemes.map((s) => s.id).join(\",\"));\n  console.log(\"publish without passcode:\", (await post(\"/api/admin/rules/1/publish\", {})).status);\n} else {\n  console.log(\"schemes:\", JSON.parse(list.text).schemes.map((s) => `${s.id}@${s.liveVersion}`).join(\",\"));\n  for (const text of [\"Payment failed: Aadhaar not seeded with bank account\", \"Your file is with the moon department\"]) {\n    const r = await post(\"/api/decode\", { text });\n    const j = JSON.parse(r.text);\n    console.log(\"decode:\", r.status, j.ai, j.result.status, j.result.code, j.result.confidence, j.result.fix.stepsAs[0]?.slice(0, 30));\n  }\n}\n"}}}
