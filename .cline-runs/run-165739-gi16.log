               <summary className=\"cursor-pointer text-base\">\n31 |                     <span className=\"font-mono\">{v.version}</span> · {v.status} · {new Date(v.createdAt).toLocaleString()} · {v.summary.slice(0, 80)}\n32 |                   </summary>\n33 |                   <div className=\"mt-2\">\n34 |                     <ProposalCard proposal={v} onDecide={onDecide} compact />\n35 |                   </div>\n36 |                 </details>\n37 |               </li>\n38 |             ))}\n39 |             {s.builtinVersion && (\n40 |               <li className=\"text-base text-zinc-700\">\n41 |                 <span className=\"font-mono\">{s.builtinVersion}</span> · built-in (version 1, in code)\n42 |               </li>\n43 |             )}\n44 |           </ul>\n45 |         </Card>\n46 |       ))}\n47 |     </section>\n48 |   );\n49 | }","success":true}],"durationMs":8}}
