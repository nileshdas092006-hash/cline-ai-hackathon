{"ts":"2026-10-10T09:30:09.191Z","type":"agent_event","event":{"type":"content_start","contentType":"tool","toolName":"editor","toolCallId":"toolu_013HDh26y8Wg3u3HjyxTLooU","input":{"path":"C:\\Dev\\cline hackathon\\build\\src\\core\\docFields.ts","new_text":"// Which fields we read or ask for on each document type. Pure.\n// Minimum personal data: only what the rule engine uses. Never a full Aadhaar number.\nimport type { DocType, FieldName } from \"./types\";\n\nexport const DOC_FIELDS: Record<DocType, readonly FieldName[]> = {\n  aadhaar: [\"name\", \"dob\", \"aadhaarLast4\"],\n  bank_passbook: [\"name\", \"accountNo\", \"ifsc\"],\n  land_record: [\"ownerNames\"],\n  ration_card: [\"name\"],\n  death_certificate: [\"husbandName\"],\n  bpl_proof: [\"name\"],\n  voter_id: [\"name\"],\n  age_proof: [\"name\", \"dob\"],\n  address_proof: [\"name\"],\n  self_declaration: [\"name\"],\n  income_certificate: [\"name\"],\n  other: [\"name\"],\n};\n\n/** Splits a list of names typed or read as one string (\"A; B\" or one per line). */\nexport function splitNames(text: string): string[] {\n  return text\n    .split(/[;\\n]/)\n    .map((s) => s.trim().replace(/\\s+/g, \" \"))\n    .filter((s) => s !== \"\");\n}\n"}}}
