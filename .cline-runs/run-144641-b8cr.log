  const readable = names.filter((n) => normalizeName(n) !== \"\");\n 91 |   if (normalizeName(refName) === \"\" || readable.length === 0) {\n 92 |     const which = normalizeName(refName) === \"\" ? r : t;\n 93 |     return {\n 94 |       ...base,\n 95 |       result: \"needs_verification\",\n 96 |       messageEn: `We could not read the name on the ${which.en}. Please type it exactly as printed.`,\n 97 |       messageAs: `${which.as}ত থকা নামটো আমি পঢ়িব নোৱাৰিলোঁ। ছপা হোৱাৰ দৰে হুবহু লিখক।`,\n 98 |       fixWhere: \"applicant\",\n 99 |     };\n100 |   }\n101 | \n102 |   const match = bestNameMatch(refName, readable);\n103 |   const score = match.score.toFixed(2);\n104 |   if (isLowConfidence(reference, \"name\") || isLowConfidence(target, rule.field)) {\n105 |     return {\n106 |       ...base,\n107 |       match,\n108 |       result: \"needs_verification\",\n109 |       messageEn: `We are not sure we read the name on the ${t.en} or ${r.en} correctly. Please check it and correct it if needed.`,\n110 |       messageAs: `${t.as} বা ${r.as}ত থকা নামটো আমি শুদ্ধকৈ পঢ়িছোঁ নে নাই নিশ্চিত নহয়। পৰীক্ষা কৰি প্ৰয়োজন হ'লে শুধৰাওক।`,\n111 |       fixWhere: \"applicant\",\n112 |     };\n113 |   }\n114 | \n115 |   if (match.level === \"same\") {\n116 |     return {\n117 |       ...base,\n118 |       match,\n119 |       result: \"ok\",\n120 |       messageEn: `Name on the ${t.en} matches the ${r.en}.`,\n121 |       messageAs: `${t.as}ৰ নাম ${r.as}ৰ সৈতে মিলে।`,\n122 |       fixWhere: \"none\",\n123 |     };\n124 |   }\n125 |   if (match.level === \"possible_match\" || match.level === \"initials_only\") {\n126 |     const initials = match.level === \"initials_only\";\n127 |     return {\n128 |       ...base,\n129 |       match,\n130 |       result: \"needs_verification\",\n131 |       messageEn:\n132 |         (initials\n133 |           ? `The name on the ${t.en} uses initials instead of the full name on the ${r.en} (similarity ${score}). `\n134 |           : `The names on the ${t.en} and ${r.en} look like the same person written differently (similarity ${score}). `) +\n135 |         `Officials may still reject this. Ask ${where(rule.fixWhere).en} to make them identical.`,\n136 |       messageAs:\n137 |         (initials\n138 |           ? `${t.as}ত ${r.as}ৰ সম্পূৰ্ণ নামৰ সলনি আদ্যাক্ষৰ ব্যৱহাৰ কৰা হৈছে (মিল ${score})। `\n139 |           : `${t.as} আৰু ${r.as}ৰ নাম একেজন ব্যক্তিৰ বেলেগকৈ লিখা যেন লাগে (মিল ${score})। `) +\n140 |         `বিষয়াই তথাপিও নাকচ কৰিব পাৰে। দুয়োটা হুবহু একে কৰিবলৈ ${where(rule.fixWhere).as}ত কওক।`,\n141 |       fixWhere: rule.fixWhere,\n142 |     };\n143 |   }\n144 |   return mismatchCheck(base, rule, answers, match, t, r, score);\n145 | }\n146 | \n147 | function mismatchCheck(\n148 |   base: Pick<Check, \"id\" | \"kind\" | \"docType\" | \"provenance\">,\n149 |   rule: NameCheckRule,\n150 |   answers: Answers,\n151 |   match: NameMatchResult,\n152 |   t: Bilingual,\n153 |   r: Bilingual,\n154 |   score: string,\n155 | ): Check {\n156 |   const family = rule.familyOwnerQuestion;\n157 |   if (family && answers[family.id] === true) {\n158 |     // Land owned by a spouse/minor child is allowed, but we cannot prove the relationship from a photo.\n159 |     return {\n160 |       ...base,\n161 |       match,\n162 |       result: \"needs_verification\",\n163 |       messageEn: `The owner on the ${t.en} is not you; you said it is a family member. Take proof of the relationship to ${where(rule.fixWhere).en} and confirm it is accepted.`,\n164 |       messageAs: `${t.as}ত থকা গৰাকী আপুনি নহয়; আপুনি কৈছে যে তেওঁ পৰিয়ালৰ সদস্য। সম্পৰ্কৰ প্ৰমাণ লৈ ${where(rule.fixWhere).as}ত গ্ৰহণযোগ্য নেকি নিশ্চিত কৰক।`,\n165 |       fixWhere: rule.fixWhere,\n166 |     };\n167 |   }\n168 |   return {\n169 |     ...base,\n170 |     match,\n171 |     result: \"action_required\",\n172 |     messageEn: `The name on the ${t.en} does not match the ${r.en} (similarity ${score}). Correct the ${t.en} at ${where(rule.fixWhere).en} so it matches exactly.`,\n173 |     messageAs: `${t.as}ৰ নাম ${r.as}ৰ সৈতে মিল নাই (মিল ${score})। হুবহু মিলাবলৈ ${where(rule.fixWhere).as}ত ${t.as} শুধৰাওক।`,\n174 |     fixWhere: rule.fixWhere,\n175 |   };\n176 | }\n177 | \n178 | // ---------- field formats ----------\n179 | function fieldChecks(scheme: SchemeRule, docs: readonly ExtractedDoc[]): Check[] {\n180 |   const out: Check[] = [];\n181 |   for (const f of scheme.fieldChecks) {\n182 |     const doc = findDoc(docs, f.docType);\n183 |     if (!doc) continue; // the missing-document check already covers this\n184 |     const base = { id: `field_${f.id}`, kind: \"field\" as const, docType: f.docType, provenance: f.provenance };\n185 |     const raw = doc.fields[f.field];\n186 |     const value = (raw ?? \"\").replace(/[\\s-]/g, \"\").toUpperCase();\n187 |     if (value === \"\" || isLowConfidence(doc, f.field)) {\n188 |       out.push({\n189 |         ...base,\n190 |         result: \"needs_verification\",\n191 |         messageEn: `Please type the ${f.labelEn} exactly as printed on the ${DOC_LABELS[f.docType].en}.`,\n192 |         messageAs: `${DOC_LABELS[f.docType].as}ত ছপা হোৱাৰ দৰে ${f.labelAs} হুবহু লিখক।`,\n193 |         fixWhere: \"applicant\",\n194 |       });\n195 |     } else if (new RegExp(f.pattern).test(value)) {\n196 |       out.push({ ...base, result: \"ok\", messageEn: `${cap(f.labelEn)} looks valid.`, messageAs: `${f.labelAs} সঠিক যেন লাগে।`, fixWhere: \"none\" });\n197 |     } else {\n198 |       out.push({\n199 |         ...base,\n200 |         result: \"action_required\",\n201 |         messageEn: `The ${f.labelEn} looks wrong. ${f.hintEn} Check it with ${where(f.fixWhere).en}.`,\n202 |         messageAs: `${f.labelAs} ভুল যেন লাগে। ${f.hintAs} ${where(f.fixWhere).as}ত পৰীক্ষা কৰক।`,\n203 |         fixWhere: f.fixWhere,\n204 |       });\n205 |     }\n206 |   }\n207 |   return out;\n208 | }\n209 | \n210 | \n211 | // ---------- eligibility ----------\n212 | function ageCheck(scheme: SchemeRule, docs: readonly ExtractedDoc[], asOfDate: string): Check | null {\n213 |   const range = scheme.ageRange;\n214 |   if (!range) return null;\n215 |   const base = { id: \"age\", kind: \"eligibility\" as const, provenance: range.provenance };\n216 |   const src = DOC_LABELS[range.dobFrom];\n217 |   const doc = findDoc(docs, range.dobFrom);\n218 |   const dob = doc?.fields.dob;\n219 |   const unsure = (en: string, as: string): Check => ({ ...base, result: \"needs_verification\", messageEn: en, messageAs: as, fixWhere: \"applicant\" });\n220 | \n221 |   if (!doc || !dob) {\n222 |     return unsure(\n223 |       `We need the date of birth from the ${src.en} to check the age limit (${range.min}–${range.max}).`,\n224 |       `বয়সৰ সীমা (${range.min}–${range.max}) পৰীক্ষা কৰিবলৈ ${src.as}ৰ জন্মৰ তাৰিখ লাগিব।`,\n225 |     );\n226 |   }\n227 |   if (!isIsoDate(dob) || dob > asOfDate || isLowConfidence(doc, \"dob\")) {\n228 |     return unsure(\n229 |       `Please confirm the date of birth on the ${src.en} (we could not read it reliably).`,\n230 |       `${src.as}ত থকা জন্মৰ তাৰিখটো নিশ্চিত কৰক (আমি নিৰ্ভৰযোগ্যভাৱে পঢ়িব নোৱাৰিলোঁ)।`,\n231 |     );\n232 |   }\n233 |   const age = ageOn(dob, asOfDate);\n234 |   if (age >= range.min && age <= range.max) {\n235 |     return {\n236 |       ...base,\n237 |       result: \"ok\",\n238 |       messageEn: `Age ${age} on ${asOfDate} is within ${range.min}–${range.max}.`,\n239 |       messageAs: `${asOfDate} তাৰিখত বয়স ${age}, যি ${range.min}–${range.max}ৰ ভিতৰত।`,\n240 |       fixWhere: \"none\",\n241 |     };\n242 |   }\n243 |   const above = age > range.max;\n244 |   const verifiedRule = range.provenance.status === \"verified\";\n245 |   return {\n246 |     ...base,\n247 |     result: verifiedRule ? \"action_required\" : \"needs_verification\",\n248 |     messageEn:\n249 |       `Age ${age} on ${asOfDate} is outside the ${range.min}–${range.max} limit for this scheme.` +\n250 |       (above && range.aboveMaxHintEn ? ` ${range.aboveMaxHintEn}` : 