{"ts":"2026-10-10T09:43:38.651Z","type":"agent_event","event":{"type":"content_start","contentType":"tool","toolName":"editor","toolCallId":"toolu_01Qd47hAehKXvVSb6RjfTLpp","input":{"path":"C:\\Dev\\cline hackathon\\build\\src\\app\\layout.tsx","new_text":"import type { Metadata, Viewport } from \"next\";\nimport { Geist, Noto_Sans_Bengali } from \"next/font/google\";\nimport { APP_DESCRIPTION_EN, APP_LANG, APP_TITLE } from \"@/core/appInfo\";\nimport \"./globals.css\";\n\nconst geistSans = Geist({\n  variable: \"--font-geist-sans\",\n  subsets: [\"latin\"],\n});\n\n// Noto Sans Bengali covers the Assamese script (incl. ৰ and ৱ).\nconst notoBengali = Noto_Sans_Bengali({\n  variable: \"--font-noto-bengali\",\n  subsets: [\"bengali\"],\n});\n\nexport const metadata: Metadata = {\n  title: APP_TITLE,\n  description: APP_DESCRIPTION_EN,\n};\n\nexport const viewport: Viewport = {\n  width: \"device-width\",\n  initialScale: 1,\n  themeColor: \"#0f766e\",\n};\n\nexport default function RootLayout({\n  children,\n}: Readonly<{ children: React.ReactNode }>) {\n  return (\n    <html\n      lang={APP_LANG}\n      className={`${geistSans.variable} ${notoBengali.variable} h-full antialiased`}\n    >\n      <body className=\"min-h-full flex flex-col\">{children}</body>\n    </html>\n  );\n}\n"}}}
