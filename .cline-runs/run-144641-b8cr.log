{"ts":"2026-10-10T09:17:14.279Z","type":"agent_event","event":{"type":"content_end","contentType":"tool","toolName":"read_files","toolCallId":"toolu_016gZ378Jz5KxdgxPqYFx2Lc","output":[{"query":"C:\\Dev\\cline hackathon\\build\\src\\core\\types.ts","result":"  1 | // Types + zod schemas for the rule engine (rule packs v2, docs/schemes.md).\n  2 | // Pure module: no UI, network, database or process.env imports.\n  3 | import { z } from \"zod\";\n  4 | import { isIsoDate } from \"./dates\";\n  5 | \n  6 | export const IsoDate = z.string().refine(isIsoDate, { message: \"expected a real date as YYYY-MM-DD\" });\n  7 | \n  8 | const SNAKE_ID = /^[a-z][a-z0-9_]*$/;\n  9 | const SCHEME_ID = /^[a-z0-9]+(-[a-z0-9]+)*$/;\n 10 | const SEMVER = /^\\d+\\.\\d+\\.\\d+$/;\n 11 | \n 12 | // ---------- provenance ----------\n 13 | export const RuleStatus = z.enum([\"verified\", \"provisional\"]);\n 14 | export type RuleStatus = z.infer<typeof RuleStatus>;\n 15 | \n 16 | export const RuleProvenance = z\n 17 |   .object({\n 18 |     sourceUrl: z.url().nullable(),\n 19 |     sourceTitle: z.string().min(1),\n 20 |     clause: z.string().min(1).nullable().optional(),\n 21 |     effectiveDate: IsoDate.nullable().optional(),\n 22 |     verifiedOn: IsoDate,\n 23 |     version: z.string().regex(SEMVER),\n 24 |     status: RuleStatus,\n 25 |   })\n 26 |   // A rule can only be \"verified\" if we can point to its source.\n 27 |   .refine((p) => p.status === \"provisional\" || p.sourceUrl !== null, {\n 28 |     message: \"a verified rule needs a sourceUrl\",\n 29 |     path: [\"sourceUrl\"],\n 30 |   });\n 31 | export type RuleProvenance = z.infer<typeof RuleProvenance>;\n 32 | \n 33 | // ---------- vocabulary ----------\n 34 | export const DocType = z.enum([\n 35 |   \"aadhaar\",\n 36 |   \"bank_passbook\",\n 37 |   \"land_record\",\n 38 |   \"ration_card\",\n 39 |   \"death_certificate\",\n 40 |   \"bpl_proof\",\n 41 |   \"voter_id\",\n 42 |   \"age_proof\",\n 43 |   \"address_proof\",\n 44 |   \"self_declaration\",\n 45 |   \"income_certificate\",\n 46 |   \"other\",\n 47 | ]);\n 48 | export type DocType = z.infer<typeof DocType>;\n 49 | \n 50 | /** Where the citizen goes to fix or confirm something. */\n 51 | export const FixWhere = z.enum([\n 52 |   \"bank\",\n 53 |   \"aadhaar_centre\",\n 54 |   \"circle_office\",\n 55 |   \"gram_panchayat\",\n 56 |   \"block_office\",\n 57 |   \"csc\",\n 58 |   \"pm_kisan_portal\",\n 59 |   \"supply_office\",\n 60 |   \"registrar\",\n 61 |   \"applicant\",\n 62 |   \"none\",\n 63 | ]);\n 64 | export type FixWhere = z.infer<typeof FixWhere>;\n 65 | \n 66 | export const FieldName = z.enum([\n 67 |   \"name\",\n 68 |   \"dob\",\n 69 |   \"aadhaarLast4\",\n 70 |   \"accountNo\",\n 71 |   \"ifsc\",\n 72 |   \"ownerNames\",\n 73 |   \"husbandName\",\n 74 |   \"landAreaHectares\",\n 75 | ]);\n 76 | export type FieldName = z.infer<typeof FieldName>;\n 77 | \n 78 | // ---------- extracted documents (from the AI reader or manual entry) ----------\n 79 | export const ExtractedDoc = z.object({\n 80 |   docType: DocType,\n 81 |   fields: z\n 82 |     .object({\n 83 |       name: z.string().optional(),\n 84 |       dob: z.string().optional(),\n 85 |       /** Only the last 4 digits of Aadhaar are ever kept. */\n 86 |       aadhaarLast4: z.string().regex(/^\\d{4}$/).optional(),\n 87 |       accountNo: z.string().optional(),\n 88 |       ifsc: z.string().optional(),\n 89 |       ownerNames: z.array(z.string()).optional(),\n 90 |       husbandName: z.string().optional(),\n 91 |       landAreaHectares: z.number().nonnegative().optional(),\n 92 |     })\n 93 |     .strict(),\n 94 |   /** Per-field confidence 0–1. A missing entry means \"entered or confirmed by the user\". */\n 95 |   confidence: z.partialRecord(FieldName, z.number().min(0).max(1)),\n 96 | });\n 97 | export type ExtractedDoc = z.infer<typeof ExtractedDoc>;\n 98 | \n 99 | /** Yes/no answers keyed by question id. Missing key = not answered. */\n100 | export const Answers = z.record(z.string(), z.boolean());\n101 | export type Answers = z.infer<typeof Answers>;\n102 | \n103 | // ---------- scheme rule pack: building blocks ----------\n104 | export const Question = z.object({\n105 |   id: z.string().regex(SNAKE_ID),\n106 |   /** Short label used inside messages, e.g. \"income tax payer\". */\n107 |   labelEn: z.string().min(1),\n108 |   labelAs: z.string().min(1),\n109 |   textEn: z.string().min(1),\n110 |   textAs: z.string().min(1),\n111 |   /** Where to confirm this (defaults to the scheme's confirmAt). */\n112 |   fixWhere: FixWhere.optional(),\n113 |   provenance: RuleProvenance,\n114 | });\n115 | export type Question = z.infer<typeof Question>;\n116 | \n117 | export const DocRequirement = z.object({\n118 |   docType: DocType,\n119 |   fixWhere: FixWhere,\n120 |   provenance: RuleProvenance,\n121 | });\n122 | export type DocRequirement = z.infer<typeof DocRequirement>;\n123 | \n124 | export const NameCheckRule = z.object({\n125 |   docType: DocType,\n126 |   field: z.enum([\"name\", \"ownerNames\"]),\n127 |   fixWhere: FixWhere,\n128 |   provenance: RuleProvenance,\n129 |   /** If answered yes, an owner-name mismatch becomes \"confirm\" instead of \"fix\" (land owned by a family member). */\n130 |   familyOwnerQuestion: Question.optional(),\n131 | });\n132 | export type NameCheckRule = z.infer<typeof NameCheckRule>;\n133 | \n134 | export const FieldCheckRule = z\n135 |   .object({\n136 |     id: z.string().regex(SNAKE_ID),\n137 |     docType: DocType,\n138 |     field: z.enum([\"accountNo\", \"ifsc\"]),\n139 |     /** Regex the value must match after removing spaces/hyphens and uppercasing. */\n140 |     pattern: z.string().min(1),\n141 |     labelEn: z.string().min(1),\n142 |     labelAs: z.string().min(1),\n143 |     hintEn: z.string().min(1),\n144 |     hintAs: z.string().min(1),\n145 |     fixWhere: FixWhere,\n146 |     provenance: RuleProvenance,\n147 |   })\n148 |   .refine(\n149 |     (f) => {\n150 |       try {\n151 |         new RegExp(f.pattern);\n152 |         return true;\n153 |       } catch {\n154 |         return false;\n155 |       }\n156 |     },\n157 |     { message: \"pattern must be a valid regular expression\", path: [\"pattern\"] },\n158 |   );\n159 | export type FieldCheckRule = z.infer<typeof FieldCheckRule>;\n160 | \n161 | export const ExternalCheckRule = z.object({\n162 |   id: z.string().regex(SNAKE_ID),\n163 |   labelEn: z.string().min(1),\n164 |   labelAs: z.string().min(1),\n165 |   howEn: z.string().min(1),\n166 |   howAs: z.string().min(1),\n167 |   fixWhere: FixWhere,\n168 |   provenance: RuleProvenance,\n169 | });\n170 | export type ExternalCheckRule = z.infer<typeof ExternalCheckRule>;\n171 | \n172 | export const AgeRange = z\n173 |   .object({\n174 |     min: z.int().nonnegative(),\n175 |     max: z.int().nonnegative(),\n176 |     dobFrom: DocType,\n177 |     aboveMaxHintEn: z.string().optional(),\n178 |     aboveMaxHintAs: z.string().optional(),\n179 |     provenance: RuleProvenance,\n180 |   })\n181 |   .refine((a) => a.min <= a.max, { message: \"min must be ≤ max\" });\n182 | export type AgeRange = z.infer<typeof AgeRange>;\n183 | \n184 | export const BenefitOverride = z\n185 |   .object({\n186 |     from: IsoDate,\n187 |     to: IsoDate,\n188 |     centralShare: z.number().nonnegative().optional(),\n189 |     stateTopUp: z.number().nonnegative().nullable().optional(),\n190 |     noteEn: z.string().min(1),\n191 |     noteAs: z.string().min(1),\n192 |     provenance: RuleProvenance,\n193 |   })\n194 |   .refine((o) => o.from <= o.to, { message: \"override 'to' must not be before 'from'\", path: [\"to\"] });\n195 | export type BenefitOverride = z.infer<typeof BenefitOverride>;\n196 | \n197 | export const Benefit = z.object({\n198 |   centralShare: z.number().nonnegative(),\n199 |   /** null = unconfirmed; never show a total then. */\n200 |   stateTopUp: z.number().nonnegative().nullable(),\n201 |   period: z.enum([\"month\", \"year\"]),\n202 |   instalments: z.int().positive().optional(),\n203 |   effectiveDate: IsoDate.nullable().optional(),\n204 |   provenance: RuleProvenance,\n205 |   /** Time-bounded changes (e.g. a one-time payment for one month). Later entries win. */\n206 |   overrides: z.array(BenefitOverride).default([]),\n207 | });\n208 | export type Benefit = z.infer<typeof Benefit>;\n209 | \n210 | export const SchemeNote = z.object({\n211 |   id: z.string().regex(SNAKE_ID),\n212 |   textEn: z.string().min(1),\n213 |   textAs: z.string().min(1),\n214 |   provenance: RuleProvenance,\n215 | });\n216 | export type SchemeNote = z.infer<typeof SchemeNote>;\n217 | \n218 | // ---------- scheme rule pack ----------\n219 | export const SchemeRule = z.object({\n220 |   id: z.string().regex(SCHEME_ID),\n221 |   version: z.string().regex(SEMVER),\n222 |   nameEn: z.string().min(1),\n223 |   nameAs: z.string().min(1),\n224 |   /** Default place to confirm provisional rules. */\n225 |   confirmAt: FixWhere,\n226 |   benefit: Benefit,\n227 |   mandatoryDocs: z.array(DocRequirement),\n228 |   supportingDocs: z.array(DocRequirement).default([]),\n229 |   supportingDocsNoteEn: z.string().nullable().default(null),\n230 |   supportingDocsNoteAs: z.string().nullable().default(null),\n231 |   /** The document every other name is compared with. */\n232 |   nameReference: DocType,\n233 |   nameChecks: z.array(NameCheckRule).default([]),\n234 |   fieldChecks: z.array(FieldCheckRule).default([]),\n235 |   ageRange: AgeRange.optional(),\n236 |   /** Every one must be \"yes\". */\n237 |   requirements: z.array(Question).default([]),\n238 |   /** At least one must be \"yes\" (skipped when empty). */\n239 |   eligibilityAnyOf: z.array(Question).default([]),\n240 |   /** Any \"yes\" excludes (verified) or needs verification (provisional). */\n241 |   exclusions: z.array(Question).default([]),\n242 |   /** Facts a photo cannot prove: always needs_verification. */\n243 |   externalChecks: z.array(ExternalCheckRule).default([]),\n244 |   notes: z.array(SchemeNote).default([]),\n245 | });\n246 | export type SchemeRule = z.infer<typeof SchemeRule>;\n247 | export type SchemeRuleInput = z.input<typeof SchemeRule>;\n248 | \n249 | // ---------- results ----------\n250 | export const NameMatchLevel = z.enum([\"same\", \"possible_match\", \"initials_only\", \"mismatch\"]);\n251 | export type NameMatchLevel = z.infer<typeof NameMatchLevel>;\n252 | export const NameMatchResult = z.object({ level: NameMatchLevel, score: z.number().min(0).max(1) });\n253 | export type NameMatchResult = z.infer<typeof NameMatchResult>;\n254 | \n255 | export const CheckResult = z.enum([\"ok\", \"action_required\", \"needs_verification\", \"not_applicable\"]);\n256 | export type CheckResult = z.infer<typeof CheckResult>;\n257 | \n258 | export const CheckKind = z.enum([\"document\", \"name\", \"field\", \"eligibility\", \"external\"]);\n259 | export type CheckKind = z.infer<typeof CheckKind>;\n260 | \n261 | export const Check = z.object({\n262 |   id: z.string().min(1),\n263 |   kind: CheckKind,\n264 |   result: CheckResult,\n265 |   messageEn: z.string().min(1),\n266 |   messageAs: z.string().min(1),\n267 |   fixWhere: FixWhere,\n268 |   provenance: RuleProvenance,\n269 |   docType: DocType.optional(),\n270 |   match: NameMatchResult.optional(),\n271 | });\n272 | export type Check = z.infer<typeof Check>;\n273 | \n274 | export const Eligibility = z.enum([\"likely_eligible\", \"not_eligible\", \"needs_verification\"]);\n275 | export type Eligibility = z.infer<typeof Eligibility>;\n276 | export const Readiness = z.enum([\"ready_for_review\", \"action_required\", \"needs_verification\"]);\n277 | export type Readiness = z.infer<typeof Readiness>;\n278 | \n279 | export const BenefitOn = z.object({\n280 |   centralShare: z.number().nonnegative(),\n281 |   stateTopUp: z.number().nonnegative().nullable(),\n282 |   /** null when the state top-up is unconfirmed. */\n283 |   total: z.number().nonnegative().nullable(),\n284 |   period: z.enum([\"month\", \"year\"]),\n285 |   instalments: z.int().positive().optional(),\n286 |   isOverride: z.boolean(),\n287 |   noteEn: z.string().optional(),\n288 |   noteAs: z.string().optional(),\n289 |   provenance: RuleProvenance,\n290 | });\n291 | export type BenefitOn = z.infer<typeof BenefitOn>;\n292 | \n293 | export const SupportingDocStatus = z.object({\n294 |   docType: DocType,\n295 |   labelEn: z.string(),\n296 |   labelAs: z.string(),\n297 |   present: z.boolean(),\n298 |   provenance: RuleProvenance,\n299 | });\n300 | export type SupportingDocStatus = z.infer<typeof SupportingDocStatus>;\n301 | \n302 | export const Report = z.object({\n303 |   schemeId: z.string(),\n304 |   schemeVersion: z.string(),\n305 |   asOfDate: IsoDate,\n306 |   eligibility: Eligibility,\n307 |   readiness: Readiness,\n308 |   checks: z.array(Check),\n309 |   benefit: BenefitOn,\n310 |   supportingDocs: z.array(SupportingDocStatus),\n311 |   supportingDocsNoteEn: z.string().nullable(),\n312 |   supportingDocsNoteAs: z.string().nullable(),\n313 |   disclaimerEn: z.string(),\n314 |   disclaimerAs: z.string(),\n315 | });\n316 | export type Report = z.infer<typeof Report>;\n317 | ","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\core\\samples.ts","result":" 1 | // Demo sample sets (clearly FAKE people and numbers). Pure data, validated by zod.\n 2 | // A = clean PM-KISAN farmer → ready_for_review (+ bank seeding needs verification)\n 3 | // B = PM-KISAN: bank \"RAMESH KR SHARMA\" (possible match) + land \"Rameshwar Sharma\" (mismatch) → action_required\n 4 | // C = widow pension, missing death certificate → action_required\n 5 | import { z } from \"zod\";\n 6 | import { Answers, ExtractedDoc } from \"./types\";\n 7 | \n 8 | export const SampleSet = z.object({\n 9 |   id: z.enum([\"A\", \"B\", \"C\"]),\n10 |   schemeId: z.string(),\n11 |   titleEn: z.string(),\n12 |   titleAs: z.string(),\n13 |   docs: z.array(ExtractedDoc),\n14 |   answers: Answers,\n15 | });\n16 | expo