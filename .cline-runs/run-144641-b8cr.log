erNames: 0.9 },\n69 |       },\n70 |     ],\n71 |     answers: pmKisanNo,\n72 |   }),\n73 |   C: SampleSet.parse({\n74 |     id: \"C\",\n75 |     schemeId: \"nsap-widow\",\n76 |     titleEn: \"Sample C: Widow pension, death certificate missing (fake)\",\n77 |     titleAs: \"নমুনা C: বিধৱা পেঞ্চন, মৃত্যুৰ প্ৰমাণপত্ৰ নাই (নকল)\",\n78 |     docs: [\n79 |       {\n80 |         docType: \"aadhaar\",\n81 |         fields: { name: \"Smt. Sunita Devi\", dob: \"1968-07-01\", aadhaarLast4: \"7315\" },\n82 |         confidence: { name: 0.96, dob: 0.94, aadhaarLast4: 0.99 },\n83 |       },\n84 |       {\n85 |         docType: \"bank_passbook\",\n86 |         fields: { name: \"SUNITA DEVI\", accountNo: \"40098765432\", ifsc: \"UTBI0ABC123\" },\n87 |         confidence: { name: 0.94, accountNo: 0.92, ifsc: 0.95 },\n88 |       },\n89 |       {\n90 |         docType: \"bpl_proof\",\n91 |         fields: { name: \"Sunita Devi\" },\n92 |         confidence: { name: 0.9 },\n93 |       },\n94 |     ],\n95 |     answers: { is_widow: true, bpl_household: true },\n96 |   }),\n97 | };","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\core\\labels.ts","result":" 1 | // Fixed bilingual labels used inside engine messages. Pure.\n 2 | // Assamese strings are drafts and must be reviewed by a native speaker before the demo.\n 3 | import type { DocType, FixWhere } from \"./types\";\n 4 | \n 5 | export interface Bilingual {\n 6 |   en: string;\n 7 |   as: string;\n 8 | }\n 9 | \n10 | export const DOC_LABELS: Record<DocType, Bilingual> = {\n11 |   aadhaar: { en: \"Aadhaar card\", as: \"আধাৰ কাৰ্ড\" },\n12 |   bank_passbook: { en: \"bank passbook\", as: \"বেংক পাছবুক\" },\n13 |   land_record: { en: \"land record (jamabandi)\", as: \"মাটিৰ নথি (জমাবন্দী)\" },\n14 |   ration_card: { en: \"ration card\", as: \"ৰেচন কাৰ্ড\" },\n15 |   death_certificate: { en: \"husband's death certificate\", as: \"স্বামীৰ মৃত্যুৰ প্ৰমাণপত্ৰ\" },\n16 |   bpl_proof: { en: \"BPL proof\", as: \"বিপিএল (BPL) প্ৰমাণ\" },\n17 |   voter_id: { en: \"voter ID card\", as: \"ভোটাৰ পৰিচয়পত্ৰ\" },\n18 |   age_proof: { en: \"age proof\", as: \"বয়সৰ প্ৰমাণ\" },\n19 |   address_proof: { en: \"address proof\", as: \"ঠিকনাৰ প্ৰমাণ\" },\n20 |   self_declaration: { en: \"self-declaration\", as: \"স্ব-ঘোষণা পত্ৰ\" },\n21 |   income_certificate: { en: \"income certificate\", as: \"আয়ৰ প্ৰমাণপত্ৰ\" },\n22 |   other: { en: \"other document\", as: \"অন্য নথি\" },\n23 | };\n24 | \n25 | export const FIX_WHERE_LABELS: Record<FixWhere, Bilingual> = {\n26 |   bank: { en: \"your bank branch\", as: \"আপোনাৰ বেংকৰ শাখা\" },\n27 |   aadhaar_centre: { en: \"an Aadhaar enrolment/update centre\", as: \"আধাৰ পঞ্জীয়ন/আপডেট কেন্দ্ৰ\" },\n28 |   circle_office: { en: \"the revenue circle office\", as: \"ৰাজহ চক্ৰ কাৰ্যালয়\" },\n29 |   gram_panchayat: { en: \"the Gram Panchayat office\", as: \"গাঁও পঞ্চায়ত কাৰ্যালয়\" },\n30 |   block_office: { en: \"the block development office\", as: \"উন্নয়ন খণ্ড কাৰ্যালয়\" },\n31 |   csc: { en: \"a Common Service Centre (CSC)\", as: \"সাধাৰণ সেৱা কেন্দ্ৰ (CSC)\" },\n32 |   pm_kisan_portal: { en: \"the PM-KISAN portal (pmkisan.gov.in)\", as: \"PM-KISAN প'ৰ্টেল (pmkisan.gov.in)\" },\n33 |   supply_office: { en: \"the food and civil supplies office\", as: \"খাদ্য আৰু অসামৰিক যোগান কাৰ্যালয়\" },\n34 |   registrar: { en: \"the birth and death registrar\", as: \"জন্ম-মৃত্যু পঞ্জীয়কৰ কাৰ্যালয়\" },\n35 |   applicant: { en: \"you (the applicant)\", as: \"আপুনি (আবেদনকাৰী)\" },\n36 |   none: { en: \"nothing to do\", as: \"একো কৰিব নালাগে\" },\n37 | };\n38 | \n39 | export const DISCLAIMER: Bilingual = {\n40 |   en: \"We help you catch preventable mistakes. We do not guarantee approval; the department decides.\",\n41 |   as: \"আমি আপোনাক এৰাব পৰা ভুলবোৰ ধৰাত সহায় কৰোঁ। আমি অনুমোদনৰ নিশ্চয়তা নিদিওঁ; বিভাগেহে সিদ্ধান্ত লয়।\",\n42 | };","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\core\\evaluate.ts","result":"  1 | // The deterministic rule engine: evaluate(scheme, docs, answers, asOfDate) → Report. Pure.\n  2 | // Two verdicts (eligibility, readiness). Provisional rules and external facts never decide; they\n  3 | // return needs_verification. A fuzzy name score never becomes `ok`; only `same` does.\n  4 | import { ageOn } from \"./age\";\n  5 | import { benefitOn } from \"./benefit\";\n  6 | import { assertIsoDate, isIsoDate } from \"./dates\";\n  7 | import { DISCLAIMER, DOC_LABELS, FIX_WHERE_LABELS, type Bilingual } from \"./labels\";\n  8 | import { bestNameMatch, normalizeName } from \"./nameMatch\";\n  9 | import type {\n 10 |   Answers,\n 11 |   Check,\n 12 |   DocType,\n 13 |   Eligibility,\n 14 |   ExtractedDoc,\n 15 |   FieldName,\n 16 |   FixWhere,\n 17 |   NameCheckRule,\n 18 |   NameMatchResult,\n 19 |   Question,\n 20 |   Readiness,\n 21 |   Report,\n 22 |   SchemeRule,\n 23 | } from \"./types\";\n 24 | \n 25 | /** A field read with confidence below this must be confirmed by the user. */\n 26 | export const LOW_CONFIDENCE_THRESHOLD = 0.8;\n 27 | \n 28 | const where = (w: FixWhere): Bilingual => FIX_WHERE_LABELS[w];\n 29 | const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);\n 30 | \n 31 | function findDoc(docs: readonly ExtractedDoc[], docType: DocType): ExtractedDoc | undefined {\n 32 |   return docs.find((d) => d.docType === docType);\n 33 | }\n 34 | \n 35 | function isLowConfidence(doc: ExtractedDoc, field: FieldName): boolean {\n 36 |   const c = doc.confidence[field];\n 37 |   return c !== undefined && c < LOW_CONFIDENCE_THRESHOLD;\n 38 | }\n 39 | \n 40 | // ---------- documents ----------\n 41 | function mandatoryDocChecks(scheme: SchemeRule, docs: readonly ExtractedDoc[]): Check[] {\n 42 |   return scheme.mandatoryDocs.map((req): Check => {\n 43 |     const label = DOC_LABELS[req.docType];\n 44 |     const base = { id: `doc_${req.docType}`, kind: \"document\" as const, docType: req.docType, provenance: req.provenance };\n 45 |     if (findDoc(docs, req.docType)) {\n 46 |       return {\n 47 |         ...base,\n 48 |         result: \"ok\",\n 49 |         messageEn: `${cap(label.en)} added.`,\n 50 |         messageAs: `${label.as} যোগ কৰা হৈছে।`,\n 51 |         fixWhere: \"none\",\n 52 |       };\n 53 |     }\n 54 |     const commonly = req.provenance.status === \"provisional\";\n 55 |     return {\n 56 |       ...base,\n 57 |       result: \"action_required\",\n 58 |       messageEn:\n 59 |         `Missing: ${label.en}. Get it from ${where(req.fixWhere).en} and add it before you apply.` +\n 60 |         (commonly ? \" (Commonly required; confirm locally.)\" : \"\"),\n 61 |       messageAs:\n 62 |         `নাই: ${label.as}। আবেদন কৰাৰ আগতে ${where(req.fixWhere).as}ৰ পৰা লৈ যোগ কৰক।` +\n 63 |         (commonly ? \" (সাধাৰণতে লাগে; স্থানীয়ভাৱে নিশ্চিত কৰক।)\" : \"\"),\n 64 |       fixWhere: req.fixWhere,\n 65 |     };\n 66 |   });\n 67 | }\n 68 | \n 69 | // ---------- names ----------\n 70 | function nameCheck(scheme: SchemeRule, rule: NameCheckRule, docs: readonly ExtractedDoc[], answers: Answers): Check {\n 71 |   const target = findDoc(docs, rule.docType);\n 72 |   const reference = findDoc(docs, scheme.nameReference);\n 73 |   const t = DOC_LABELS[rule.docType];\n 74 |   const r = DOC_LABELS[scheme.nameReference];\n 75 |   const base = { id: `name_${rule.docType}`, kind: \"name\" as const, docType: rule.docType, provenance: rule.provenance };\n 76 | \n 77 |   if (!target || !reference) {\n 78 |     const missing = target ? r : t;\n 79 |     return {\n 80 |       ...base,\n 81 |       result: \"not_applicable\",\n 82 |       messageEn: `Name on the ${t.en} not compared: the ${missing.en} is not added.`,\n 83 |       messageAs: `${t.as}ৰ নাম মিলোৱা হোৱা নাই: ${missing.as} যোগ কৰা হোৱা নাই।`,\n 84 |       fixWhere: \"none\",\n 85 |     };\n 86 |   }\n 87 | \n 88 |   const refName = reference.fields.name ?? \"\";\n 89 |   const names = rule.field === \"ownerNames\" ? (target.fields.ownerNames ?? []) : [target.fields.name ?? \"\"];\n 90 |   const readable = names.filter((n) => normalizeName(n) !== \"\");\n 91 |   if (normalizeName(refName) === \"\" || readable.length === 0) {\n 92 |     const which = normalizeName(refName) === \"\" ? r : t;\n 93 |     return {\n 94 |       ...base,\n 95 |       result: \"needs_verification\",\n 96 |       messageEn: `We could not read the name on the ${which.en}. Please type it exactly as printed.`,\n 97 |       messageAs: `${which.as}ত থকা নামটো আমি পঢ়িব নোৱাৰিলোঁ। ছপা হোৱাৰ দৰে হুবহু লিখক।`,\n 98 |       fixWhere: \"applicant\",\n 99 |     };\n100 |   }\n101 | \n102 |   const match = bestNameMatch(refName, readable);\n103 |   const score = match.score.toFixed(2);\n104 |   if (isLowConfidence(reference, \"name\") || isLowConfidence(target, rule.field)) {\n105 |     return {\n106 |       ...base,\n107 |       match,\n108 |       result: \"needs_verification\",\n109 |       messageEn: `We are not sure we read the name on the ${t.en} or ${r.en} correctly. Please check it and correct it if needed.`,\n110 |       messageAs: `${t.as} বা ${r.as}ত থকা নামটো আমি শুদ্ধকৈ পঢ়িছোঁ নে নাই নিশ্চিত নহয়। পৰীক্ষা কৰি প্ৰয়োজন হ'লে শুধৰাওক।`,\n111 |       fixWhere: \"applicant\",\n112 |     };\n113 |   }\n114 | \n115 |   if (match.level === \"same\") {\n116 |     return {\n117 |       ...base,\n118 |       match,\n119 |       result: \"ok\",\n120 |       messageEn: `Name on the ${t.en} matches the ${r.en}.`,\n121 |       messageAs: `${t.as}ৰ নাম ${r.as}ৰ সৈতে মিলে।`,\n122 |       fixWhere: \"none\",\n123 |     };\n124 |   }\n125 |   if (match.level === \"possible_match\" || match.level === \"initials_only\") {\n126 |     const initials = match.level === \"initials_only\";\n127 |     return {\n128 |       ...base,\n129 |       match,\n130 |       result: \"needs_verification\",\n131 |       messageEn:\n132 |         (initials\n133 |           ? `The name on the ${t.en} uses initials instead of the full name on the ${r.en} (similarity ${score}). `\n134 |           : `The names on the ${t.en} and ${r.en} look like the same person written differently (similarity ${score}). `) +\n135 |         `Officials may still reject this. Ask ${where(rule.fixWhere).en} to make them identical.`,\n136 |       messageAs:\n137 |         (initials\n138 |           ? `${t.as}ত ${r.as}ৰ সম্পূৰ্ণ নামৰ সলনি আদ্যাক্ষৰ ব্যৱহাৰ কৰা হৈছে (মিল ${score})। `\n139 |           : `${t.as} আৰু ${r.as}ৰ নাম একেজন ব্যক্তিৰ বেলেগকৈ লিখা যেন লাগে (মিল ${score})। `) +\n140 |         `বিষয়াই তথাপিও নাকচ কৰিব পাৰে। দুয়োটা হুবহু একে কৰিবলৈ ${where(rule.fixWhere).as}ত কওক।`,\n141 |       fixWhere: rule.fixWhere,\n142 |     };\n143 |   }\n144 |   return mismatchCheck(base, rule, answers, match, t, r, score);\n145 | }\n146 | \n147 | function mismatchCheck(\n148 |   base: Pick<Check, \"id\" | \"kind\" | \"docType\" | \"provenance\">,\n149 |   rule: NameCheckRule,\n150 |   answers: Answers,\n151 |   match: NameMatchResult,\n152 |   t: Bilingual,\n153 |   r: Bilingual,\n154 |   score: string,\n155 | ): Check {\n156 |   const family = rule.familyOwnerQuestion;\n157 |   if (family && answers[family.id] === true) {\n158 |     // Land owned by a spouse/minor child is allowed, but we cannot prove the relationship from a photo.\n159 |     return {\n160 |       ...base,\n161 |       match,\n162 |       result: \"needs_verification\",\n163 |       messageEn: `The owner on the ${t.en} is not you; you said it is a family member. Take proof of the relationship to ${where(rule.fixWhere).en} and confirm it is accepted.`,\n164 |       messageAs: `${t.as}ত থকা গৰাকী আপুনি নহয়; আপুনি কৈছে যে তেওঁ পৰিয়ালৰ সদস্য। সম্পৰ্কৰ প্ৰমাণ লৈ ${where(rule.fixWhere).as}ত গ্ৰহণযোগ্য নেকি নিশ্চিত কৰক।`,\n165 |       fixWhere: rule.fixWhere,\n166 |     };\n167 |   }\n168 |   return {\n169 |     ...base,\n170 |     match,\n171 |     result: \"action_required\",\n172 |     messageEn: `The name on the ${t.en} does not match the ${r.en} (similarity ${score}). Correct the ${t.en} at ${where(rule.fixWhere).en} so it matches exactly.`,\n173 |     messageAs: `${t.as}ৰ নাম ${r.as}ৰ সৈতে মিল নাই (মিল ${score})। হুবহু মিলাবলৈ ${where(rule.fixWhere).as}ত ${t.as} শুধৰাওক।`,\n174 |     fixWhere: rule.fixWhere,\n175 |   };\n176 | }\n177 | \n178 | // ---------- field formats ----------\n179 | function fieldChecks(scheme: SchemeRule, docs: readonly ExtractedDoc[]): Check[] {\n180 |   const out: Check[] = [];\n181 |   for (const f of scheme.fieldChecks) {\n182 |     const doc = findDoc(docs, f.docType);\n183 |     if (!doc) continue; // the missing-document check already covers this\n184 |     const base = { id: `field_${f.id}`, kind: \"field\" as const, docType: f.docType, provenance: f.provenance };\n185 |     const raw = doc.fields[f.field];\n186 |     const value = (raw ?? \"\").replace(/[\\s-]/g, \"\").toUpperCase();\n187 |     if (value === \"\" || isLowConfidence(doc, f.field)) {\n188 |       out.push({\n189 |         ...base,\n190 |         result: \"needs_verification\",\n191 |         messageEn: `Please type the ${f.labelEn} exactly as printed on the ${DOC_LABELS[f.docType].en}.`,\n192 |         messageAs: `${DOC_LABELS[f.docType].as}ত ছপা হোৱাৰ দৰে ${f.labelAs} হুবহু লিখক।`,\n193 |         fixWhere: \"applicant\",\n194 |       });\n195 |     } else if (new RegExp(f.pattern).test(value)) {\n196 |       out.push({ ...base, result: \"ok\", messageEn: `${cap(f.labelEn)} looks valid.`, messageAs: `${f.labelAs} সঠিক যেন লাগে।`, fixWhere: \"none\" });\n197 |     } else {\n198 |       out.push({\n199 |         ...base,\n200 |         result: \"action_required\",\n201 |         messageEn: `The ${f.labelEn} looks wrong. ${f.hintEn} Check it with ${where(f.fixWhere).en}.`,\n202 |         messageAs: `${f.labelAs} ভুল যেন লাগে। ${f.hintAs} ${where(f.fixWhere).as}ত পৰীক্ষা কৰক।`,\n203 |         fixWhere: f.fixWhere,\n204 |       });\n205 |     }\n206 |   }\n207 |   return out;\n208 | }\n209 | \n210 | \n211 | // ---------- eligibility ----------\n212 | function ageCheck(scheme: SchemeRule, docs: readonly ExtractedDoc[], asOfDate: string): Check | null {\n213 |   const range = scheme.ageRange;\n214 |   if (!range) return null;\n215 |   const base = { id: \"age\", kind: \"eligibility\" as const, provenance: range.provenance };\n216 |   const src = DOC_LABELS[range.dobFrom];\n217 |   const doc = findDoc(docs, range.dobFrom);\n218 |   const dob = doc?.fields.dob;\n219 |   const unsure = (en: string, as: string): Check => ({ ...base, result: \"needs_verification\", messageEn: en, messageAs: as, fixWhere: \"applicant\" });\n220 | \n221 |   if (!doc || !dob) {\n222 |     return unsure(\n223 |       `We need the date of birth from the ${src.en} to check the age limit (${range.min}–${range.max}).`,\n224 |       `বয়সৰ সীমা (${range.min}–${range.max}) পৰীক্ষা কৰিবলৈ ${src.as}ৰ জন্মৰ তাৰিখ লাগিব।`,\n225 |     );\n226 |   }\n227 |   if (!isIsoDate(dob) || dob > asOfDate || isLowConfidence(doc, \"dob\")) {\n228 |     return unsure(\n229 |       `Please confirm the date of birth on the ${src.en} (we could not read it reliably).`,\n230 |       `${src.as}ত থকা জন্মৰ তাৰিখটো নিশ্চিত কৰক (আমি নিৰ্ভৰযোগ্যভাৱে পঢ়িব নোৱাৰিলোঁ)।`,\n231 |     );\n232 |   }\n233 |   const age = ageOn(dob, asOfDate);\n234 |   if (age >= range.min && age <= range.max) {\n235 |     return {\n236 |       ...base,\n237 |       result: \"ok\",\n238 |       messageEn: `Age ${age} on ${asOfDate} is within ${range.min}–${range.max}.`,\n239 |       messageAs: `${asOfDate} তাৰিখত বয়স ${age}, যি ${range.min}–${range.max}ৰ ভিতৰত।`,\n240 |       fixWhere: \"none\",\n241 |     };\n242 |   }\n243 |   const above = age > range.max;\n244 |   const verifiedRule = range.provenance.status === \"verified\";\n245 |   return {\n246 |     ...base,\n247 |     result: verifiedRule ? \"action_required\" : \"needs_verification\",\n248 |     messageEn:\n249 |       `Age ${age} on ${asOfDate} is outside the ${range.min}–${range.max} limit for this scheme.` +\n250 |       (above && range.aboveMaxHintEn ? ` ${range.aboveMaxHintEn}` : \"\"),\n251 |     messageAs:\n252 |       `${asOfDate} তাৰিখত বয়স ${age}, যি এই আঁচনিৰ ${range.min}–${range.max} সীমাৰ বাহিৰত।` +\n253 |       (above && range.aboveMaxHintAs ? ` ${range.aboveMaxHintAs}` : \"\"),\n254 |     fixWhere: verifiedRule ? \"none\" : scheme.confirmAt,\n255 |   };\n256 | }\n257 | \n258 | const confirmPlace = (scheme: SchemeRule, q: Question): FixWhere => q.fixWhere ?? scheme.confirmAt;\n259 | \n260 | function notAnswered(scheme: SchemeRule, id: string, q: Question): Check {\n261 |   const w = where(confirmPlace(scheme, q));\n262 |   return {\n263 |     id,\n264 |     kind: \"eligibility\",\n265 |     result: \"needs_verification\",\n266 |     messageEn: `Please answer: ${q.textEn} (If unsure, ask at ${w.en}.)`,\n267 |     messageAs: `অনুগ্ৰহ কৰি উত্তৰ দিয়ক: ${q.textAs} (নিশ্চিত নহ'লে ${w.as}ত সোধক।)`,\n268 |     fixWhere: confirmPlace(scheme, q),\n269 |     provenance: q.provenance,\n270 |   };\n271 | }\n272 | \n273 | /** A criterion that went against the applicant: definitive only if the rule is verified. */\n274 | function failed(scheme: SchemeRule, id: string, q: Question, en: string, as: string): Check {\n275 |   if (q.provenance.status === \"verified\") {\n276 |     return {\n277 |       id,\n278 |       kind: \"eligibility\",\n279 |       result: \"action_required\",\n280 |       messageEn: `${en} This makes you not eligible for ${scheme.nameEn}.`,\n281 |       messageAs: `${as} ইয়াৰ বাবে আপুনি ${scheme.nameAs}ৰ বাবে যোগ্য নহয়।`,\n282 |       fixWhere: \"none\",\n283 |       provenance: q.provenance,\n284 |     };\n285 |   }\n286 |   const w = where(confirmPlace(scheme, q));\n287 |   return {\n288 |     id,\n289 |     kind: \"eligibility\",\n290 |     result: \"needs_verification\",\n291 |     messageEn: `${en} This may make you ineligible. Confirm at ${w.en}. Ask whether \"${q.labelEn}\" still applies under the current rules.`,\n292 |     messageAs: `${as} ইয়াৰ বাবে আপুনি অযোগ্য হ'ব পাৰে। ${w.as}ত নিশ্চিত কৰক। বৰ্তমানৰ নিয়মত \"${q.labelAs}\" এতিয়াও প্ৰযোজ্য নেকি সোধক।`,\n293 |     fixWhere: confirmPlace(scheme, q),\n294 |     provenance: q.provenance,\n295 |   };\n296 | }\n297 | \n298 | function passed(id: string, q: Question, en = q.labelEn, as = q.labelAs): Check {\n299 |   return {\n300 |     id,\n301 |     kind: \"eligibility\",\n302 |     result: \"ok\",\n303 |     messageEn: `Checked: ${en}.`,\n304 |     messageAs: `পৰীক্ষা কৰা হ'ল: ${as}।`,\n305 |     fixWhere: \"none\",\n306 |     provenance: q.provenance,\n307 |   };\n308 | }\n309 | \n310 | \n311 | function questionChecks(scheme: SchemeRule, answers: Answers): Check[] {\n312 |   const out: Check[] = [];\n313 |   for (const q of scheme.requirements) {\n314 |     const id = `req_${q.id}`;\n315 |     const a = answers[q.id];\n316 |     if (a === undefined) out.push(notAnswered(scheme, id, q));\n317 |     else if (a) out.push(passed(id, q));\n318 |     else out.push(failed(scheme, id, q, `You answered no to: ${q.textEn}`, `আপুনি \"নহয়\" উত্তৰ দিছে: ${q.textAs}`));\n319 |   }\n320 | \n321 |   const anyOf = scheme.eligibilityAnyOf;\n322 |   if (anyOf.length > 0) {\n323 |     const yes = anyOf.find((q) => answers[q.id] === true);\n324 |     const unanswered = anyOf.find((q) => answers[q.id] === undefined);\n325 |     if (yes) out.push(passed(\"anyof\", yes));\n326 |     else if (unanswered) out.push(notAnswered(scheme, \"anyof\", unanswered));\n327 |     else {\n328 |       const listEn = anyOf.map((q) => q.labelEn).join(\"; \");\n329 |       const listAs = anyOf.map((q) => q.labelAs).join(\"; \");\n330 |       // Definitive only if every any-of criterion is verified.\n331 |       const allVerified = anyOf.every((q) => q.provenance.status === \"verified\");\n332 |       const rep = allVerified ? anyOf[0] : (anyOf.find((q) => q.provenance.status === \"provisional\") ?? anyOf[0]);\n333 |       out.push(failed(scheme, \"anyof\", rep, `None of these applies to you: ${listEn}.`, `এইবোৰৰ এটাও আপোনাৰ ক্ষেত্ৰত প্ৰযোজ্য নহয়: ${listAs}।`));\n334 |     }\n335 |   }\n336 | \n337 |   for (const q of scheme.exclusions) {\n338 |     const id = `excl_${q.id}`;\n339 |     const a = answers[q.id];\n340 |     if (a === undefined) out.push(notAnswered(scheme, id, q));\n341 |     else if (!a) out.push(passed(id, q, `not ${q.labelEn}`, `${q.labelAs}: নহয়`));\n342 |     else out.push(failed(scheme, id, q, `You answered yes: ${q.labelEn}.`, `আপুনি \"হয়\" উত্তৰ দিছে: ${q.labelAs}।`));\n343 |   }\n344 |   return out;\n345 | }\n346 | \n347 | // ---------- external facts (never provable from a photo) ----------\n348 | function externalChecks(scheme: SchemeRule): Check[] {\n349 |   return scheme.externalChecks.map((e) => ({\n350 |     id: `ext_${e.id}`,\n351 |     kind: \"external\",\n352 |     result: \"needs_verification\",\n353 |     messageEn: `We cannot see this from a photo: ${e.labelEn}. ${e.howEn}`,\n354 |     messageAs: `ফটোৰ পৰা আমি এইটো চাব নোৱাৰোঁ: ${e.labelAs}। ${e.howAs}`,\n355 |     fixWhere: e.fixWhere,\n356 |     provenance: e.provenance,\n357 |   }));\n358 | }\n359 | \n360 | // ---------- verdicts ----------\n361 | function eligibilityOf(checks: readonly Check[]): Eligibility {\n362 |   const elig = checks.filter((c) => c.kind === \"eligibility\");\n363 |   if (elig.some((c) => c.result === \"action_required\" && c.provenance.status === \"verified\")) return \"not_eligible\";\n364 |   if (elig.some((c) => c.result !== \"ok\" && c.result !== \"not_applicable\")) return \"needs_verification\";\n365 |   return \"likely_eligible\";\n366 | }\n367 | \n368 | function readinessOf(checks: readonly Check[]): Readiness {\n369 |   if (checks.some((c) => c.result === \"action_required\")) return \"action_required\";\n370 |   // External facts are always \"confirm\", so on their own they never block ready_for_review.\n371 |   if (checks.some((c) => c.kind !== \"external\" && c.result === \"needs_verification\")) return \"needs_verification\";\n372 |   return \"ready_for_review\";\n373 | }\n374 | \n375 | /**\n376 |  * Evaluates a scheme against the extracted documents and yes/no answers on an explicit date.\n377 |  * Deterministic: the same inputs always give the same report.\n378 |  */\n379 | export function evaluate(scheme: SchemeRule, docs: readonly ExtractedDoc[], answers: Answers, asOfDate: string): Report {\n380 |   assertIsoDate(asOfDate, \"asOfDate\");\n381 |   const age = ageCheck(scheme, docs, asOfDate);\n382 |   const checks: Check[] = [\n383 |     ...mandatoryDocChecks(scheme, docs),\n384 |     ...scheme.nameChecks.map((rule) => nameCheck(scheme, rule, docs, answers)),\n385 |     ...fieldChecks(scheme, docs),\n386 |     ...(age ? [age] : []),\n387 |     ...questionChecks(scheme, answers),\n388 |     ...externalChecks(scheme),\n389 |   ];\n390 | \n391 |   return {\n392 |     schemeId: scheme.id,\n393 |     schemeVersion: scheme.version,\n394 |     asOfDate,\n395 |     eligibility: eligibilityOf(checks),\n396 |     readiness: readinessOf(checks),\n397 |     checks,\n398 |     benefit: benefitOn(scheme, asOfDate),\n399 |     supportingDocs: scheme.supportingDocs.map((d) => ({\n400 |       docType: d.docType,\n401 |       labelEn: DOC_LABELS[d.docType].en,\n402 |       labelAs: DOC_LABELS[d.docType].as,\n403 |       present: findDoc(docs, d.docType) !== undefined,\n404 |       provenance: d.provenance,\n405 |     })),\n406 |     supportingDocsNoteEn: scheme.supportingDocsNoteEn,\n407 |     supportingDocsNoteAs: scheme.supportingDocsNoteAs,\n408 |     disclaimerEn: DISCLAIMER.en,\n409 |     disclaimerAs: DISCLAIMER.as,\n410 |   };\n411 | }\n412 | ","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\core\\schemes\\index.ts","result":" 1 | // Scheme registry: built-in rule packs plus versions registered at runtime (T3 agent). Pure, in-memory.\n 2 | // Old versions are kept; getScheme(id) returns the newest.\n 3 | import { SchemeRule, type Question, type SchemeRuleInput } from \"../types\";\n 4 | import { nsapWidow } from \"./nsap-widow\";\n 5 | import { orunodoi3 } from \"./orunodoi-3\";\n 6 | import { pmKisan } from \"./pm-kisan\";\n 7 | \n 8 | const registry = new Map<string, SchemeRule[]>();\n 9 | \n10 | function compareVersions(a: string, b: string): number {\n11 |   const pa = a.split(\".\").map(Number);\n12 |   const pb = b.split(\".\").map(Number);\n13 |   for (let i = 0; i < 3; i++) {\n14 |     if (pa[i] !== pb[i]) return pa[i] - pb[i];\n15 |   }\n16 |   return 0;\n17 | }\n18 | \n19 | /** Validates and adds a scheme version. Throws if invalid or the same id+version exists. */\n20 | export function registerScheme(rule: SchemeRuleInput): SchemeRule {\n21 |   const parsed = SchemeRule.parse(rule);\n22 |   const versions = registry.get(parsed.id) ?? [];\n23 |   if (versions.some((v) => v.version === parsed.version)) {\n24 |     throw new Error(`scheme ${parsed.id}@${parsed.version} is already registered`);\n25 |   }\n26 |   versions.push(parsed);\n27 |   versions.sort((a, b) => compareVersions(a.version, b.version));\n28 |   registry.set(parsed.id, versions);\n29 |   return parsed;\n30 | }\n31 | \n32 | /** The newest version, or a specific one. */\n33 | export function getScheme(id: string, version?: string): SchemeRule | undefined {\n34 |   const versions = registry.get(id);\n35 |   if (!versions || versions.length === 0) return undefined;\n36 |   if (version === undefined) return versions[versions.length - 1];\n37 |   return versions.find((v) => v.version === version);\n38 | }\n39 | \n40 | /** The newest version of every scheme. */\n41 | export function listSchemes(): SchemeRule[] {\n42 |   return [...registry.values()].map((v) => v[v.length - 1]);\n43 | }\n44 | \n45 | export function listSchemeVersions(id: string): string[] {\n46 |   return (registry.get(id) ?? []).map((v) => v.version);\n47 | }\n48 | \n49 | /** Every yes/no question the user should answer for a scheme, in display order. */\n50 | export function questionsFor(scheme: SchemeRule): Question[] {\n51 |   return [\n52 |     ...scheme.requirements,\n53 |     ...scheme.eligibilityAnyOf,\n54 |     ...scheme.exclusions,\n55 |     ...scheme.nameChecks.flatMap((n) => (n.familyOwnerQuestion ? [n.familyOwnerQuestion] : [])),\n56 |   ];\n57 | }\n58 | \n59 | for (const s of [pmKisan, orunodoi3, nsapWidow]) registerScheme(s);","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\core\\aadhaar.ts","result":"1 | // Aadhaar masking: only the last 4 digits are ever shown. Pure.\n2 | \n3 | /** \"1234 5678 9012\" → \"XXXX XXXX 9012\". Fewer than 4 digits → no digits at all. */\n4 | export function maskAadhaar(input: string): string {\n5 |   const digits = input.replace(/\\D/g, \"\");\n6 |   if (digits.length < 4) return \"XXXX XXXX XXXX\";\n7 |   return `XXXX XXXX ${digits.slice(-4)}`;\n8 | }","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\core\\benefit.ts","result":" 1 | // Benefit amount on a given date, with time-bounded overrides. Pure.\n 2 | import { assertIsoDate } from \"./dates\";\n 3 | import type { BenefitOn, SchemeRule } from \"./types\";\n 4 | \n 5 | /**\n 6 |  * The benefit that applies on `date` (YYYY-MM-DD). Overrides are inclusive\n 7 |  * date windows; when several match, the last one listed wins.\n 8 |  * `total` is null whenever the state top-up is unconfirmed (never show an unconfirmed total).\n 9 |  */\n10 | export function benefitOn(scheme: SchemeRule, date: string): BenefitOn {\n11 |   assertIsoDate(date, \"date\");\n12 |   const base = scheme.benefit;\n13 |   const override = [...base.overrides].reverse().find((o) => o.from <= date && date <= o.to);\n14 | \n15 |   const centralShare = override?.centralShare ?? base.centralShare;\n16 |   const stateTopUp = override && override.stateTopUp !== undefined ? override.stateTopUp : base.stateTopUp;\n17 | \n18 |   return {\n19 |     centralShare,\n20 |     stateTopUp,\n21 |     total: stateTopUp === null ? null : centralShare + stateTopUp,\n22 |     period: base.period,\n23 |     ...(base.instalments !== undefined ? { instalments: base.instalments } : {}),\n24 |     isOverride: override !== undefined,\n25 |     ...(override ? { noteEn: override.noteEn, noteAs: override.noteAs } : {}),\n26 |     provenance: override ? override.provenance : base.provenance,\n27 |   };\n28 | }","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\core\\dates.ts","result":" 1 | // ISO calendar dates (YYYY-MM-DD) without time zones. Pure.\n 2 | \n 3 | const ISO_DATE = /^(\\d{4})-(\\d{2})-(\\d{2})$/;\n 4 | \n 5 | export interface YMD {\n 6 |   y: number;\n 7 |   m: number;\n 8 |   d: number;\n 9 | }\n10 | \n11 | /** Parses a real calendar date (rejects 2026-02-30, 2026-13-01, other formats). */\n12 | export function parseIsoDate(s: string): YMD | null {\n13 |   const m = ISO_DATE.exec(s);\n14 |   if (!m) return null;\n15 |   const y = Number(m[1]);\n16 |   const mo = Number(m[2]);\n17 |   const d = Number(m[3]);\n18 |   const t = new Date(Date.UTC(y, mo - 1, d));\n19 |   if (t.getUTCFullYear() !== y || t.getUTCMonth() !== mo - 1 || t.getUTCDate() !== d) return null;\n20 |   return { y, m: mo, d };\n21 | }\n22 | \n23 | export function isIsoDate(s: string): boolean {\n24 |   return parseIsoDate(s) !== null;\n25 | }\n26 | \n27 | /** Throws a RangeError unless `s` is a real YYYY-MM-DD date. */\n28 | export function assertIsoDate(s: string, what = \"date\"): YMD {\n29 |   const p = parseIsoDate(s);\n30 |   if (!p) throw new RangeError(`${what} must be a real date as YYYY-MM-DD, got \"${s}\"`);\n31 |   return p;\n32 | }","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\core\\appInfo.ts","result":" 1 | // Pure constants shared by the UI and tests. No UI, network or database imports.\n 2 | \n 3 | // Assamese is the default language; English is the toggle (brief v2).\n 4 | \n 5 | /** BCP 47 language tag for <html lang>. */\n 6 | export const APP_LANG = \"as\";\n 7 | \n 8 | export const APP_NAME = \"KaagazCheck\";\n 9 | export const APP_NAME_AS = \"কাগজ চেক\";\n10 | export const APP_TITLE = `${APP_NAME}: ${APP_N