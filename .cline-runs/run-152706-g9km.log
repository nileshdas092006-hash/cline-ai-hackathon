{"ts":"2026-10-10T11:09:31.423Z","type":"agent_event","event":{"type":"content_end","contentType":"tool","toolName":"read_files","toolCallId":"toolu_01QFViPf41ZDjLAkoWRWE5pb","output":[{"query":"C:\\Dev\\cline hackathon\\build\\scripts\\smoke.mjs","result":" 1 | // Manual smoke test against a running server (not part of `npm test`; never prints secrets).\n 2 | // Usage: node scripts/smoke.mjs [baseUrl]   (default http://localhost:3000)\n 3 | const base = process.argv[2] ?? \"http://localhost:3000\";\n 4 | \n 5 | const docsA = [\n 6 |   { docType: \"aadhaar\", fields: { name: \"Ramesh Kumar Sharma\", dob: \"1975-03-12\", aadhaarLast4: \"4821\" }, confidence: { name: 0.97 } },\n 7 |   { docType: \"bank_passbook\", fields: { name: \"RAMESH KUMAR SHARMA\", accountNo: \"30012345678\", ifsc: \"SBIN0001234\" }, confidence: {} },\n 8 |   { docType: \"land_record\", fields: { ownerNames: [\"Ramesh Kumar Sharma\"] }, confidence: {} },\n 9 | ];\n10 | const pmNo = { holds_constitutional_post: false, govt_employee: false, income_tax_payer: false, practising_professional: false, pension_10k_plus: false };\n11 | const cases = {\n12 |   A: { schemeId: \"pm-kisan\", docs: docsA, answers: pmNo },\n13 |   B: {\n14 |     schemeId: \"pm-kisan\",\n15 |     docs: [docsA[0], { ...docsA[1], fields: { ...docsA[1].fields, name: \"RAMESH KR SHARMA\" } }, { ...docsA[2], fields: { ownerNames: [\"Rameshwar Sharma\"] } }],\n16 |     answers: pmNo,\n17 |   },\n18 |   C: {\n19 |     schemeId: \"nsap-widow\",\n20 |     docs: [\n21 |       { docType: \"aadhaar\", fields: { name: \"Smt. Sunita Devi\", dob: \"1968-07-01\", aadhaarLast4: \"7315\" }, confidence: {} },\n22 |       { docType: \"bank_passbook\", fields: { name: \"SUNITA DEVI\", accountNo: \"40098765432\", ifsc: \"UTBI0ABC123\" }, confidence: {} },\n23 |       { docType: \"bpl_proof\", fields: {}, confidence: {} },\n24 |     ],\n25 |     answers: { is_widow: true, bpl_household: true },\n26 |   },\n27 | };\n28 | \n29 | async function post(path, body) {\n30 |   const res = await fetch(`${base}${path}`, { method: \"POST\", headers: { \"Content-Type\": \"application/json\" }, body: JSON.stringify(body) });\n31 |   return { status: res.status, json: await res.json() };\n32 | }\n33 | \n34 | const html = await (await fetch(base)).text();\n35 | console.log(\"home:\", {\n36 |   langAs: html.includes('lang=\"as\"'),\n37 |   assameseTitle: html.includes(\"আপুনি কোনটো আঁচনিৰ বাবে আবেদন কৰিব?\"),\n38 |   flagship: html.includes(\"মুখ্য ডেমো\"),\n39 | });\n40 | \n41 | for (const [id, body] of Object.entries(cases)) {\n42 |   const { status, json } = await post(\"/api/check\", { ...body, asOfDate: \"2026-10-10\" });\n43 |   const notOk = json.checks?.filter((c) => c.result !== \"ok\" && c.result !== \"not_applicable\").map((c) => `${c.id}:${c.result}`);\n44 |   console.log(`check ${id}:`, status, json.eligibility, json.readiness, notOk);\n45 | }\n46 | \n47 | // A tiny 1x1 PNG: not a real document. Shows the gateway path (model or graceful fallback).\n48 | const png = \"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=\";\n49 | const ex = await post(\"/api/extract\", { image: png, docType: \"aadhaar\" });\n50 | console.log(\"extract (1x1 test image):\", ex.status, JSON.stringify(ex.json));\n51 | const bad = await post(\"/api/extract\", { image: \"nope\" });\n52 | console.log(\"extract (junk):\", bad.status, JSON.stringify(bad.json));","success":true}],"durationMs":6}}
