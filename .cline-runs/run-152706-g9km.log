 |       {b.isOverride && (b.noteEn || b.noteAs) && (\n40 |         <p className=\"mt-2 text-sm text-violet-900\">{pick(lang, b.noteEn ?? \"\", b.noteAs ?? \"\")}</p>\n41 |       )}\n42 |     </Card>\n43 |   );\n44 | }","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\app\\_components\\SchemeStep.tsx","result":" 1 | \"use client\";\n 2 | import type { SchemeView } from \"@/core/catalog\";\n 3 | import { formatInr } from \"@/core/reportView\";\n 4 | import { STRINGS, type Lang } from \"@/i18n\";\n 5 | import { Badge } from \"./ui\";\n 6 | \n 7 | export function SchemeStep({\n 8 |   lang,\n 9 |   catalog,\n10 |   selected,\n11 |   onChoose,\n12 | }: {\n13 |   lang: Lang;\n14 |   catalog: SchemeView[];\n15 |   selected: string | null;\n16 |   onChoose: (id: string) => void;\n17 | }) {\n18 |   const t = STRINGS[lang];\n19 |   return (\n20 |     <ul className=\"flex flex-col gap-3\">\n21 |       {catalog.map((s) => {\n22 |         const b = s.benefit;\n23 |         const amount = b.centralShare + (b.stateTopUp ?? 0);\n24 |         const period = b.period === \"month\" ? t.report.perMonth : t.report.perYear;\n25 |         return (\n26 |           <li key={s.id}>\n27 |             <button\n28 |               type=\"button\"\n29 |               onClick={() => onChoose(s.id)}\n30 |               aria-current={selected === s.id ? \"true\" : undefined}\n31 |               className={`flex w-full flex-col gap-1 rounded-2xl border-2 bg-white p-4 text-left shadow-sm hover:border-teal-600 focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-teal-500 ${\n32 |                 selected === s.id ? \"border-teal-700\" : s.flagship ? \"border-teal-300\" : \"border-zinc-200\"\n33 |               }`}\n34 |             >\n35 |               {s.flagship && (\n36 |                 <span>\n37 |                   <Badge tone=\"teal\">★ {t.scheme.flagship}</Badge>\n38 |                 </span>\n39 |               )}\n40 |               <span className=\"text-lg font-semibold leading-snug\">{lang === \"as\" ? s.nameAs : s.nameEn}</span>\n41 |               <span className=\"text-sm text-zinc-600\" lang={lang === \"as\" ? \"en\" : \"as\"}>\n42 |                 {lang === \"as\" ? s.nameEn : s.nameAs}\n43 |               </span>\n44 |               <span className=\"text-base text-zinc-800\">\n45 |                 {formatInr(amount)}\n46 |                 {b.stateTopUp === null ? \"+\" : \"\"} {period}\n47 |               </span>\n48 |               <span className=\"mt-1 font-semibold text-teal-800\">{t.scheme.choose} →</span>\n49 |             </button>\n50 |           </li>\n51 |         );\n52 |       })}\n53 |     </ul>\n54 |   );\n55 | }","success":true}],"durationMs":14}}
