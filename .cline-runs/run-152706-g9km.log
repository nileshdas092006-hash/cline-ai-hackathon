---------\n213 | function ageCheck(scheme: SchemeRule, docs: readonly ExtractedDoc[], asOfDate: string): Check | null {\n214 |   const range = scheme.ageRange;","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\core\\evaluate.ts:298-330","result":"298 | \n299 | function passed(id: string, q: Question, en = q.labelEn, as = q.labelAs): Check {\n300 |   return {\n301 |     id,\n302 |     kind: \"eligibility\",\n303 |     result: \"ok\",\n304 |     messageEn: `Checked: ${en}.`,\n305 |     messageAs: `পৰীক্ষা কৰা হ'ল: ${as}।`,\n306 |     fixWhere: \"none\",\n307 |     provenance: q.provenance,\n308 |   };\n309 | }\n310 | \n311 | \n312 | function questionChecks(scheme: SchemeRule, answers: Answers): Check[] {\n313 |   const out: Check[] = [];\n314 |   for (const q of scheme.requirements) {\n315 |     const id = `req_${q.id}`;\n316 |     const a = answers[q.id];\n317 |     if (a === undefined) out.push(notAnswered(scheme, id, q));\n318 |     else if (a) out.push(passed(id, q));\n319 |     else out.push(failed(scheme, id, q, `You answered no to: ${q.textEn}`, `আপুনি \"নহয়\" উত্তৰ দিছে: ${q.textAs}`));\n320 |   }\n321 | \n322 |   const anyOf = scheme.eligibilityAnyOf;\n323 |   if (anyOf.length > 0) {\n324 |     const yes = anyOf.find((q) => answers[q.id] === true);\n325 |     const unanswered = anyOf.find((q) => answers[q.id] === undefined);\n326 |     if (yes) out.push(passed(\"anyof\", yes));\n327 |     else if (unanswered) out.push(notAnswered(scheme, \"anyof\", unanswered));\n328 |     else {\n329 |       const listEn = anyOf.map((q) => q.labelEn).join(\"; \");\n330 |       const listAs = anyOf.map((q) => q.labelAs).join(\"; \");","success":true}],"durationMs":12}}
