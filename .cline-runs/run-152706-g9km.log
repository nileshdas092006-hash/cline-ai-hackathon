p-widow\",\n10 |   version: \"2.0.0\",\n11 |   nameEn: \"Widow Pension (IGNWPS, NSAP)\",\n12 |   nameAs: \"বিধৱা পেঞ্চন (IGNWPS, NSAP)\",\n13 |   confirmAt: \"block_office\",\n14 |   benefit: {\n15 |     centralShare: 300,\n16 |     stateTopUp: null,\n17 |     period: \"month\",\n18 |     provenance: verified(SOURCES.ignwps, \"Central assistance ₹300 per month for widows aged 40–79\"),\n19 |   },\n20 |   mandatoryDocs: [\n21 |     { docType: \"aadhaar\", fixWhere: \"aadhaar_centre\", provenance: docs },\n22 |     { docType: \"death_certificate\", fixWhere: \"registrar\", provenance: docs },\n23 |     { docType: \"bank_passbook\", fixWhere: \"bank\", provenance: docs },\n24 |     { docType: \"bpl_proof\", fixWhere: \"block_office\", provenance: docs },\n25 |   ],\n26 |   nameReference: \"aadhaar\",\n27 |   nameChecks: [{ docType: \"bank_passbook\", field: \"name\", fixWhere: \"bank\", provenance: docs }],\n28 |   ageRange: {\n29 |     min: 40,\n30 |     max: 79,\n31 |     dobFrom: \"aadhaar\",\n32 |     aboveMaxHintEn: \"At 80 or older, ask about the Old Age Pension (IGNOAPS) instead.\",\n33 |     aboveMaxHintAs: \"৮০ বছৰ বা তাতকৈ বেছি হ'লে, ইয়াৰ সলনি বৃদ্ধ পেঞ্চন (IGNOAPS)ৰ বিষয়ে সোধক।\",\n34 |     provenance: verified(SOURCES.ignwps, \"Eligible age 40–79 years\"),\n35 |   },\n36 |   requirements: [\n37 |     {\n38 |       id: \"is_widow\",\n39 |       labelEn: \"widow\",\n40 |       labelAs: \"বিধৱা\",\n41 |       textEn: \"Are you a widow (your husband has died)?\",\n42 |       textAs: \"আপুনি বিধৱা নেকি (আপোনাৰ স্বামীৰ মৃত্যু হৈছে)?\",\n43 |       fixWhere: \"block_office\",\n44 |       provenance: verified(SOURCES.ignwps, \"Applicant must be a widow\"),\n45 |     },\n46 |     {\n47 |       id: \"bpl_household\",\n48 |       labelEn: \"household is below the poverty line (BPL)\",\n49 |       labelAs: \"পৰিয়াল দৰিদ্ৰ সীমাৰেখাৰ তলত (BPL)\",\n50 |       textEn: \"Is your household below the poverty line (BPL) as per Government of India criteria?\",\n51 |       textAs: \"ভাৰত চৰকাৰৰ মাপকাঠী অনুসৰি আপোনাৰ পৰিয়াল দৰিদ্ৰ সীমাৰেখাৰ তলত (BPL) নেকি?\",\n52 |       fixWhere: \"block_office\",\n53 |       provenance: verified(SOURCES.ignwps, \"Household below the poverty line as per GoI criteria\"),\n54 |     },\n55 |   ],\n56 |   notes: [\n57 |     {\n58 |       id: \"state_top_up_unconfirmed\",\n59 |       textEn: \"₹300 a month from the central government, plus any state top-up; confirm the state amount locally.\",\n60 |       textAs: \"কেন্দ্ৰীয় চৰকাৰৰ পৰা মাহে ₹৩০০, লগতে ৰাজ্যৰ যিকোনো অতিৰিক্ত ধন; ৰাজ্যৰ ধনৰ পৰিমাণ স্থানীয়ভাৱে নিশ্চিত কৰক।\",\n61 |       provenance: provisional(SOURCES.ignwps, \"Assam state top-up not confirmed\"),\n62 |     },\n63 |   ],\n64 | });","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\core\\evaluate.ts","result":"  1 | // The deterministic rule engine: evaluate(scheme, docs, answers, asOfDate) → Report. Pure.\n  2 | // Two verdicts (eligibility, readiness). Provisional rules and external facts never decide; they\n  3 | // return needs_verification. A fuzzy name score never becomes `ok`; only `same` does.\n  4 | import { ageOn } from \"./age\";\n  5 | import { benefitOn } from \"./benefit\";\n  6 | import { assertIsoDate, isIsoDate } from \"./dates\";\n  7 | import { DISCLAIMER, DOC_LABELS, FIX_WHERE_LABELS, type Bilingual } from \"./labels\";\n  8 | import { bestNameMatch, normalizeName } from \"./nameMatch\";\n  9 | import { LOW_CONFIDENCE_THRESHOLD } from \"./thresholds\";\n 10 | import type {\n 11 |   Answers,\n 12 |   Check,\n 13 |   DocType,\n 14 |   Eligibility,\n 15 |   ExtractedDoc,\n 16 |   FieldName,\n 17 |   FixWhere,\n 18 |   NameCheckRule,\n 19 |   NameMatchResult,\n 20 |   Question,\n 21 |   Readiness,\n 22 |   Report,\n 23 |   SchemeRule,\n 24 | } from \"./types\";\n 25 | \n 26 | /** Re-exported: a field read with confidence below this must be confirmed by the user. */\n 27 | export { LOW_CONFIDENCE_THRESHOLD };\n 28 | \n 29 | const where = (w: FixWhere): Bilingual => FIX_WHERE_LABELS[w];\n 30 | const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);\n 31 | \n 32 | function findDoc(docs: readonly ExtractedDoc[], docType: DocType): ExtractedDoc | undefined {\n 33 |   return docs.find((d) => d.docType === docType);\n 34 | }\n 35 | \n 36 | function isLowConfidence(doc: ExtractedDoc, field: FieldName): boolean {\n 37 |   const c = doc.confidence[field];\n 38 |   return c !== undefined && c < LOW_CONFIDENCE_THRESHOLD;\n 39 | }\n 40 | \n 41 | // ---------- documents ----------\n 42 | function mandatoryDocChecks(scheme: SchemeRule, docs: readonly ExtractedDoc[]): Check[] {\n 43 |   return scheme.mandatoryDocs.map((req): Check => {\n 44 |     const label = DOC_LABELS[req.docType];\n 45 |     const base = { id: `doc_${req.docType}`, kind: \"document\" as const, docType: req.docType, provenance: req.provenance };\n 46 |     if (findDoc(docs, req.docType)) {\n 47 |       return {\n 48 |         ...base,\n 49 |         result: \"ok\",\n 50 |         messageEn: `${cap(label.en)} added.`,\n 51 |         messageAs: `${label.as} যোগ কৰা হৈছে।`,\n 52 |         fixWhere: \"none\",\n 53 |       };\n 54 |     }\n 55 |     const commonly = req.provenance.status === \"provisional\";\n 56 |     return {\n 57 |       ...base,\n 58 |       result: \"action_required\",\n 59 |       messageEn:\n 60 |         `Missing: ${label.en}. Get it from ${where(req.fixWhere).en} and add it before you apply.` +\n 61 |         (commonly ? \" (Commonly required; confirm locally.)\" : \"\"),\n 62 |       messageAs:\n 63 |         `নাই: ${label.as}। আবেদন কৰাৰ আগতে ${where(req.fixWhere).as}ৰ পৰা লৈ যোগ কৰক।` +\n 64 |         (commonly ? \" (সাধাৰণতে লাগে; স্থানীয়ভাৱে নিশ্চিত কৰক।)\" : \"\"),\n 65 |       fixWhere: req.fixWhere,\n 66 |     };\n 67 |   });\n 68 | }\n 69 | \n 70 | // ---------- names ----------\n 71 | function nameCheck(scheme: SchemeRule, rule: NameCheckRule, docs: readonly ExtractedDoc[], answers: Answers): Check {\n 72 |   const target = findDoc(docs, rule.docType);\n 73 |   const reference = findDoc(docs, scheme.nameReference);\n 74 |   const t = DOC_LABELS[rule.docType];\n 75 |   const r = DOC_LABELS[scheme.nameReference];\n 76 |   const base = { id: `name_${rule.docType}`, kind: \"name\" as const, docType: rule.docType, provenance: rule.provenance };\n 77 | \n 78 |   if (!target || !reference) {\n 79 |     const missing = target ? r : t;\n 80 |     return {\n 81 |       ...base,\n 82 |       result: \"not_applicable\",\n 83 |       messageEn: `Name on the ${t.en} not compared: the ${missing.en} is not added.`,\n 84 |       messageAs: `${t.as}ৰ নাম মিলোৱা হোৱা নাই: ${missing.as} যোগ কৰা হোৱা নাই।`,\n 85 |       fixWhere: \"none\",\n 86 |     };\n 87 |   }\n 88 | \n 89 |   const refName = reference.fields.name ?? \"\";\n 90 |   const names = rule.field === \"ownerNames\" ? (target.fields.ownerNames ?? []) : [target.fields.name ?? \"\"];\n 91 |   const readable = names.filter((n) => normalizeName(n) !== \"\");\n 92 |   if (normalizeName(refName) === \"\" || readable.length === 0) {\n 93 |     const which = normalizeName(refName) === \"\" ? r : t;\n 94 |     return {\n 95 |       ...base,\n 96 |       result: \"needs_verification\",\n 97 |       messageEn: `We could not read the name on the ${which.en}. Please type it exactly as printed.`,\n 98 |       messageAs: `${which.as}ত থকা নামটো আমি পঢ়িব নোৱাৰিলোঁ। ছপা হোৱাৰ দৰে হুবহু লিখক।`,\n 99 |       fixWhere: \"applicant\",\n100 |     };\n101 |   }\n102 | \n103 |   const match = bestNameMatch(refName, readable);\n104 |   const score = match.score.toFixed(2);\n105 |   if (isLowConfidence(reference, \"name\") || isLowConfidence(target, rule.field)) {\n106 |     return {\n107 |       ...base,\n108 |       match,\n109 |       result: \"needs_verification\",\n110 |       messageEn: `We are not sure we read the name on the ${t.en} or ${r.en} correctly. Please check it and correct it if needed.`,\n111 |       messageAs: `${t.as} বা ${r.as}ত থকা নামটো আমি শুদ্ধকৈ পঢ়িছোঁ নে নাই নিশ্চিত নহয়। পৰীক্ষা কৰি প্ৰয়োজন হ'লে শুধৰাওক।`,\n112 |       fixWhere: \"applicant\",\n113 |     };\n114 |   }\n115 | \n116 |   if (match.level === \"same\") {\n117 |     return {\n118 |       ...base,\n119 |       match,\n120 |       result: \"ok\",\n121 |       messageEn: `Name on the ${t.en} matches the ${r.en}.`,\n122 |       messageAs: `${t.as}ৰ নাম ${r.as}ৰ সৈতে মিলে।`,\n123 |       fixWhere: \"none\",\n124 |     };\n125 |   }\n126 |   if (match.level === \"possible_match\" || match.level === \"initials_only\") {\n127 |     const initials = match.level === \"initials_only\";\n128 |     return {\n129 |       ...base,\n130 |       match,\n131 |       result: \"needs_verification\",\n132 |       messageEn:\n133 |         (initials\n134 |           ? `The name on the ${t.en} uses initials instead of the full name on the ${r.en} (similarity ${score}). `\n135 |           : `The names on the ${t.en} and ${r.en} look like the same person written differently (similarity ${score}). `) +\n136 |         `Officials may still reject this. Ask ${where(rule.fixWhere).en} to make them identical.`,\n137 |       messageAs:\n138 |         (initials\n139 |           ? `${t.as}ত ${r.as}ৰ সম্পূৰ্ণ নামৰ সলনি আদ্যাক্ষৰ ব্যৱহাৰ কৰা হৈছে (মিল ${score})। `\n140 |           : `${t.as} আৰু ${r.as}ৰ নাম একেজন ব্যক্তিৰ বেলেগকৈ লিখা যেন লাগে (মিল ${score})। `) +\n141 |         `বিষয়াই তথাপিও নাকচ কৰিব পাৰে। দুয়োটা হুবহু একে কৰিবলৈ ${where(rule.fixWhere).as}ত কওক।`,\n142 |       fixWhere: rule.fixWhere,\n143 |     };\n144 |   }\n145 |   return mismatchCheck(base, rule, answers, match, t, r, score);\n146 | }\n147 | \n148 | function mismatchCheck(\n149 |   base: Pick<Check, \"id\" | \"kind\" | \"docType\" | \"provenance\">,\n150 |   rule: NameCheckRule,\n151 |   answers: Answers,\n152 |   match: NameMatchResult,\n153 |   t: Bilingual,\n154 |   r: Bilingual,\n155 |   score: string,\n156 | ): Check {\n157 |   const family = rule.familyOwnerQuestion;\n158 |   if (family && answers[family.id] === true) {\n159 |     // Land owned by a spouse/minor child is allowed, but we cannot prove the relationship from a photo.\n160 |     return {\n161 |       ...base,\n162 |       match,\n163 |       result: \"needs_verification\",\n164 |       messageEn: `The owner on the ${t.en} is not you; you said it is a family member. Take proof of the relationship to ${where(rule.fixWhere).en} and confirm it is accepted.`,\n165 |       messageAs: `${t.as}ত থকা গৰাকী আপুনি নহয়; আপুনি কৈছে যে তেওঁ পৰিয়ালৰ সদস্য। সম্পৰ্কৰ প্ৰমাণ লৈ ${where(rule.fixWhere).as}ত গ্ৰহণযোগ্য নেকি নিশ্চিত কৰক।`,\n166 |       fixWhere: rule.fixWhere,\n167 |     };\n168 |   }\n169 |   return {\n170 |     ...base,\n171 |     match,\n172 |     result: \"action_required\",\n173 |     messageEn: `The name on the ${t.en} does not match the ${r.en} (similarity ${score}). Correct the ${t.en} at ${where(rule.fixWhere).en} so it matches exactly.`,\n174 |     messageAs: `${t.as}ৰ নাম ${r.as}ৰ সৈতে মিল নাই (মিল ${score})। হুবহু মিলাবলৈ ${where(rule.fixWhere).as}ত ${t.as} শুধৰাওক।`,\n175 |     fixWhere: rule.fixWhere,\n176 |   };\n177 | }\n178 | \n179 | // ---------- field formats ----------\n180 | function fieldChecks(scheme: SchemeRule, docs: readonly ExtractedDoc[]): Check[] {\n181 |   const out: Check[] = [];\n182 |   for (const f of scheme.fieldChecks) {\n183 |     const doc = findDoc(docs, f.docType);\n184 |     if (!doc) continue; // the missing-document check already covers this\n185 |     const base = { id: `field_${f.id}`, kind: \"field\" as const, docType: f.docType, provenance: f.provenance };\n186 |     const raw = doc.fields[f.field];\n187 |     const value = (raw ?? \"\").replace(/[\\s-]/g, \"\").toUpperCase();\n188 |     if (value === \"\" || isLowConfidence(doc, f.field)) {\n189 |       out.push({\n190 |         ...base,\n191 |         result: \"needs_verification\",\n192 |         messageEn: `Please type the ${f.labelEn} exactly as printed on the ${DOC_LABELS[f.docType].en}.`,\n193 |         messageAs: `${DOC_LABELS[f.docType].as}ত ছপা হোৱাৰ দৰে ${f.labelAs} হুবহু লিখক।`,\n194 |         fixWhere: \"applicant\",\n195 |       });\n196 |     } else if (new RegExp(f.pattern).test(value)) {\n197 |       out.push({ ...base, result: \"ok\", messageEn: `${cap(f.labelEn)} looks valid.`, messageAs: `${f.labelAs} সঠিক যেন লাগে।`, fixWhere: \"none\" });\n198 |     } else {\n199 |       out.push({\n200 |         ...base,\n201 |         result: \"action_required\",\n202 |         messageEn: `The ${f.labelEn} looks wrong. ${f.hintEn} Check it with ${where(f.fixWhere).en}.`,\n203 |         messageAs: `${f.labelAs} ভুল যেন লাগে। ${f.hintAs} ${where(f.fixWhere).as}ত পৰীক্ষা কৰক।`,\n204 |         fixWhere: f.fixWhere,\n205 |       });\n206 |     }\n207 |   }\n208 |   return out;\n209 | }\n210 | \n211 | \n212 | // ---------- eligibility ----------\n213 | function ageCheck(scheme: SchemeRule, docs: readonly ExtractedDoc[], asOfDate: string): Check | null {\n214 |   const range = scheme.ageRange;\n215 |   if (!range) return null;\n216 |   const base = { id: \"age\", kind: \"eligibility\" as const, provenance: range.provenance };\n217 |   const src = DOC_LABELS[range.dobFrom];\n218 |   const doc = findDoc(docs, range.dobFrom);\n219 |   const dob = doc?.fields.dob;\n220 |   const unsure = (en: string, as: string): Check => ({ ...base, result: \"needs_verification\", messageEn: en, messageAs: as, fixWhere: \"applicant\" });\n221 | \n222 |   if (!doc || !dob) {\n223 |     return unsure(\n224 |       `We need the date of birth from the ${src.en} to check the age limit (${range.min}–${range.max}).`,\n225 |       `বয়সৰ সীমা (${range.min}–${range.max}) পৰীক্ষা কৰিবলৈ ${src.as}ৰ জন্মৰ তাৰিখ লাগিব।`,\n226 |     );\n227 |   }\n228 |   if (!isIsoDate(dob) || dob > asOfDate || isLowConfidence(doc, \"dob\")) {\n229 |     return unsure(\n230 |       `Please confirm the date of birth on the ${src.en} (we could not read it reliably).`,\n231 |       `${src.as}ত থকা জন্মৰ তাৰিখটো নিশ্চিত কৰক (আমি নিৰ্ভৰযোগ্যভাৱে পঢ়িব নোৱাৰিলোঁ)।`,\n232 |     );\n233 |   }\n234 |   const age = ageOn(dob, asOfDate);\n235 |   if (age >= range.min && age <= range.max) {\n236 |     return {\n237 |       ...base,\n238 |       result: \"ok\",\n239 |       messageEn: `Age ${age} on ${asOfDate} is within ${range.min}–${range.max}.`,\n240 |       messageAs: `${asOfDate} তাৰিখত বয়স ${age}, যি ${range.min}–${range.max}ৰ ভিতৰত।`,\n241 |       fixWhere: \"none\",\n242 |     };\n243 |   }\n244 |   const above = age > range.max;\n245 |   const verifiedRule = range.provenance.status === \"verified\";\n246 |   return {\n247 |     ...base,\n248 |     result: verifiedRule ? \"action_required\" : \"needs_verification\",\n249 |     messageEn:\n250 |       `Age ${age} on ${asOfDate} is outside the ${range.min}–${range.max} limit for this scheme.` +\n251 |       (above && range.aboveMaxHintEn ? ` ${range.aboveMaxHintEn}` : \"\"),\n252 |     messageAs:\n253 |       `${asOfDate} তাৰিখত বয়স ${age}, যি এই আঁচনিৰ ${range.min}–${range.max} সীমাৰ বাহিৰত।` +\n254 |       (above && range.aboveMaxHintAs ? ` ${range.aboveMaxHintAs}` : \"\"),\n255 |     fixWhere: verifiedRule ? \"none\" : scheme.confirmAt,\n256 |   };\n257 | }\n258 | \n259 | const confirmPlace = (scheme: SchemeRule, q: Question): FixWhere => q.fixWhere ?? scheme.confirmAt;\n260 | \n261 | function notAnswered(scheme: SchemeRule, id: string, q: Question): Check {\n262 |   const w = where(confirmPlace(scheme, q));\n263 |   return {\n264 |     id,\n265 |     kind: \"eligibility\",\n266 |     result: \"needs_verification\",\n267 |     messageEn: `Please answer: ${q.textEn} (If unsure, ask at ${w.en}.)`,\n268 |     messageAs: `অনুগ্ৰহ কৰি উত্তৰ দিয়ক: ${q.textAs} (নিশ্চিত নহ'লে ${w.as}ত সোধক।)`,\n269 |     fixWhere: confirmPlace(scheme, q),\n270 |     provenance: q.provenance,\n271 |   };\n272 | }\n273 | \n274 | /** A criterion that went against the applicant: definitive only if the rule is verified. */\n275 | function failed(scheme: SchemeRule, id: string, q: Question, en: string, as: string): Check {\n276 |   if (q.provenance.status === \"verified\") {\n277 |     return {\n278 |       id,\n279 |       kind: \"eligibility\",\n280 |       result: \"action_required\",\n281 |       messageEn: `${en} This makes you not eligible for ${scheme.nameEn}.`,\n282 |       messageAs: `${as} ইয়াৰ বাবে আপুনি ${scheme.nameAs}ৰ বাবে যোগ্য নহয়।`,\n283 |       fixWhere: \"none\",\n284 |       provenance: q.provenance,\n285 |     };\n286 |   }\n287 |   const w = where(confirmPlace(scheme, q));\n288 |   return {\n289 |     id,\n290 |     kind: \"eligibility\",\n291 |     result: \"needs_verification\",\n292 |     messageEn: `${en} This may make you ineligible. Confirm at ${w.en}. Ask whether \"${q.labelEn}\" still applies under the current rules.`,\n293 |     messageAs: `${as} ইয়াৰ বাবে আপুনি অযোগ্য হ'ব পাৰে। ${w.as}ত নিশ্চিত কৰক। বৰ্তমানৰ নিয়মত \"${q.labelAs}\" এতিয়াও প্ৰযোজ্য নেকি সোধক।`,\n294 |     fixWhere: confirmPlace(scheme, q),\n295 |     provenance: q.provenance,\n296 |   };\n297 | }\n298 | \n299 | function passed(id: string, q: Question, en = q.labelEn, as = q.labelAs): Check {\n300 |   return {\n301 |     id,\n302 |     kind: \"eligibility\",\n303 |     result: \"ok\",\n304 |     messageEn: `Checked: ${en}.`,\n305 |     messageAs: `পৰীক্ষা কৰা হ'ল: ${as}।`,\n306 |     fixWhere: \"none\",\n307 |     provenance: q.provenance,\n308 |   };\n309 | }\n310 | \n311 | \n312 | function questionChecks(scheme: SchemeRule, answers: Answers): Check[] {\n313 |   const out: Check[] = [];\n314 |   for (const q of scheme.requirements) {\n315 |     const id = `req_${q.id}`;\n316 |     const a = answers[q.id];\n317 |     if (a === undefined) out.push(notAnswered(scheme, id, q));\n318 |     else if (a) out.push(passed(id, q));\n319 |     else out.push(failed(scheme, id, q, `You answered no to: ${q.textEn}`, `আপুনি \"নহয়\" উত্তৰ দিছে: ${q.textAs}`));\n320 |   }\n321 | \n322 |   const anyOf = scheme.eligibilityAnyOf;\n323 |   if (anyOf.length > 0) {\n324 |     const yes = anyOf.find((q) => answers[q.id] === true);\n325 |     const unanswered = anyOf.find((q) => answers[q.id] === undefined);\n326 |     if (yes) out.push(passed(\"anyof\", yes));\n327 |     else if (unanswered) out.push(notAnswered(scheme, \"anyof\", unanswered));\n328 |     else {\n329 |       const listEn = anyOf.map((q) => q.labelEn).join(\"; \");\n330 |       const listAs = anyOf.map((q) => q.labelAs).join(\"; \");\n331 |       // Definitive only if every any-of criterion is verified.\n332 |       const allVerified = anyOf.every((q) => q.provenance.status === \"verified\");\n333 |       const rep = allVerified ? anyOf[0] : (anyOf.find((q) => q.provenance.status === \"provisional\") ?? anyOf[0]);\n334 |       out.push(failed(scheme, \"anyof\", rep, `None of these applies to you: ${listEn}.`, `এইবোৰৰ এটাও আপোনাৰ ক্ষেত্ৰত প্ৰযোজ্য নহয়: ${listAs}।`));\n335 |     }\n336 |   }\n337 | \n338 |   for (const q of scheme.exclusions) {\n339 |     const id = `excl_${q.id}`;\n340 |     const a = answers[q.id];\n341 |     if (a === undefined) out.push(notAnswered(scheme, id, q));\n342 |     else if (!a) out.push(passed(id, q, `not ${q.labelEn}`, `${q.labelAs}: নহয়`));\n343 |     else out.push(failed(scheme, id, q, `You answered yes: ${q.labelEn}.`, `আপুনি \"হয়\" উত্তৰ দিছে: ${q.labelAs}।`));\n344 |   }\n345 |   return out;\n346 | }\n347 | \n348 | // ---------- external facts (never provable from a photo) ----------\n349 | function externalChecks(scheme: SchemeRule): Check[] {\n350 |   return scheme.externalChecks.map((e) => ({\n351 |     id: `ext_${e.id}`,\n352 |     kind: \"external\",\n353 |     result: \"needs_verification\",\n354 |     messageEn: `We cannot see this from a photo: ${e.labelEn}. ${e.howEn}`,\n355 |     messageAs: `ফটোৰ পৰা আমি এইটো চাব নোৱাৰোঁ: ${e.labelAs}। ${e.howAs}`,\n356 |     fixWhere: e.fixWhere,\n357 |     provenance: e.provenance,\n358 |   }));\n359 | }\n360 | \n361 | // ---------- verdicts ----------\n362 | function eligibilityOf(checks: readonly Check[]): Eligibility {\n363 |   const elig = checks.filter((c) => c.kind === \"eligibility\");\n364 |   if (elig.some((c) => c.result === \"action_required\" && c.provenance.status === \"verified\")) return \"not_eligible\";\n365 |   if (elig.some((c) => c.result !== \"ok\" && c.result !== \"not_applicable\")) return \"needs_verification\";\n366 |   return \"likely_eligible\";\n367 | }\n368 | \n369 | function readinessOf(checks: readonly Check[]): Readiness {\n370 |   if (checks.some((c) => c.result === \"action_required\")) return \"action_required\";\n371 |   // External facts are always \"confirm\", so on their own they never block ready_for_review.\n372 |   if (checks.some((c) => c.kind !== \"external\" && c.result === \"needs_verification\")) return \"needs_verification\";\n373 |   return \"ready_for_review\";\n374 | }\n375 | \n376 | /**\n377 |  * Evaluates a scheme against the extracted documents and yes/no answers on an explicit date.\n378 |  * Deterministic: the same inputs always give the same report.\n379 |  */\n380 | export function evaluate(scheme: SchemeRule, docs: readonly ExtractedDoc[], answers: Answers, asOfDate: string): Report {\n381 |   assertIsoDate(asOfDate, \"asOfDate\");\n382 |   const age = ageCheck(scheme, docs, asOfDate);\n383 |   const checks: Check[] = [\n384 |     ...mandatoryDocChecks(scheme, docs),\n385 |     ...scheme.nameChecks.map((rule) => nameCheck(scheme, rule, docs, answers)),\n386 |     ...fieldChecks(scheme, docs),\n387 |     ...(age ? [age] : []),\n388 |     ...questionChecks(scheme, answers),\n389 |     ...externalChecks(scheme),\n390 |   ];\n391 | \n392 |   return {\n393 |     schemeId: scheme.id,\n394 |     schemeVersion: scheme.version,\n395 |     asOfDate,\n396 |     eligibility: eligibilityOf(checks),\n397 |     readiness: readinessOf(checks),\n398 |     checks,\n399 |     benefit: benefitOn(scheme, asOfDate),\n400 |     supportingDocs: scheme.supportingDocs.map((d) => ({\n401 |       docType: d.docType,\n402 |       labelEn: DOC_LABELS[d.docType].en,\n403 |       labelAs: DOC_LABELS[d.docType].as,\n404 |       present: findDoc(docs, d.docType) !== undefined,\n405 |       provenance: d.provenance,\n406 |     })),\n407 |     supportingDocsNoteEn: scheme.supportingDocsNoteEn,\n408 |     supportingDocsNoteAs: scheme.supportingDocsNoteAs,\n409 |     disclaimerEn: DISCLAIMER.en,\n410 |     disclaimerAs: DISCLAIMER.as,\n411 |   };\n412 | }\n413 | ","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\core\\samples.ts","result":" 1 | // Demo sample sets (clearly FAKE people and numbers). Pure data, validated by zod.\n 2 | // A = clean PM-KISAN farmer → ready_for_review (+ bank seeding needs verification)\n 3 | // B = PM-KISAN: bank \"RAMESH KR SHARMA\" (possible match) + land \"Rameshwar Sharma\" (mismatch) → action_required\n 4 | // C = widow pension, missing death certificate → action_required\n 5 | import { z } from \"zod\";\n 6 | import { Answers, ExtractedDoc } from \"./types\";\n 7 | \n 8 | export const SampleSet = z.object({\n 9 |   id: z.enum([\"A\", \"B\", \"C\"]),\n10 |   schemeId: z.string(),\n11 |   titleEn: z.string(),\n12 |   titleAs: z.string(),\n13 |   docs: z.array(ExtractedDoc),\n14 |   answers: Answers,\n15 | });\n16 | export type SampleSet = z.infer<typeof SampleSet>;\n17 | \n18 | const pmKisanNo = {\n19 |   holds_constitutional_post: false,\n20 |   govt_employee: false,\n21 |   income_tax_payer: false,\n22 |   practising_professional: false,\n23 |   pension_10k_plus: false,\n24 | };\n25 | \n26 | const aadhaarRamesh: ExtractedDoc = {\n27 |   docType: \"aadhaar\",\n28 |   fields: { name: \"Ramesh Kumar Sharma\", dob: \"1975-03-12\", aadhaarLast4: \"4821\" },\n29 |   confidence: { name: 0.97, dob: 0.95, aadhaarLast4: 0.99 },\n30 | };\n31 | \n32 | export const SAMPLES: Record<SampleSet[\"id\"], SampleSet> = {\n33 |   A: SampleSet.parse({\n34 |     id: \"A\",\n35 |     schemeId: \"pm-kisan\",\n36 |     titleEn: \"Sample A: PM-KISAN, papers in order (fake)\",\n37 |     titleAs: \"নমুনা A: পি এম কিষাণ, কাগজ ঠিকে আছে (নকল)\",\n38 |     docs: [\n39 |       aadhaarRamesh,\n40 |       {\n41 |         docType: \"bank_passbook\",\n42 |         fields: { name: \"RAMESH KUMAR SHARMA\", accountNo: \"30012345678\", ifsc: \"SBIN0001234\" },\n43 |         confidence: { name: 0.95, accountNo: 0.93, ifsc: 0.96 },\n44 |       },\n45 |       {\n46 |         docType: \"land_record\",\n47 |         fields: { ownerNames: [\"Ramesh Kumar Sharma\"] },\n48 |         confidence: { ownerNames: 0.9 },\n49 |       },\n50 |     ],\n51 |     answers: pmKisanNo,\n52 |   }),\n53 |   B: SampleSet.parse({\n54 |     id: \"B\",\n55 |     schemeId: \"pm-kisan\",\n56 |     titleEn: \"Sample B: PM-KISAN, names do not match (fake)\",\n57 |     titleAs: \"নমুনা B: পি এম কিষাণ, নাম নিমিলে (নকল)\",\n58 |     docs: [\n59 |       aadhaarRamesh,\n60 |       {\n61 |         docType: \"bank_passbook\",\n62 |         fields: { name: \"RAMESH KR SHARMA\", accountNo: \"30012345678\", ifsc: \"SBIN0001234\" },\n63 |         confidence: { name: 0.95, accountNo: 0.93, ifsc: 0.96 },\n64 |       },\n65 |       {\n66 |         docType: \"land_record\",\n67 |         fields: { ownerNames: [\"Rameshwar Sharma\"] },\n68 |         confidence: { ownerNames: 0.9 },\n69 |       },\n70 |     ],\n71 |     answers: pmKisanNo,\n72 |   }),\n73 |   C: SampleSet.parse({\n74 |     id: \"C\",\n75 |     schemeId: \"nsap-widow\",\n76 |     titleEn: \"Sample C: Widow pension, death certificate missing (fake)\",\n77 |     titleAs: \"নমুনা C: বিধৱা পেঞ্চন, মৃত্যুৰ প্ৰমাণপত্ৰ নাই (নকল)\",\n78 |     docs: [\n79 |       {\n80 |         docType: \"aadhaar\",\n81 |         fields: { name: \"Smt. Sunita Devi\", dob: \"1968-07-01\", aadhaarLast4: \"7315\" },\n82 |         confidence: { name: 0.96, dob: 0.94, aadhaarLast4: 0.99 },\n83 |       },\n84 |       {\n85 |         docType: \"bank_passbook\",\n86 |         fields: { name: \"SUNITA DEVI\", accountNo: \"40098765432\", ifsc: \"UTBI0ABC123\" },\n87 |         confidence: { name: 0.94, accountNo: 0.92, ifsc: 0.95 },\n88 |       },\n89 |       {\n90 |         docType: \"bpl_proof\",\n91 |         fields: { name: \"Sunita Devi\" },\n92 |         confidence: { name: 0.9 },\n93 |       },\n94 |     ],\n95 |     answers: { is_widow: true, bpl_household: true },\n96 |   }),\n97 | };","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\core\\catalog.ts","result":" 1 | // What the UI needs to know about each scheme (serialisable, no functions). Pure.\n 2 | import { docSlotsFor, type DocSlot } from \"./flow\";\n 3 | import { questionsFor } from \"./schemes\";\n 4 | import type { Benefit, Question, SchemeRule } from \"./types\";\n 5 | \n 6 | export const FLAGSHIP_SCHEME_ID = \"pm-kisan\";\n 7 | \n 8 | export interface SchemeView {\n 9 |   id: string;\n10 |   version: string;\n11 |   nameEn: string;\n12 |   nameAs: string;\n13 |   flagship: boolean;\n14 |   benefit: Pick<Benefit, \"centralShare\" | \"stateTopUp\" | \"period\">;\n15 |   slots: DocSlot[];\n16 |   questions: Question[];\n17 |   /** Short labels for the external checks, keyed by the engine's check id (`ext_<id>`). */\n18 |   external: { checkId: string; labelEn: string; labelAs: string }[];\n19 | }\n20 | \n21 | export function schemeView(s: SchemeRule): SchemeView {\n22 |   return {\n23 |     id: s.id,\n24 |     version: s.version,\n25 |     nameEn: s.nameEn,\n26 |     nameAs: s.nameAs,\n27 |     flagship: s.id === FLAGSHIP_SCHEME_ID,\n28 |     benefit: { centralShare: s.benefit.centralShare, stateTopUp: s.benefit.stateTopUp, period: s.benefit.period },\n29 |     slots: docSlotsFor(s),\n30 |     questions: questionsFor(s),\n31 |     external: s.externalChecks.map((e) => ({ checkId: `ext_${e.id}`, labelEn: e.labelEn, labelAs: e.labelAs })),\n32 |   };\n33 | }\n34 | \n35 | /** Flagship first, then the registry order. */\n36 | export function catalogOf(schemes: readonly SchemeRule[]): SchemeView[] {\n37 |   const views = schemes.map(schemeView);\n38 |   return [...views.filter((v) => v.flagship), ...views.filter((v) => !v.flagship)];\n39 | }","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\server\\api.ts","result":" 1 | // Request schemas and handlers for the API routes. The route files are thin wrappers.\n 2 | // /api/check runs the deterministic engine only (no model). /api/extract goes through ai.ts.\n 3 | import { z } from \"zod\";\n 4 | import { evaluate } from \"@/core/evaluate\";\n 5 | import { getScheme } from \"@/core/schemes\";\n 6 | import { Answers, DocType, ExtractedDoc, IsoDate } from \"@/core/types\";\n 7 | import { extractDocument } from \"@/server/ai\";\n 8 | \n 9 | /** Base64 of a ~6 MB image is ~8 MB; refuse anything bigger before parsing further. */\n10 | const MAX_BODY_CHARS = 9 * 1024 * 1024;\n11 | \n12 | export const CheckRequest = z.object({\n13 |   schemeId: z.string().min(1).max(64),\n14 |   schemeVersion: z.string().max(32).optional(),\n15 |   docs: z.array(ExtractedDoc).max(20),\n16 |   answers: Answers,\n17 |   asOfDate: IsoDate.optional(),\n18 | });\n19 | export type CheckRequest = z.infer<typeof CheckRequest>;\n20 | \n21 | export const ExtractRequest = z.object({\n22 |   image: z.string().min(1).max(MAX_BODY_CHARS),\n23 |   docType: DocType.optional(),\n24 | });\n25 | \n26 | /** Today's date in India (Asia/Kolkata, UTC+5:30, no DST) as YYYY-MM-DD. */\n27 | export function todayInIndia(now: Date = new Date()): string {\n28 |   return new Date(now.getTime() + 330 * 60_000).toISOString().slice(0, 10);\n29 | }\n30 | \n31 | const json = (body: unknown, status = 200) => Response.json(body, { status });\n32 | \n33 | async function readJson(req: Request): Promise<{ ok: true; value: unknown } | { ok: false }> {\n34 |   try {\n35 |     const text = await req.text();\n36 |     if (text.length > MAX_BODY_CHARS) return { ok: false };\n37 |     return { ok: true, value: JSON.parse(text) };\n38 |   } catch {\n39 |     return { ok: false };\n40 |   }\n41 | }\n42 | \n43 | /** Only paths and codes: never echo submitted values (they can hold personal data). */\n44 | function issues(error: z.ZodError) {\n45 |   return error.issues.slice(0, 10).map((i) => ({ path: i.path.join(\".\"), code: i.code }));\n46 | }\n47 | \n48 | export async function handleCheck(req: Request): Promise<Response> {\n49 |   const body = await readJson(req);\n50 |   if (!body.ok) return json({ error: \"invalid_json\" }, 400);\n51 |   const parsed = CheckRequest.safeParse(body.value);\n52 |   if (!parsed.success) return json({ error: \"invalid_request\", issues: issues(parsed.error) }, 400);\n53 | \n54 |   const { schemeId, schemeVersion, docs, answers } = parsed.data;\n55 |   const scheme = getScheme(schemeId, schemeVersion);\n56 |   if (!scheme) return json({ error: \"unknown_scheme\" }, 404);\n57 |   return json(evaluate(scheme, docs, answers, parsed.data.asOfDate ?? todayInIndia()));\n58 | }\n59 | \n60 | const EXTRACT_STATUS = { ai_unavailable: 503, ai_failed: 502, invalid_image: 400 } as const;\n61 | \n62 | export async function handleExtract(req: Request): Promise<Response> {\n63 |   const body = await readJson(req);\n64 |   if (!body.ok) return json({ error: \"invalid_json\" }, 400);\n65 |   const parsed = ExtractRequest.safeParse(body.value);\n66 |   if (!parsed.success) return json({ error: \"invalid_request\", issues: issues(parsed.error) }, 400);\n67 | \n68 |   try {\n69 |     const result = await extractDocument(parsed.data.image, parsed.data.docType);\n70 |     if (\"error\" in result) return json({ error: result.error }, EXTRACT_STATUS[result.error]);\n71 |     return json(result);\n72 |   } catch {\n73 |     return json({ error: \"ai_failed\" }, 502);\n74 |   }\n75 | }","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\server\\ai.ts","result":"  1 | // The ONLY module that calls a model (Cline API, OpenAI-compatible).\n  2 | // Structured JSON → zod → one retry → safe fallback `{ error }`. Never throws to the caller.\n  3 | // Logs model, prompt version and an input hash; never the image, the extracted text or any secret.\n  4 | // Images are processed in memory only and never stored.\n  5 | import { createHash } from \"node:crypto\";\n  6 | import { RawExtraction, toExtractedDoc } from \"@/core/extraction\";\n  7 | import { DocType as DocTypeSchema, type DocType, type ExtractedDoc } from \"@/core/types\";\n  8 | \n  9 | export const DEFAULT_BASE_URL = \"https://api.cline.bot/api/v1\";\n 10 | export const EXTRACT_PROMPT_VERSION = \"extract-doc-v1\";\n 11 | /** Decoded image size limit (the browser downsizes photos well below this). */\n 12 | export const MAX_IMAGE_BYTES = 6 * 1024 * 1024;\n 13 | const DEFAULT_TIMEOUT_MS = 45_000;\n 14 | \n 15 | export type AiError = \"ai_unavailable\" | \"ai_failed\" | \"invalid_image\";\n 16 | export type ExtractResult = { doc: ExtractedDoc; detectedDocType: DocType | null } | { error: AiError };\n 17 | \n 18 | export interface AiLogEntry {\n 19 |   fn: \"extractDocument\";\n 20 |   model: string | null;\n 21 |   promptVersion: string;\n 22 |   inputHash: string | null;\n 23 |   attempt: number;\n 24 |   outcome: \"ok\" | \"unavailable\" | \"invalid_image\" | \"http_error\" | \"bad_output\" | \"network_error\";\n 25 |   status?: number;\n 26 |   ms?: number;\n 27 | }\n 28 | \n 29 | export interface AiDeps {\n 30 |   fetch?: typeof fetch;\n 31 |   env?: Record<string, string | undefined>;\n 32 |   log?: (entry: AiLogEntry) => void;\n 33 |   timeoutMs?: number;\n 34 | }\n 35 | \n 36 | interface AiConfig {\n 37 |   apiKey: string;\n 38 |   model: string;\n 39 |   baseUrl: string;\n 40 | }\n 41 | \n 42 | function configFrom(env: Record<string, string | undefined>): AiConfig | null {\n 43 |   const apiKey = env.CLINE_API_KEY?.trim();\n 44 |   const model = env.CLINE_MODEL?.trim();\n 45 |   if (!apiKey || !model) return null;\n 46 |   return { apiKey, model, baseUrl: (env.CLINE_BASE_URL?.trim() || DEFAULT_BASE_URL).replace(/\\/+$/, \"\") };\n 47 | }\n 48 | \n 49 | /** True when a key and model are configured (does not call the model). */\n 50 | export function isAiConfigured(env: Record<string, string | undefined> = process.env): boolean {\n 51 |   return configFrom(env) !== null;\n 52 | }\n 53 | \n 54 | const defaultLog = (entry: AiLogEntry) => console.info(`[ai] ${JSON.stringify(entry)}`);\n 55 | \n 56 | const DATA_URL = /^data:(image\\/(?:jpeg|png|webp|gif|heic|heif));base64,/i;\n 57 | const BASE64 = /^[A-Za-z0-9+/]+={0,2}$/;\n 58 | \n 59 | /** Accepts a data URL or bare base64. Returns null if it is not a plausible image of allowed size. */\n 60 | export function parseImage(input: string): { mime: string; data: string } | null {\n 61 |   const m = DATA_URL.exec(input);\n 62 |   const mime = m ? m[1].toLowerCase() : \"image/jpeg\";\n 63 |   const data = (m ? input.slice(m[0].length) : input).replace(/\\s/g, \"\");\n 64 |   if (data.length < 16 || data.length % 4 !== 0 || !BASE64.test(data)) return null;\n 65 |   if ((data.length / 4) * 3 > MAX_IMAGE_BYTES) return null;\n 66 |   return { mime, data };\n 67 | }\n 68 | \n 69 | const SYSTEM_PROMPT = `You read photos of Indian government documents for a welfare-application checker.\n 70 | Return ONLY one JSON object, no other text:\n 71 | {\"docType\": string, \"fields\": {...}, \"confidence\": {...}}\n 72 | - docType: one of ${DocTypeSchema.options.join(\", \")}.\n 73 | - fields (omit any you cannot read; never guess):\n 74 |   name: the person's name exactly as printed (keep the original script and spelling);\n 75 |   dob: date of birth as YYYY-MM-DD;\n 76 |   aadhaarLast4: ONLY the last 4 digits of the Aadhaar number. Never return the full Aadhaar number;\n 77 |   accountNo: bank account number, digits only;\n 78 |   ifsc: IFSC code;\n 79 |   ownerNames: array of land owner names as printed (land records).\n 80 | - confidence: for each field you returned, a number from 0 to 1 for how sure you are of the exact text.`;\n 81 | \n 82 | function userPrompt(hint?: DocType): string {\n 83 |   return hint\n 84 |     ? `The user says this photo is a ${hint}. Read it and return the JSON.`\n 85 |     : \"Read this document photo and return the JSON.\";\n 86 | }\n 87 | \n 88 | /** Pulls the first JSON object out of the model's reply (tolerates code fences or extra words). */\n 89 | export function jsonFromReply(content: string): unknown {\n 90 |   const start = content.indexOf(\"{\");\n 91 |   const end = content.lastIndexOf(\"}\");\n 92 |   if (start < 0 || end <= start) throw new SyntaxError(\"no JSON object in reply\");\n 93 |   return JSON.parse(content.slice(start, end + 1));\n 94 | }\n 95 | \n 96 | type Completion = { choices?: { message?: { content?: unknown } }[] };\n 97 | \n 98 | /** The reply text. The Cline API wraps the OpenAI-style body in `{ data: { choices } }`; plain bodies work too. */\n 99 | export function replyText(body: unknown): string {\n100 |   const b = body as (Completion & { data?: Completion }) | null;\n101 |   const content = (b?.choices ?? b?.data?.choices)?.[0]?.message?.content;\n102 |   if (typeof content === \"string\") return content;\n103 |   if (Array.isArray(content)) {\n104 |     return content.map((p: { text?: unknown }) => (typeof p?.text === \"string\" ? p.text : \"\")).join(\"\");\n105 |   }\n106 |   return \"\";\n107 | }\n108 | \n109 | /**\n110 |  * Reads one document photo → ExtractedDoc with per-field confidence (Aadhaar reduced to the last 4 digits).\n111 |  * Returns `{ error: \"ai_unavailable\" }` when no key/model is configured, so the UI falls back to manual entry.\n112 |  */\n113 | export async function extractDocument(imageBase64: string, hintDocType?: DocType, deps: AiDeps = {}): Promise<ExtractResult> {\n114 |   const log = deps.log ?? defaultLog;\n115 |   const config = configFrom(deps.env ?? process.env);\n116 |   const base = { fn: \"extractDocument\" as const, model: config?.model ?? null, promptVersion: EXTRACT_PROMPT_VERSION };\n117 | \n118 |   if (!config) {\n119 |     log({ ...base, inputHash: null, attempt: 0, outcome: \"unavailable\" });\n120 |     return { error: \"ai_unavailable\" };\n121 |   }\n122 |   const image = parseImage(imageBase64);\n123 |   if (!image) {\n124 |     log({ ...base, inputHash: null, attempt: 0, outcome: \"invalid_image\" });\n125 |     return { error: \"invalid_image\" };\n126 |   }\n127 |   const inputHash = createHash(\"sha256\").update(image.data).update(hintDocType ?? \"\").digest(\"hex\").slice(0, 16);\n128 |   const doFetch = deps.fetch ?? fetch;\n129 |   const body = JSON.stringify({\n130 |     model: config.model,\n131 |     temperature: 0,\n132 |     messages: [\n133 |       { role: \"system\", content: SYSTEM_PROMPT },\n134 |       {\n135 |         role: \"user\",\n136 |         content: [\n137 |           { type: \"text\", text: userPrompt(hintDocType) },\n138 |           { type: \"image_url\", image_url: { url: `data:${image.mime};base64,${image.data}` } },\n139 |         ],\n140 |       },\n141 |     ],\n142 |   });\n143 | \n144 |   // First attempt + one retry, then the safe fallback.\n145 |   for (let attempt = 1; attempt <= 2; attempt++) {\n146 |     const started = Date.now();\n147 |     const entry = { ...base, inputHash, attempt };\n148 |     try {\n149 |       const res = await doFetch(`${config.baseUrl}/chat/completions`, {\n150 |         method: \"POST\",\n151 |         headers: { Authorization: `Bearer ${config.apiKey}`, \"Content-Type\": \"application/json\" },\n152 |         body,\n153 |         signal: AbortSignal.timeout(deps.timeoutMs ?? DEFAULT_TIMEOUT_MS),\n154 |       });\n155 |       if (!res.ok) {\n156 |         log({ ...entry, outcome: \"http_error\", status: res.status, ms: Date.now() - started });\n157 |         continue;\n158 |       }\n159 |       const json: unknown = await res.json();\n160 |       const raw = RawExtraction.safeParse(jsonFromReply(replyText(json)));\n161 |       if (!raw.success) {\n162 |         log({ ...entry, outcome: \"bad_output\", ms: Date.now() - started });\n163 |         continue;\n164 |       }\n165 |       const result = toExtractedDoc(raw.data, hintDocType);\n166 |       log({ ...entry, outcome: \"ok\", ms: Date.now() - started });\n167 |       return result;\n168 |     } catch (e) {\n169 |       log({ ...entry, outcome: e instanceof SyntaxError ? \"bad_output\" : \"network_error\", ms: Date.now() - started });\n170 |     }\n171 |   }\n172 |   return { error: \"ai_failed\" };\n173 | }\n174 | ","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\app\\page.tsx","result":"1 | // Server component: builds the scheme catalog from the registry and hands plain data to the client flow.\n2 | import { catalogOf } from \"@/core/catalog\";\n3 | import { SAMPLES } from \"@/core/samples\";\n4 | import { listSchemes } from \"@/core/schemes\";\n5 | import { KaagazApp } from \"./_components/KaagazApp\";\n6 | \n7 | export default function Home() {\n8 |   return <KaagazApp catalog={catalogOf(listSchemes())} samples={Object.values(SAMPLES)} />;\n9 | }","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\app\\api\\check\\route.ts","result":"1 | // POST /api/check: { schemeId, schemeVersion?, docs, answers, asOfDate? } → Report (rule engine only).\n2 | // Runs on Node.js: the default, and the only runtime with cacheComponents. Next 16 rejects an explicit\n3 | // `export const runtime` when cacheComponents is on, so it is deliberately not exported here.\n4 | import { handleCheck } from \"@/server/api\";\n5 | \n6 | export async function POST(req: Request): Promise<Response> {\n7 |   return handleCheck(req);\n8 | }","success":true}],"durationMs":7}}
