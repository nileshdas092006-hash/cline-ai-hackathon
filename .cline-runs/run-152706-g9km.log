rom \"@/core/samples\";\n 5 | import { Report } from \"@/core/types\";\n 6 | import { todayInIndia } from \"@/server/api\";\n 7 | \n 8 | vi.mock(\"@/server/ai\", () => ({ extractDocument: vi.fn() }));\n 9 | \n10 | const post = (body: unknown) =>\n11 |   new Request(\"http://localhost/api/check\", {\n12 |     method: \"POST\",\n13 |     headers: { \"Content-Type\": \"application/json\" },\n14 |     body: typeof body === \"string\" ? body : JSON.stringify(body),\n15 |   });\n16 | \n17 | const AS_OF = \"2026-10-10\";\n18 | async function check(body: unknown) {\n19 |   const res = await checkPost(post(body));\n20 |   return { status: res.status, json: await res.json() };\n21 | }\n22 | function sample(id: keyof typeof SAMPLES) {\n23 |   const s = SAMPLES[id];\n24 |   return { schemeId: s.schemeId, docs: s.docs, answers: s.answers, asOfDate: AS_OF };\n25 | }\n26 | \n27 | describe(\"POST /api/check\", () => {\n28 |   it(\"sample A → ready_for_review, with bank seeding flagged needs_verification\", async () => {\n29 |     const { status, json } = await check(sample(\"A\"));\n30 |     expect(status).toBe(200);\n31 |     const report = Report.parse(json);\n32 |     expect(report.eligibility).toBe(\"likely_eligible\");\n33 |     expect(report.readiness).toBe(\"ready_for_review\");\n34 |     expect(report.checks.find((c) => c.id === \"ext_aadhaar_bank_seeding\")?.result).toBe(\"needs_verification\");\n35 |   });\n36 | \n37 |   it(\"sample B → action_required, naming the land record and the bank name variant\", async () => {\n38 |     const report = Report.parse((await check(sample(\"B\"))).json);\n39 |     expect(report.readiness).toBe(\"action_required\");\n40 |     const land = report.checks.find((c) => c.id === \"name_land_record\");\n41 |     const bank = report.checks.find((c) => c.id === \"name_bank_passbook\");\n42 |     expect(land?.result).toBe(\"action_required\");\n43 |     expect(land?.messageEn).toContain(\"land record\");\n44 |     expect(bank?.result).toBe(\"needs_verification\");\n45 |     expect(bank?.match?.level).toBe(\"possible_match\");\n46 |   });\n47 | \n48 |   it(\"sample C → action_required because the death certificate is missing\", async () => {\n49 |     const report = Report.parse((await check(sample(\"C\"))).json);\n50 |     expect(report.readiness).toBe(\"action_required\");\n51 |     expect(report.checks.find((c) => c.id === \"doc_death_certificate\")?.result).toBe(\"action_required\");\n52 |   });\n53 | \n54 |   it(\"manual entry (no AI confidence at all) completes the flow\", async () => {\n55 |     const docs = [\n56 |       { docType: \"aadhaar\", fields: { name: \"Ramesh Kumar Sharma\", dob: \"1975-03-12\", aadhaarLast4: \"4821\" }, confidence: {} },\n57 |       { docType: \"bank_passbook\", fields: { name: \"Ramesh Kumar Sharma\", accountNo: \"30012345678\", ifsc: \"SBIN0001234\" }, confidence: {} },\n58 |       { docType: \"land_record\", fields: { ownerNames: [\"Ramesh Kumar Sharma\"] }, confidence: {} },\n59 |     ];\n60 |     const report = Report.parse((await check({ ...sample(\"A\"), docs })).json);\n61 |     expect(report.readiness).toBe(\"ready_for_review\");\n62 |   });\n63 | \n64 |   it(\"defaults asOfDate to today in India\", async () => {\n65 |     const { schemeId, docs, answers } = sample(\"A\");\n66 |     const report = Report.parse((await check({ schemeId, docs, answers })).json);\n67 |     expect(report.asOfDate).toBe(todayInIndia());\n68 |     expect(todayInIndia(new Date(\"2026-10-09T20:00:00Z\"))).toBe(\"2026-10-10\"); // 01:30 IST\n69 |   });\n70 | \n71 |   it(\"rejects bad input: unknown scheme/version 404; bad JSON, date or full Aadhaar 400\", async () => {\n72 |     expect((await check({ ...sample(\"A\"), schemeId: \"nope\" })).status).toBe(404);\n73 |     expect((await check({ ...sample(\"A\"), schemeVersion: \"9.9.9\" })).status).toBe(404);\n74 |     expect((await checkPost(post(\"{not json\"))).status).toBe(400);\n75 |     expect((await check({ ...sample(\"A\"), asOfDate: \"2026-02-30\" })).status).toBe(400);\n76 |     const fullAadhaar = [{ docType: \"aadhaar\", fields: { aadhaarLast4: \"123456784821\" }, confidence: {} }];\n77 |     expect((await check({ ...sample(\"A\"), docs: fullAadhaar })).status).toBe(400);\n78 |     const extraField = [{ docType: \"aadhaar\", fields: { aadhaarNumber: \"123456784821\" }, confidence: {} }];\n79 |     expect((await check({ ...sample(\"A\"), docs: extraField })).status).toBe(400);\n80 |   });\n81 | \n82 |   it(\"an error response never echoes the submitted personal data\", async () => {\n83 |     const docs = [{ docType: \"aadhaar\", fields: { name: \"Secret Person\", aadhaarLast4: \"123456784821\" }, confidence: {} }];\n84 |     const { json } = await check({ ...sample(\"A\"), docs });\n85 |     expect(JSON.stringify(json)).not.toContain(\"Secret\");\n86 |     expect(JSON.stringify(json)).not.toContain(\"12345678\");\n87 |   });\n88 | });","success":true}],"durationMs":5}}
