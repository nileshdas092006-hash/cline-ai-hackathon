{"ts":"2026-10-10T10:33:50.385Z","type":"agent_event","event":{"type":"content_start","contentType":"tool","toolName":"editor","toolCallId":"toolu_012P47E5a9EfjhtsrQthypus","input":{"path":"C:\\Dev\\cline hackathon\\build\\src\\core\\mergePatch.ts","new_text":"// JSON Merge Patch (RFC 7386). Pure; never modifies its inputs.\n// The agent uses it to change an existing rule without re-sending the whole rule.\n\ntype Obj = Record<string, unknown>;\nconst isObj = (v: unknown): v is Obj => typeof v === \"object\" && v !== null && !Array.isArray(v);\n\nexport function applyMergePatch(target: unknown, patch: unknown): unknown {\n  if (!isObj(patch)) return structuredClone(patch);\n  const out: Obj = isObj(target) ? structuredClone(target) : {};\n  for (const [key, value] of Object.entries(patch)) {\n    if (value === null) delete out[key];\n    else out[key] = applyMergePatch(out[key], value);\n  }\n  return out;\n}\n"}}}
