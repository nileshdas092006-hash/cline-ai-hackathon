      new RegExp(f.pattern);\n152 |         return true;\n153 |       } catch {\n154 |         return false;\n155 |       }\n156 |     },\n157 |     { message: \"pattern must be a valid regular expression\", path: [\"pattern\"] },\n158 |   );\n159 | export type FieldCheckRule = z.infer<typeof FieldCheckRule>;\n160 | \n161 | export const ExternalCheckRule = z.object({\n162 |   id: z.string().regex(SNAKE_ID),\n163 |   labelEn: z.string().min(1),\n164 |   labelAs: z.string().min(1),\n165 |   howEn: z.string().min(1),\n166 |   howAs: z.string().min(1),\n167 |   fixWhere: FixWhere,\n168 |   provenance: RuleProvenance,\n169 | });\n170 | export type ExternalCheckRule = z.infer<typeof ExternalCheckRule>;\n171 | \n172 | export const AgeRange = z\n173 |   .object({\n174 |     min: z.int().nonnegative(),\n175 |     max: z.int().nonnegative(),\n176 |     dobFrom: DocType,\n177 |     aboveMaxHintEn: z.string().optional(),\n178 |     aboveMaxHintAs: z.string().optional(),\n179 |     provenance: RuleProvenance,\n180 |   })\n181 |   .refine((a) => a.min <= a.max, { message: \"min must be ≤ max\" });\n182 | export type AgeRange = z.infer<typeof AgeRange>;\n183 | \n184 | export const BenefitOverride = z\n185 |   .object({\n186 |     from: IsoDate,\n187 |     to: IsoDate,\n188 |     centralShare: z.number().nonnegative().optional(),\n189 |     stateTopUp: z.number().nonnegative().nullable().optional(),\n190 |     noteEn: z.string().min(1),\n191 |     noteAs: z.string().min(1),\n192 |     provenance: RuleProvenance,\n193 |   })\n194 |   .refine((o) => o.from <= o.to, { message: \"override 'to' must not be before 'from'\", path: [\"to\"] });\n195 | export type BenefitOverride = z.infer<typeof BenefitOverride>;\n196 | \n197 | export const Benefit = z.object({\n198 |   centralShare: z.number().nonnegative(),\n199 |   /** null = unconfirmed; never show a total then. */\n200 |   stateTopUp: z.number().nonnegative().nullable(),\n201 |   period: z.enum([\"month\", \"year\"]),\n202 |   instalments: z.int().positive().optional(),\n203 |   effectiveDate: IsoDate.nullable().optional(),\n204 |   provenance: RuleProvenance,\n205 |   /** Time-bounded changes (e.g. a one-time payment for one month). Later entries win. */\n206 |   overrides: z.array(BenefitOverride).default([]),\n207 | });\n208 | export type Benefit = z.infer<typeof Benefit>;\n209 | \n210 | export const SchemeNote = z.object({\n211 |   id: z.string().regex(SNAKE_ID),\n212 |   textEn: z.string().min(1),\n213 |   textAs: z.string().min(1),\n214 |   provenance: RuleProvenance,\n215 | });\n216 | export type SchemeNote = z.infer<typeof SchemeNote>;\n217 | \n218 | // ---------- scheme rule pack ----------\n219 | export const SchemeRule = z.object({\n220 |   id: z.string().regex(SCHEME_ID),\n221 |   version: z.string().regex(SEMVER),\n222 |   nameEn: z.string().min(1),\n223 |   nameAs: z.string().min(1),\n224 |   /** Default place to confirm provisional rules. */\n225 |   confirmAt: FixWhere,\n226 |   benefit: Benefit,\n227 |   mandatoryDocs: z.array(DocRequirement),\n228 |   supportingDocs: z.array(DocRequirement).default([]),\n229 |   supportingDocsNoteEn: z.string().nullable().default(null),\n230 |   supportingDocsNoteAs: z.string().nullable().default(null),\n231 |   /** The document every other name is compared with. */\n232 |   nameReference: DocType,\n233 |   nameChecks: z.array(NameCheckRule).default([]),\n234 |   fieldChecks: z.array(FieldCheckRule).default([]),\n235 |   ageRange: AgeRange.optional(),\n236 |   /** Every one must be \"yes\". */\n237 |   requirements: z.array(Question).default([]),\n238 |   /** At least one must be \"yes\" (skipped when empty). */\n239 |   eligibilityAnyOf: z.array(Question).default([]),\n240 |   /** Any \"yes\" excludes (verified) or needs verification (provisional). */\n241 |   exclusions: z.array(Question).default([]),\n242 |   /** Facts a photo cannot prove: always needs_verification. */\n243 |   externalChecks: z.array(ExternalCheckRule).default([]),\n244 |   notes: z.array(SchemeNote).default([]),\n245 | });\n246 | export type SchemeRule = z.infer<typeof SchemeRule>;\n247 | export type SchemeRuleInput = z.input<typeof SchemeRule>;\n248 | \n249 | // ---------- results ----------\n250 | export const NameMatchLevel = z.enum([\"same\", \"possible_match\", \"initials_only\", \"mismatch\"]);\n251 | export type NameMatchLevel = z.infer<typeof NameMatchLevel>;\n252 | export const NameMatchResult = z.object({ level: NameMatchLevel, score: z.number().min(0).max(1) });\n253 | export type NameMatchResult = z.infer<typeof NameMatchResult>;\n254 | \n255 | export const CheckResult = z.enum([\"ok\", \"action_required\", \"needs_verification\", \"not_applicable\"]);\n256 | export type CheckResult = z.infer<typeof CheckResult>;\n257 | \n258 | export const CheckKind = z.enum([\"document\", \"name\", \"field\", \"eligibility\", \"external\"]);\n259 | export type CheckKind = z.infer<typeof CheckKind>;\n260 | \n261 | export const Check = z.object({\n262 |   id: z.string().min(1),\n263 |   kind: CheckKind,\n264 |   result: CheckResult,\n265 |   messageEn: z.string().min(1),\n266 |   messageAs: z.string().min(1),\n267 |   fixWhere: FixWhere,\n268 |   provenance: RuleProvenance,\n269 |   docType: DocType.optional(),\n270 |   match: NameMatchResult.optional(),\n271 | });\n272 | export type Check = z.infer<typeof Check>;\n273 | \n274 | export const Eligibility = z.enum([\"likely_eligible\", \"not_eligible\", \"needs_verification\"]);\n275 | export type Eligibility = z.infer<typeof Eligibility>;\n276 | export const Readiness = z.enum([\"ready_for_review\", \"action_required\", \"needs_verification\"]);\n277 | export type Readiness = z.infer<typeof Readiness>;\n278 | \n279 | export const BenefitOn = z.object({\n280 |   centralShare: z.number().nonnegative(),\n281 |   stateTopUp: z.number().nonnegative().nullable(),\n282 |   /** null when the state top-up is unconfirmed. */\n283 |   total: z.number().nonnegative().nullable(),\n284 |   period: z.enum([\"month\", \"year\"]),\n285 |   instalments: z.int().positive().optional(),\n286 |   isOverride: z.boolean(),\n287 |   noteEn: z.string().optional(),\n288 |   noteAs: z.string().optional(),\n289 |   provenance: RuleProvenance,\n290 | });\n291 | export type BenefitOn = z.infer<typeof BenefitOn>;\n292 | \n293 | export const SupportingDocStatus = z.object({\n294 |   docType: DocType,\n295 |   labelEn: z.string(),\n296 |   labelAs: z.string(),\n297 |   present: z.boolean(),\n298 |   provenance: RuleProvenance,\n299 | });\n300 | export type SupportingDocStatus = z.infer<typeof SupportingDocStatus>;\n301 | \n302 | export const Report = z.object({\n303 |   schemeId: z.string(),\n304 |   schemeVersion: z.string(),\n305 |   asOfDate: IsoDate,\n306 |   eligibility: Eligibility,\n307 |   readiness: Readiness,\n308 |   checks: z.array(Check),\n309 |   benefit: BenefitOn,\n310 |   supportingDocs: z.array(SupportingDocStatus),\n311 |   supportingDocsNoteEn: z.string().nullable(),\n312 |   supportingDocsNoteAs: z.string().nullable(),\n313 |   disclaimerEn: z.string(),\n314 |   disclaimerAs: z.string(),\n315 | });\n316 | export type Report = z.infer<typeof Report>;\n317 | ","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\core\\schemes\\index.ts","result":" 1 | // Scheme registry: built-in rule packs plus versions registered at runtime (T3 agent). Pure, in-memory.\n 2 | // Old versions are kept; getScheme(id) returns the newest.\n 3 | import { SchemeRule, type Question, type SchemeRuleInput } from \"../types\";\n 4 | import { nsapWidow } from \"./nsap-widow\";\n 5 | import { orunodoi3 } from \"./orunodoi-3\";\n 6 | import { pmKisan } from \"./pm-kisan\";\n 7 | \n 8 | const registry = new Map<string, SchemeRule[]>();\n 9 | \n10 | function compareVersions(a: string, b: string): number {\n11 |   const pa = a.split(\".\").map(Number);\n12 |   const pb = b.split(\".\").map(Number);\n13 |   for (let i = 0; i < 3; i++) {\n14 |     if (pa[i] !== pb[i]) return pa[i] - pb[i];\n15 |   }\n16 |   return 0;\n17 | }\n18 | \n19 | /** Validates and adds a scheme version. Throws if invalid or the same id+version exists. */\n20 | export function registerScheme(rule: SchemeRuleInput): SchemeRule {\n21 |   const parsed = SchemeRule.parse(rule);\n22 |   const versions = registry.get(parsed.id) ?? [];\n23 |   if (versions.some((v) => v.version === parsed.version)) {\n24 |     throw new Error(`scheme ${parsed.id}@${parsed.version} is already registered`);\n25 |   }\n26 |   versions.push(parsed);\n27 |   versions.sort((a, b) => compareVersions(a.version, b.version));\n28 |   registry.set(parsed.id, versions);\n29 |   return parsed;\n30 | }\n31 | \n32 | /** The newest version, or a specific one. */\n33 | export function getScheme(id: string, version?: string): SchemeRule | undefined {\n34 |   const versions = registry.get(id);\n35 |   if (!versions || versions.length === 0) return undefined;\n36 |   if (version === undefined) return versions[versions.length - 1];\n37 |   return versions.find((v) => v.version === version);\n38 | }\n39 | \n40 | /** The newest version of every scheme. */\n41 | export function listSchemes(): SchemeRule[] {\n42 |   return [...registry.values()].map((v) => v[v.length - 1]);\n43 | }\n44 | \n45 | export function listSchemeVersions(id: string): string[] {\n46 |   return (registry.get(id) ?? []).map((v) => v.version);\n47 | }\n48 | \n49 | /** Every yes/no question the user should answer for a scheme, in display order. */\n50 | export function questionsFor(scheme: SchemeRule): Question[] {\n51 |   return [\n52 |     ...scheme.requirements,\n53 |     ...scheme.eligibilityAnyOf,\n54 |     ...scheme.exclusions,\n55 |     ...scheme.nameChecks.flatMap((n) => (n.familyOwnerQuestion ? [n.familyOwnerQuestion] : [])),\n56 |   ];\n57 | }\n58 | \n59 | for (const s of [pmKisan, orunodoi3, nsapWidow]) registerScheme(s);","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\core\\schemes\\orunodoi-3.ts","result":"  1 | // Orunodoi 3.0, Assam (id `orunodoi-3`). docs/schemes.md §2. Pure data, validated by SchemeRule.\n  2 | // Verified: valid ration card, ₹1,250/month, no income certificate. Everything else is PROVISIONAL\n  3 | // (secondary sources / 2020 guideline): it can only ever lead to needs_verification.\n  4 | import { SchemeRule, type DocType, type Question } from \"../types\";\n  5 | import { SOURCES, provisional, verified } from \"./sources\";\n  6 | \n  7 | const official = verified(SOURCES.orunodoiOfficial);\n  8 | const secondary = (clause: string) => provisional(SOURCES.orunodoiSecondary, clause);\n  9 | \n 10 | type Q = Omit<Question, \"provenance\" | \"fixWhere\">;\n 11 | const pq = (q: Q, clause: string): Question => ({ ...q, fixWhere: \"gram_panchayat\", provenance: secondary(clause) });\n 12 | \n 13 | const anyOf: Q[] = [\n 14 |   { id: \"widow\", labelEn: \"widow\", labelAs: \"বিধৱা\", textEn: \"Is the woman applicant a widow?\", textAs: \"মহিলা আবেদনকাৰী গৰাকী বিধৱা নেকি?\" },\n 15 |   {\n 16 |     id: \"person_with_disability\",\n 17 |     labelEn: \"person with disability in the family\",\n 18 |     labelAs: \"পৰিয়ালত দিব্যাংগ ব্যক্তি\",\n 19 |     textEn: \"Is there a person with a disability in your family?\",\n 20 |     textAs: \"আপোনাৰ পৰিয়ালত কোনো দিব্যাংগ ব্যক্তি আছে নেকি?\",\n 21 |   },\n 22 |   {\n 23 |     id: \"aay_card\",\n 24 |     labelEn: \"Antyodaya (AAY) card holder\",\n 25 |     labelAs: \"অন্ত্যোদয় (AAY) কাৰ্ডধাৰী\",\n 26 |     textEn: \"Does your family have an Antyodaya Anna Yojana (AAY) ration card?\",\n 27 |     textAs: \"আপোনাৰ পৰিয়ালৰ অন্ত্যোদয় অন্ন যোজনা (AAY) ৰেচন কাৰ্ড আছে নেকি?\",\n 28 |   },\n 29 |   {\n 30 |     id: \"income_below_2_lakh\",\n 31 |     labelEn: \"household income under ₹2 lakh a year\",\n 32 |     labelAs: \"বছৰি ₹২ লাখতকৈ কম পাৰিবাৰিক আয়\",\n 33 |     textEn: \"Is your household income less than ₹2 lakh a year?\",\n 34 |     textAs: \"আপোনাৰ পাৰিবাৰিক আয় বছৰি ₹২ লাখতকৈ কম নেকি?\",\n 35 |   },\n 36 | ];\n 37 | \n 3