15 |   nameChecks: [\n116 |     { docType: \"aadhaar\", field: \"name\", fixWhere: \"aadhaar_centre\", provenance: official },\n117 |     { docType: \"bank_passbook\", field: \"name\", fixWhere: \"bank\", provenance: official },\n118 |   ],\n119 |   requirements: [\n120 |     pq(\n121 |       {\n122 |         id: \"nfsa_enrolled\",\n123 |         labelEn: \"enrolled under NFSA\",\n124 |         labelAs: \"NFSAৰ অধীনত পঞ্জীভুক্ত\",\n125 |         textEn: \"Is your family enrolled under the National Food Security Act (NFSA)?\",\n126 |         textAs: \"আপোনাৰ পৰিয়াল ৰাষ্ট্ৰীয় খাদ্য সুৰক্ষা আইন (NFSA)ৰ অধীনত পঞ্জীভুক্ত নেকি?\",\n127 |       },\n128 |       \"NFSA enrolment precondition (myScheme; the official page says only 'valid ration card')\",\n129 |     ),\n130 |   ],\n131 |   eligibilityAnyOf: anyOf.map((q) => pq(q, \"Eligibility any-of list (2020 guideline; not confirmed for 3.0)\")),\n132 |   exclusions: exclusions.map((q) => pq(q, \"Exclusion list (2020 guideline; not confirmed for 3.0)\")),\n133 |   externalChecks: [\n134 |     {\n135 |       id: \"ration_card_valid\",\n136 |       labelEn: \"ration card is valid and active\",\n137 |       labelAs: \"ৰেচন কাৰ্ড বৈধ আৰু সক্ৰিয়\",\n138 |       howEn: \"Check at the fair price shop or the food and civil supplies office that the card is active.\",\n139 |       howAs: \"কাৰ্ডখন সক্ৰিয় নে নাই, ন্যায্য মূল্যৰ দোকান বা খাদ্য আৰু অসামৰিক যোগান কাৰ্যালয়ত চাওক।\",\n140 |       fixWhere: \"supply_office\",\n141 |       provenance: official,\n142 |     },\n143 |   ],\n144 |   notes: [\n145 |     {\n146 |       id: \"no_income_certificate\",\n147 |       textEn: \"No income certificate is required.\",\n148 |       textAs: \"আয়ৰ প্ৰমাণপত্ৰৰ প্ৰয়োজন নাই।\",\n149 |       provenance: verified(SOURCES.orunodoiOfficial, \"No income certificate required\"),\n150 |     },\n151 |     {\n152 |       id: \"selection_by_checklist\",\n153 |       textEn: \"Preliminary selection is based on an undertaking-cum-checklist (Annexure A).\",\n154 |       textAs: \"প্ৰাথমিক বাছনি অংগীকাৰ-তথা-পৰীক্ষা তালিকা (Annexure A)ৰ ভিত্তিত হয়।\",\n155 |       provenance: official,\n156 |     },\n157 |   ],\n158 | });\n159 | ","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\core\\benefit.ts","result":" 1 | // Benefit amount on a given date, with time-bounded overrides. Pure.\n 2 | import { assertIsoDate } from \"./dates\";\n 3 | import type { BenefitOn, SchemeRule } from \"./types\";\n 4 | \n 5 | /**\n 6 |  * The benefit that applies on `date` (YYYY-MM-DD). Overrides are inclusive\n 7 |  * date windows; when several match, the last one listed wins.\n 8 |  * `total` is null whenever the state top-up is unconfirmed (never show an unconfirmed total).\n 9 |  */\n10 | export function benefitOn(scheme: SchemeRule, date: string): BenefitOn {\n11 |   assertIsoDate(date, \"date\");\n12 |   const base = scheme.benefit;\n13 |   const override = [...base.overrides].reverse().find((o) => o.from <= date && date <= o.to);\n14 | \n15 |   const centralShare = override?.centralShare ?? base.centralShare;\n16 |   const stateTopUp = override && override.stateTopUp !== undefined ? override.stateTopUp : base.stateTopUp;\n17 | \n18 |   return {\n19 |     centralShare,\n20 |     stateTopUp,\n21 |     total: stateTopUp === null ? null : centralShare + stateTopUp,\n22 |     period: base.period,\n23 |     ...(base.instalments !== undefined ? { instalments: base.instalments } : {}),\n24 |     isOverride: override !== undefined,\n25 |     ...(override ? { noteEn: override.noteEn, noteAs: override.noteAs } : {}),\n26 |     provenance: override ? override.provenance : base.provenance,\n27 |   };\n28 | }","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\core\\flow.ts","result":"  1 | // Pure helpers for the main flow (documents → confirm fields → questions). No React here.\n  2 | // Deliberately does not import the engine or the registry, so the client bundle stays small.\n  3 | import { DOC_FIELDS, splitNames } from \"./docFields\";\n  4 | import { lastFourDigits, normalizeDob } from \"./extraction\";\n  5 | import { LOW_CONFIDENCE_THRESHOLD } from \"./thresholds\";\n  6 | import type { Answers, DocType, ExtractedDoc, FieldName, Question, SchemeRule } from \"./types\";\n  7 | \n  8 | export { DOC_FIELDS } from \"./docFields\";\n  9 | \n 10 | export interface DocSlot {\n 11 |   docType: DocType;\n 12 |   /** Mandatory for the scheme; otherwise only used to compare names or read the age. */\n 13 |   required: boolean;\n 14 | }\n 15 | \n 16 | /** Documents to ask for: mandatory ones first, then those used only for name/age checks. */\n 17 | export function docSlotsFor(scheme: SchemeRule): DocSlot[] {\n 18 |   const slots: DocSlot[] = scheme.mandatoryDocs.map((d) => ({ docType: d.docType, required: true }));\n 19 |   const extra: DocType[] = [\n 20 |     scheme.nameReference,\n 21 |     ...scheme.nameChecks.map((n) => n.docType),\n 22 |     ...(scheme.ageRange ? [scheme.ageRange.dobFrom] : []),\n 23 |   ];\n 24 |   for (const docType of extra) {\n 25 |     if (!slots.some((s) => s.docType === docType)) slots.push({ docType, required: false });\n 26 |   }\n 27 |   return slots;\n 28 | }\n 29 | \n 30 | export function blankDoc(docType: DocType): ExtractedDoc {\n 31 |   return { docType, fields: {}, confidence: {} };\n 32 | }\n 33 | \n 34 | /** True when the reader was unsure about this field and the user has not confirmed it yet. */\n 35 | export function needsConfirmation(doc: ExtractedDoc, field: FieldName): boolean {\n 36 |   const c = doc.confidence[field];\n 37 |   return c !== undefined && c < LOW_CONFIDENCE_THRESHOLD;\n 38 | }\n 39 | \n 40 | export function unconfirmedCount(docs: readonly ExtractedDoc[]): number {\n 41 |   return docs.reduce((n, d) => n + DOC_FIELDS[d.docType].filter((f) => needsConfirmation(d, f)).length, 0);\n 42 | }\n 43 | \n 44 | function withoutConfidence(doc: ExtractedDoc, field: FieldName): ExtractedDoc[\"confidence\"] {\n 45 |   const confidence = { ...doc.confidence };\n 46 |   delete confidence[field];\n 47 |   return confidence;\n 48 | }\n 49 | \n 50 | /** The user typed `input` into `field`: store it (parsed) and mark it as entered by the user. */\n 51 | export function setField(doc: ExtractedDoc, field: FieldName, input: string): ExtractedDoc {\n 52 |   const fields: ExtractedDoc[\"fields\"] = { ...doc.fields };\n 53 |   const trimmed = input.trim().replace(/[ \\t]+/g, \" \");\n 54 |   delete fields[field];\n 55 |   switch (field) {\n 56 |     case \"aadhaarLast4\": {\n 57 |       const v = lastFourDigits(trimmed);\n 58 |       if (v !== undefined) fields.aadhaarLast4 = v;\n 59 |       break;\n 60 |     }\n 61 |     case \"ownerNames\": {\n 62 |       const v = splitNames(input);\n 63 |       if (v.length > 0) fields.ownerNames = v;\n 64 |       break;\n 65 |     }\n 66 |     case \"landAreaHectares\": {\n 67 |       const v = Number(trimmed);\n 68 |       if (trimmed !== \"\" && Number.isFinite(v) && v >= 0) fields.landAreaHectares = v;\n 69 |       break;\n 70 |     }\n 71 |     case \"dob\":\n 72 |       if (trimmed !== \"\") fields.dob = normalizeDob(trimmed);\n 73 |       break;\n 74 |     default:\n 75 |       if (trimmed !== \"\") fields[field] = trimmed;\n 76 |   }\n 77 |   return { ...doc, fields, confidence: withoutConfidence(doc, field) };\n 78 | }\n 79 | \n 80 | /** The user checked a low-confidence value and says it is right. */\n 81 | export function confirmField(doc: ExtractedDoc, field: FieldName): ExtractedDoc {\n 82 |   return { ...doc, confidence: withoutConfidence(doc, field) };\n 83 | }\n 84 | \n 85 | /** The current value as text for an input box. */\n 86 | export function fieldText(doc: ExtractedDoc, field: FieldName): string {\n 87 |   const v = doc.fields[field];\n 88 |   if (v === undefined) return \"\";\n 89 |   return Array.isArray(v) ? v.join(\"\\n\") : String(v);\n 90 | }\n 91 | \n 92 | /** Adds a document, replacing any document of the same type in place. */\n 93 | expo