{"ts":"2026-10-10T10:12:13.899Z","type":"agent_event","event":{"type":"content_end","contentType":"tool","toolName":"read_files","toolCallId":"toolu_015HB4W63rTGYMnwpxSkH4J2","output":[{"query":"C:\\Dev\\cline hackathon\\build\\src\\core\\schemes\\pm-kisan.ts:1-40","result":" 1 | // PM-KISAN (id `pm-kisan`): flagship demo. docs/schemes.md §1. Pure data, validated by SchemeRule.\n 2 | // NOTE: there is deliberately NO landholding-size rule (the earlier limit was removed in 2019).\n 3 | import { SchemeRule, type SchemeRuleInput } from \"../types\";\n 4 | import { SOURCES, verified } from \"./sources\";\n 5 | \n 6 | const core = verified(SOURCES.pmKisanPortal);\n 7 | const exclusion = (clause: string) => verified(SOURCES.pmKisanGuide, `Exclusion criteria: ${clause}`);\n 8 | \n 9 | const exclusions: SchemeRuleInput[\"exclusions\"] = [\n10 |   {\n11 |     id: \"holds_constitutional_post\",\n12 |     labelEn: \"holds or held a constitutional post\",\n13 |     labelAs: \"সাংবিধানিক পদত আছে বা আছিল\",\n14 |     textEn: \"Does anyone in your family hold, or did they hold, a constitutional post?\",\n15 |     textAs: \"আপোনাৰ পৰিয়ালৰ কোনোবাই সাংবিধানিক পদত আছে নেকি বা আছিল নেকি?\",\n16 |     provenance: exclusion(\"former and present holders of constitutional posts\"),\n17 |   },\n18 |   {\n19 |     id: \"govt_employee\",\n20 |     labelEn: \"serving or retired government employee\",\n21 |     labelAs: \"কৰ্মৰত বা অৱসৰপ্ৰাপ্ত চৰকাৰী কৰ্মচাৰী\",\n22 |     textEn: \"Is anyone in your family a serving or retired government employee (not MTS, Class IV or Group D)?\",\n23 |     textAs: \"আপোনাৰ পৰিয়ালৰ কোনোবা কৰ্মৰত বা অৱসৰপ্ৰাপ্ত চৰকাৰী কৰ্মচাৰী নেকি (MTS, চতুৰ্থ শ্ৰেণী বা গ্ৰুপ D বাদে)?\",\n24 |     provenance: exclusion(\"serving or retired officers and employees of government (except MTS/Class IV/Group D)\"),\n25 |   },\n26 |   {\n27 |     id: \"income_tax_payer\",\n28 |     labelEn: \"paid income tax in the last assessment year\",\n29 |     labelAs: \"যোৱা মূল্যায়ন বৰ্ষত আয