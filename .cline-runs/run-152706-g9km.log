ntent-Type\": \"application/json\" },\n 47 |         body: JSON.stringify({ image, docType }),\n 48 |       });\n 49 |       const data: unknown = await res.json();\n 50 |       const parsed = ExtractedDoc.safeParse((data as { doc?: unknown })?.doc);\n 51 |       if (res.ok && parsed.success) doc = parsed.data;\n 52 |       else if ((data as { error?: unknown })?.error === \"ai_unavailable\") onAiOff();\n 53 |       else setFailed(docType);\n 54 |     } catch {\n 55 |       setFailed(docType);\n 56 |     } finally {\n 57 |       // Whatever happened, the user can now check or type the details on the next screen.\n 58 |       onDocs(upsertDoc(docs, doc));\n 59 |       setBusy(null);\n 60 |     }\n 61 |   }\n 62 | \n 63 |   return (\n 64 |     <div className=\"flex flex-col gap-4\">\n 65 |       <p className=\"text-base text-zinc-700\">{t.docs.intro}</p>\n 66 |       {aiOff && (\n 67 |         <p role=\"status\" className=\"rounded-xl bg-amber-50 p-3 text-amber-950\">\n 68 |           {t.docs.aiUnavailable}\n 69 |         </p>\n 70 |       )}\n 71 | \n 72 |       <ul className=\"flex flex-col gap-3\">\n 73 |         {scheme.slots.map((slot) => {\n 74 |           const added = has(slot.docType);\n 75 |           return (\n 76 |             <li key={slot.docType}>\n 77 |               <Card className={added ? \"border-green-600\" : \"\"}>\n 78 |                 <div className=\"flex flex-wrap items-center justify-between gap-2\">\n 79 |                   <h2 className=\"text-lg font-semibold\">{docTitle(lang, slot.docType)}</h2>\n 80 |                   <Badge tone={slot.required ? \"teal\" : \"zinc\"}>{slot.required ? t.docs.required : t.docs.optional}</Badge>\n 81 |                 </div>\n 82 |                 <p className={`mt-1 text-sm font-medium ${added ? \"text-green-800\" : \"text-zinc-600\"}`}>\n 83 |                   {added ? `✓ ${t.docs.added}` : t.docs.notAdded}\n 84 |                 </p>\n 85 |                 {busy === slot.docType ? (\n 86 |                   <p role=\"status\" className=\"mt-3 text-base\">\n 87 |                     ⏳ {t.docs.reading}\n 88 |                   </p>\n 89 |                 ) : (\n 90 |                   <div className=\"mt-3 flex flex-wrap gap-2\">\n 91 |                     <label className={`${btn.secondary} cursor-pointer`}>\n 92 |                       📷 {t.docs.photo}\n 93 |                       <input\n 94 |                         type=\"file\"\n 95 |                         accept=\"image/*\"\n 96 |                         capture=\"environment\"\n 97 |                         className=\"sr-only\"\n 98 |                         disabled={busy !== null}\n 99 |                         onChange={(e) => {\n100 |                           const file = e.target.files?.[0];\n101 |                           e.target.value = \"\";\n102 |                           if (file) void readPhoto(slot.docType, file);\n103 |                         }}\n104 |                       />\n105 |                     </label>\n106 |                     {added ? (\n107 |                       <button type=\"button\" className={btn.quiet} onClick={() => onDocs(removeDoc(docs, slot.docType))}>\n108 |                         {t.docs.remove}\n109 |                       </button>\n110 |                     ) : (\n111 |                       <button type=\"button\" className={btn.quiet} onClick={() => onDocs(upsertDoc(docs, blankDoc(slot.docType)))}>\n112 |                         ✏️ {t.docs.type}\n113 |                       </button>\n114 |                     )}\n115 |                   </div>\n116 |                 )}\n117 |                 {failed === slot.docType && (\n118 |                   <p role=\"alert\" className=\"mt-2 text-sm text-red-800\">\n119 |                     {t.docs.aiFailed}\n120 |                   </p>\n121 |                 )}\n122 |               </Card>\n123 |             </li>\n124 |           );\n125 |         })}\n126 |       </ul>\n127 |       <p className=\"text-sm text-zinc-600\">🔒 {t.docs.privacy}</p>\n128 | \n129 |       {samples.length > 0 && (\n130 |         <Card className=\"border-dashed border-violet-400 bg-violet-50/50\">\n131 |           <h2 className=\"text-lg font-semibold\">{t.docs.samplesTitle}</h2>\n132 |           <ul className=\"mt-2 flex flex-col gap-2\">\n133 |             {samples.map((s) => (\n134 |               <li key={s.id}>\n135 |                 <button type=\"button\" className={`${btn.secondary} w-full justify-start text-left`} onClick={() => onSample(s)}>\n136 |                   🧪 {pick(lang, s.titleEn, s.titleAs)}\n137 |                 </button>\n138 |               </li>\n139 |             ))}\n140 |           </ul>\n141 |         </Card>\n142 |       )}\n143 | \n144 |       {missingRequired > 0 && <p className=\"text-sm text-amber-900\">{t.docs.missingRequired(missingRequired)}</p>}\n145 |       <button type=\"button\" className={btn.primary} onClick={onNext} disabled={busy !== null}>\n146 |         {t.next} →\n147 |       </button>\n148 |     </div>\n149 |   );\n150 | }","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\app\\_components\\KaagazApp.tsx","result":"  1 | \"use client\";\n  2 | // The one main flow: scheme → documents → confirm fields → questions → two-verdict report.\n  3 | // The browser never decides anything: the report comes from /api/check (the rule engine).\n  4 | import { useEffect, useRef, useState } from \"react\";\n  5 | import { APP_NAME, APP_NAME_AS, APP_TAGLINE_AS, APP_TAGLINE_EN } from \"@/core/appInfo\";\n  6 | import type { SchemeView } from \"@/core/catalog\";\n  7 | import { relevantAnswers } from \"@/core/flow\";\n  8 | import type { SampleSet } from \"@/core/samples\";\n  9 | import { Report, type Answers, type ExtractedDoc } from \"@/core/types\";\n 10 | import { DEFAULT_LANG, STRINGS, type Lang } from \"@/i18n\";\n 11 | import { ConfirmStep } from \"./ConfirmStep\";\n 12 | import { CoverSheet } from \"./CoverSheet\";\n 13 | import { DocsStep } from \"./DocsStep\";\n 14 | import { QuestionsStep } from \"./QuestionsStep\";\n 15 | import { ReportStep, type ReportState } from \"./ReportStep\";\n 16 | import { SchemeStep } from \"./SchemeStep\";\n 17 | import { DemoLabel, btn } from \"./ui\";\n 18 | \n 19 | const STEPS = [\"scheme\", \"docs\", \"confirm\", \"questions\", \"report\"] as const;\n 20 | type Step = (typeof STEPS)[number];\n 21 | const BACK: Partial<Record<Step, Step>> = { docs: \"scheme\", confirm: \"docs\", questions: \"confirm\", report: \"questions\" };\n 22 | \n 23 | export function KaagazApp({ catalog, samples }: { catalog: SchemeView[]; samples: SampleSet[] }) {\n 24 |   const [lang, setLang] = useState<Lang>(DEFAULT_LANG);\n 25 |   const [step, setStep] = useState<Step>(\"scheme\");\n 26 |   const [schemeId, setSchemeId] = useState<string | null>(null);\n 27 |   const [docs, setDocs] = useState<ExtractedDoc[]>([]);\n 28 |   const [answers, setAnswers] = useState<Answers>({});\n 29 |   const [sampleId, setSampleId] = useState<SampleSet[\"id\"] | null>(null);\n 30 |   const [aiOff, setAiOff] = useState(false);\n 31 |   const [reportState, setReportState] = useState<ReportState>({ status: \"idle\" });\n 32 |   const headingRef = useRef<HTMLHeadingElement>(null);\n 33 |   const requestId = useRef(0);\n 34 |   const firstRender = useRef(true);\n 35 | \n 36 |   const t = STRINGS[lang];\n 37 |   const scheme = catalog.find((s) => s.id === schemeId) ?? null;\n 38 |   const stepNo = STEPS.indexOf(step) + 1;\n 39 | \n 40 |   useEffect(() => {\n 41 |     document.documentElement.lang = lang;\n 42 |   }, [lang]);\n 43 | \n 44 |   useEffect(() => {\n 45 |     // Move focus to the new screen's heading (screen readers), but not on first load.\n 46 |     if (firstRender.current) {\n 47 |       firstRender.current = false;\n 48 |       return;\n 49 |     }\n 50 |     window.scrollTo({ top: 0 });\n 51 |     headingRef.current?.focus({ preventScroll: true });\n 52 |   }, [step]);\n 53 | \n 54 |   function reset() {\n 55 |     requestId.current++;\n 56 |     setDocs([]);\n 57 |     setAnswers({});\n 58 |     setSampleId(null);\n 59 |     setReportState({ status: \"idle\" });\n 60 |   }\n 61 | \n 62 |   function chooseScheme(id: string) {\n 63 |     if (id !== schemeId) {\n 64 |       reset();\n 65 |       setSchemeId(id);\n 66 |     }\n 67 |     setStep(\"docs\");\n 68 |   }\n 69 | \n 70 |   function chooseSample(sample: SampleSet) {\n 71 |     reset();\n 72 |     setSchemeId(sample.schemeId);\n 73 |     setDocs(sample.docs);\n 74 |     setAnswers(sample.answers);\n 75 |     setSampleId(sample.id);\n 76 |     setStep(\"confirm\");\n 77 |   }\n 78 | \n 79 |   function startOver() {\n 80 |     reset();\n 81 |     setSchemeId(null);\n 82 |     setStep(\"scheme\");\n 83 |   }\n 84 | \n 85 |   async function runCheck() {\n 86 |     if (!scheme) return;\n 87 |     const id = ++requestId.current;\n 88 |     setStep(\"report\");\n 89 |     setReportState({ status: \"loading\" });\n 90 |     try {\n 91 |       const res = await fetch(\"/api/check\", {\n 92 |         method: \"POST\",\n 93 |         headers: { \"Content-Type\": \"application/json\" },\n 94 |         body: JSON.stringify({\n 95 |           schemeId: scheme.id,\n 96 |           schemeVersion: scheme.version,\n 97 |           docs,\n 98 |           answers: relevantAnswers(scheme.questions, answers),\n 99 |         }),\n100 |       });\n101 |       const parsed = Report.safeParse(await res.json());\n102 |       if (id !== requestId.current) return;\n103 |       setReportState(res.ok && parsed.success ? { status: \"done\", report: parsed.data } : { status: \"error\" });\n104 |     } catch {\n105 |       if (id === requestId.current) setReportState({ status: \"error\" });\n106 |     }\n107 |   }\n108 | \n109 |   const titles: Record<Step, string> = {\n110 |     scheme: t.scheme.title,\n111 |     docs: t.docs.title,\n112 |     confirm: t.confirm.title,\n113 |     questions: t.questions.title,\n114 |     report: scheme ? (lang === \"as\" ? scheme.nameAs : scheme.nameEn) : \"\",\n115 |   };\n116 |   const backTo = BACK[step];\n117 |   const report = reportState.status === \"done\" ? reportState.report : null;\n118 | \n119 |   return (\n120 |     <>\n121 |       <div className=\"mx-auto flex w-full max-w-xl flex-1 flex-col gap-4 px-4 pb-10 pt-4 print:hidden\">\n122 |         <header className=\"flex items-start justify-between gap-3\">\n123 |           <div>\n124 |             <p className=\"text-xl font-bold leading-tight\">\n125 |               <span lang=\"en\">{APP_NAME}</span> · {APP_NAME_AS}\n126 |             </p>\n127 |             <p className=\"text-sm text-zinc-600\">{lang === \"as\" ? APP_TAGLINE_AS : APP_TAGLINE_EN}</p>\n128 |           </div>\n129 |           <button\n130 |             type=\"button\"\n131 |             className={btn.secondary}\n132 |             onClick={() => setLang(lang === \"as\" ? \"en\" : \"as\")}\n133 |             aria-label={t.langToggleAria}\n134 |             lang={lang === \"as\" ? \"en\" : \"as\"}\n135 |           >\n136 |             {t.langToggle}\n137 |           </button>\n138 |         </header>\n139 | \n140 |         <div>\n141 |           <p className=\"text-sm font-medium text-zinc-600\">{t.stepOf(stepNo, STEPS.length)}</p>\n142 |           <div className=\"mt-1 h-2 rounded-full bg-zinc-200\" aria-hidden=\"true\">\n143 |             <div className=\"h-2 rounded-full bg-teal-600 transition-all\" style={{ width: `${(stepNo / STEPS.length) * 100}%` }} />\n144 |           </div>\n145 |         </div>\n146 | \n147 |         {sampleId && <DemoLabel text={`${t.demoMode} (${sampleId})`} />}\n148 | \n149 |         <main className=\"flex flex-col gap-4\">\n150 |           <h1 ref={headingRef} tabIndex={-1} className=\"text-2xl font-bold leading-snug outline-none\">\n151 |             {titles[step]}\n152 |           </h1>\n153 | \n154 |           {step === \"scheme\" && <SchemeStep lang={lang} catalog={catalog} selected={schemeId} onChoose={chooseScheme} />}\n155 |           {step === \"docs\" && scheme && (\n156 |             <DocsStep\n157 |               lang={lang}\n158 |               scheme={scheme}\n159 |               docs={docs}\n160 |               samples={samples.filter((s) => s.schemeId === scheme.id)}\n161 |               aiOff={aiOff}\n162 |               onAiOff={() => setAiOff(true)}\n163 |               onDocs={setDocs}\n164 |               onSample={chooseSample}\n165 |               onNext={() => setStep(\"confirm\")}\n166 |             />\n167 |           )}\n168 |           {step === \"confirm\" && scheme && (\n169 |             <ConfirmStep lang={lang} docs={docs} onDocs={setDocs} onNext={() => setStep(\"questions\")} />\n170 |           )}\n171 |           {step === \"questions\" && scheme && (\n172 |             <QuestionsStep lang={lang} questions={scheme.questions} answers={answers} onAnswers={setAnswers} onNext={runCheck} />\n173 |           )}\n174 |           {step === \"report\" && scheme && (\n175 |             <ReportStep lang={lang} scheme={scheme} state={reportState} onRetry={runCheck} onStartOver={startOver} />\n176 |           )}\n177 | \n178 |           {backTo && (\n179 |             <button type=\"button\" className={`${btn.quiet} self-start`} onClick={() => setStep(backTo)}>\n180 |               ← {t.back}\n181 |             </button>\n182 |           )}\n183 |         </main>\n184 |       </div>\n185 |       {report && scheme && <CoverSheet lang={lang} scheme={scheme} report={report} docs={docs} sampleId={sampleId} />}\n186 |     </>\n187 |   );\n188 | }\n189 | ","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\core\\docFields.ts","result":" 1 | // Which fields we read or ask for on each document type. Pure.\n 2 | // Minimum personal data: only what the rule engine uses. Never a full Aadhaar number.\n 3 | import type { DocType, FieldName } from \"./types\";\n 4 | \n 5 | export const DOC_FIELDS: Record<DocType, readonly FieldName[]> = {\n 6 |   aadhaar: [\"name\", \"dob\", \"aadhaarLast4\"],\n 7 |   bank_passbook: [\"name\", \"accountNo\", \"ifsc\"],\n 8 |   land_record: [\"ownerNames\"],\n 9 |   ration_card: [\"name\"],\n10 |   // Only the presence of these documents matters to the engine, so nothing is read from them.\n11 |   death_certificate: [],\n12 |   bpl_proof: [],\n13 |   voter_id: [\"name\"],\n14 |   age_proof: [\"name\", \"dob\"],\n15 |   address_proof: [\"name\"],\n16 |   self_declaration: [\"name\"],\n17 |   income_certificate: [\"name\"],\n18 |   other: [\"name\"],\n19 | };\n20 | \n21 | /** Splits a list of names typed or read as one string (\"A; B\" or one per line). */\n22 | export function splitNames(text: string): string[] {\n23 |   return text\n24 |     .split(/[;\\n]/)\n25 |     .map((s) => s.trim().replace(/\\s+/g, \" \"))\n26 |     .filter((s) => s !== \"\");\n27 | }","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\core\\flow.test.ts","result":"  1 | import { describe, expect, it } from \"vitest\";\n  2 | import {\n  3 |   DOC_FIELDS,\n  4 |   blankDoc,\n  5 |   confirmField,\n  6 |   docSlotsFor,\n  7 |   fieldText,\n  8 |   needsConfirmation,\n  9 |   relevantAnswers,\n 10 |   removeDoc,\n 11 |   setField,\n 12 |   unconfirmedCount,\n 13 |   upsertDoc,\n 14 | } from \"./flow\";\n 15 | import { getScheme, questionsFor } from \"./schemes\";\n 16 | import { ExtractedDoc, type SchemeRule } from \"./types\";\n 17 | \n 18 | function scheme(id: string): SchemeRule {\n 19 |   const s = getScheme(id);\n 20 |   if (!s) throw new Error(id);\n 21 |   return s;\n 22 | }\n 23 | \n 24 | describe(\"docSlotsFor\", () => {\n 25 |   it(\"lists mandatory documents first, then documents used only for name checks\", () => {\n 26 |     expect(docSlotsFor(scheme(\"pm-kisan\"))).toEqual([\n 27 |       { docType: \"aadhaar\", required: true },\n 28 |       { docType: \"bank_passbook\", required: true },\n 29 |       { docType: \"land_record\", required: true },\n 30 |     ]);\n 31 |     expect(docSlotsFor(scheme(\"orunodoi-3\"))).toEqual([\n 32 |       { docType: \"ration_card\", required: true },\n 33 |       { docType: \"aadhaar\", required: false },\n 34 |       { docType: \"bank_passbook\", required: false },\n 35 |     ]);\n 36 |     expect(docSlotsFor(scheme(\"nsap-widow\")).map((s) => s.docType)).toEqual([\n 37 |       \"aadhaar\",\n 38 |       \"death_certificate\",\n 39 |       \"bank_passbook\",\n 40 |       \"bpl_proof\",\n 41 |     ]);\n 42 |   });\n 43 | });\n 44 | \n 45 | describe(\"field editing\", () => {\n 46 |   const aadhaar: ExtractedDoc = {\n 47 |     docType: \"aadhaar\",\n 48 |     fields: { name: \"Ramesh Kumar Sharma\", dob: \"1975-03-12\", aadhaarLast4: \"4821\" },\n 49 |     confidence: { name: 0.6, dob: 0.95, aadhaarLast4: 0.99 },\n 50 |   };\n 51 | \n 52 |   it(\"never offers a full Aadhaar field\", () => {\n 53 |     for (const fields of Object.values(DOC_FIELDS)) expect(fields).not.toContain(\"aadhaarNumber\");\n 54 |     expect(DOC_FIELDS.aadhaar).toContain(\"aadhaarLast4\");\n 55 |   });\n 56 | \n 57 |   it(\"flags only fields read with low confidence\", () => {\n 58 |     expect(needsConfirmation(aadhaar, \"name\")).toBe(true);\n 59 |     expect(needsConfirmation(aadhaar, \"dob\")).toBe(false);\n 60 |     expect(unconfirmedCount([aadhaar])).toBe(1);\n 61 |   });\n 62 | \n 63 |   it(\"editing a field stores the value and marks it confirmed by the user\", () => {\n 64 |     const d = setField(aadhaar, \"name\", \"  Ramesh K Sharma \");\n 65 |     expect(d.fields.name).toBe(\"Ramesh K Sharma\");\n 66 |     expect(d.confidence.name).toBeUndefined();\n 67 |     expect(aadhaar.fields.name).toBe(\"Ramesh Kumar Sharma\"); // immutable\n 68 |     expect(ExtractedDoc.safeParse(d).success).toBe(true);\n 69 |   });\n 70 | \n 71 |   it(\"confirming keeps the value and removes the low-confidence flag\", () => {\n 72 |     const d = confirmField(aadhaar, \"name\");\n 73 |     expect(d.fields.name).toBe(\"Ramesh Kumar Sharma\");\n 74 |     expect(needsConfirmation(d, \"name\")).toBe(false);\n 75 |   });\n 76 | \n 77 |   it(\"empty input removes the field\", () => {\n 78 |     const d = setField(aadhaar, \"dob\", \"   \");\n 79 |     expect(d.fields.dob).toBeUndefined();\n 80 |     expect(d.confidence.dob).toBeUndefined();\n 81 |   });\n 82 | \n 83 |   it(\"Aadhaar input keeps only the last 4 digits, and nothing until 4 digits are typed\", () => {\n 84 |     expect(setField(blankDoc(\"aadhaar\"), \"aadhaarLast4\", \"48\").fields.aadhaarLast4).toBeUndefined();\n 85 |     expect(setField(blankDoc(\"aadhaar\"), \"aadhaarLast4\", \"1234 5678 9012\").fields.aadhaarLast4).toBe(\"9012\");\n 86 |   });\n 87 | \n 88 |   it(\"owner names are one per line (or separated by ;)\", () => {\n 89 |     const d = setField(blankDoc(\"land_record\"), \"ownerNames\", \"Rameshwar Sharma\\n\\n Sita Sharma ; Hari\");\n 90 |     expect(d.fields.ownerNames).toEqual([\"Rameshwar Sharma\", \"Sita Sharma\", \"Hari\"]);\n 91 |     expect(fieldText(d, \"ownerNames\")).toBe(\"Rameshwar Sharma\\nSita Sharma\\nHari\");\n 92 |   });\n 93 | });\n 94 | \n 95 | describe(\"doc list helpers\", () => {\n 96 |   it(\"upsert replaces a document of the same type and keeps order\", () => {\n 97 |     const a = blankDoc(\"aadhaar\");\n 98 |     const b = blankDoc(\"bank_passbook\");\n 99 |     const a2 = setField(a, \"name\", \"X Y\");\n100 |     const list = upsertDoc(upsertDoc([a, b], a2), blankDoc(\"land_record\"));\n101 |     expect(list.map((d) => d.docType)).toEqual([\"aadhaar\", \"bank_passbook\", \"land_record\"]);\n102 |     expect(list[0].fields.name).toBe(\"X Y\");\n103 |     expect(removeDoc(list, \"bank_passbook\").map((d) => d.docType)).toEqual([\"aadhaar\", \"land_record\"]);\n104 |   });\n105 | \n106 |   it(\"relevantAnswers keeps only this scheme's questions\", () => {\n107 |     expect(relevantAnswers(questionsFor(scheme(\"nsap-widow\")), { is_widow: true, income_tax_payer: false })).toEqual({\n108 |       is_widow: true,\n109 |     });\n110 |   });\n111 | });","success":true}],"durationMs":4}}
