    expect(r.eligibility).toBe(\"needs_verification\");\n296 |     const c = check(r, \"excl_four_wheeler\");\n297 |     expect(c.result).toBe(\"needs_verification\");\n298 |     expect(c.provenance.status).toBe(\"provisional\");\n299 |     expect(c.fixWhere).toBe(\"gram_panchayat\");\n300 |     expect(c.messageEn).toMatch(/may make you ineligible/i);\n301 |   });\n302 | \n303 |   it(\"clean → likely_eligible + ready_for_review; ration card validity is an external check\", () => {\n304 |     const r = evaluate(orunodoi, orunodoiDocs(), orunodoiOk, AS_OF);\n305 |     expect(r.eligibility).toBe(\"likely_eligible\");\n306 |     expect(r.readiness).toBe(\"ready_for_review\");\n307 |     expect(check(r, \"ext_ration_card_valid\").result).toBe(\"needs_verification\");\n308 |     expect(check(r, \"name_aadhaar\").result).toBe(\"ok\");\n309 |     expect(check(r, \"name_bank_passbook\").result).toBe(\"ok\");\n310 |   });\n311 | \n312 |   it(\"none of the any-of conditions → needs_verification (provisional list)\", () => {\n313 |     const r = evaluate(orunodoi, orunodoiDocs(), { ...orunodoiOk, widow: false }, AS_OF);\n314 |     expect(check(r, \"anyof\").result).toBe(\"needs_verification\");\n315 |     expect(r.eligibility).toBe(\"needs_verification\");\n316 |   });\n317 | \n318 |   it(\"supporting documents are a checklist labelled 'confirm the current list'\", () => {\n319 |     const r = evaluate(orunodoi, orunodoiDocs(), orunodoiOk, AS_OF);\n320 |     expect(r.supportingDocs.length).toBeGreaterThan(0);\n321 |     expect(r.supportingDocs.find((d) => d.docType === \"aadhaar\")?.present).toBe(true);\n322 |     expect(r.supportingDocs.find((d) => d.docType === \"voter_id\")?.present).toBe(false);\n323 |     expect(r.supportingDocsNoteEn).toMatch(/confirm the current list/i);\n324 |   });\n325 | \n326 |   it(\"property: Orunodoi never says not_eligible, whatever the answers\", () => {\n327 |     const ids = Object.keys(orunodoiOk);\n328 |     fc.assert(\n329 |       fc.property(\n330 |         fc.array(fc.option(fc.boolean(), { nil: undefined }), { minLength: ids.length, maxLength: ids.length }),","success":true},{"query":"C:\\Dev\\cline hackathon\\build\\src\\core\\dates.ts","result":" 1 | // ISO calendar dates (YYYY-MM-DD) without time zones. Pure.\n 2 | \n 3 | const ISO_DATE = /^(\\d{4})-(\\d{2})-(\\d{2})$/;\n 4 | \n 5 | export interface YMD {\n 6 |   y: number;\n 7 |   m: number;\n 8 |   d: number;\n 9 | }\n10 | \n11 | /** Parses a real calendar date (rejects 2026-02-30, 2026-13-01, other formats). */\n12 | export function parseIsoDate(s: string): YMD | null {\n13 |   const m = ISO_DATE.exec(s);\n14 |   if (!m) return null;\n15 |   const y = Number(m[1]);\n16 |   const mo = Number(m[2]);\n17 |   const d = Number(m[3]);\n18 |   const t = new Date(Date.UTC(y, mo - 1, d));\n19 |   if (t.getUTCFullYear() !== y || t.getUTCMonth() !== mo - 1 || t.getUTCDate() !== d) return null;\n20 |   return { y, m: mo, d };\n21 | }\n22 | \n23 | export function isIsoDate(s: string): boolean {\n24 |   return parseIsoDate(s) !== null;\n25 | }\n26 | \n27 | /** Throws a RangeError unless `s` is a real YYYY-MM-DD date. */\n28 | export function assertIsoDate(s: string, what = \"date\"): YMD {\n29 |   const p = parseIsoDate(s);\n30 |   if (!p) throw new RangeError(`${what} must be a real date as YYYY-MM-DD, got \"${s}\"`);\n31 |   return p;\n32 | }","success":true}],"durationMs":14}}
