{"ts":"2026-10-10T08:50:02.548Z","type":"agent_event","event":{"type":"content_start","contentType":"tool","toolName":"editor","toolCallId":"toolu_01JQq5sdjWcVc4Xun3L9SFjc","input":{"path":"C:\\Dev\\cline hackathon\\build\\src\\core\\dates.ts","new_text":"// ISO calendar dates (YYYY-MM-DD) without time zones. Pure.\n\nconst ISO_DATE = /^(\\d{4})-(\\d{2})-(\\d{2})$/;\n\nexport interface YMD {\n  y: number;\n  m: number;\n  d: number;\n}\n\n/** Parses a real calendar date (rejects 2026-02-30, 2026-13-01, other formats). */\nexport function parseIsoDate(s: string): YMD | null {\n  const m = ISO_DATE.exec(s);\n  if (!m) return null;\n  const y = Number(m[1]);\n  const mo = Number(m[2]);\n  const d = Number(m[3]);\n  const t = new Date(Date.UTC(y, mo - 1, d));\n  if (t.getUTCFullYear() !== y || t.getUTCMonth() !== mo - 1 || t.getUTCDate() !== d) return null;\n  return { y, m: mo, d };\n}\n\nexport function isIsoDate(s: string): boolean {\n  return parseIsoDate(s) !== null;\n}\n\n/** Throws a RangeError unless `s` is a real YYYY-MM-DD date. */\nexport function assertIsoDate(s: string, what = \"date\"): YMD {\n  const p = parseIsoDate(s);\n  if (!p) throw new RangeError(`${what} must be a real date as YYYY-MM-DD, got \"${s}\"`);\n  return p;\n}\n"}}}
